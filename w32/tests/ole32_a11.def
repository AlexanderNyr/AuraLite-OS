; W32A-11 in-process OLE and COM fixture import library; no DLL shipped.
LIBRARY OLE32.dll
EXPORTS
    CoInitialize
    CoUninitialize
    OleInitialize
    OleUninitialize
    CoTaskMemAlloc
    CoTaskMemRealloc
    CoTaskMemFree
    DoDragDrop
    RegisterDragDrop
    RevokeDragDrop
    ReleaseStgMedium
