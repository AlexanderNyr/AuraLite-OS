; user32.def — export list for the USER32 import library.  WIN32_PLAN.md W32-5.
; Names only; no Microsoft file is used and no DLL is shipped.
LIBRARY USER32.dll
EXPORTS
    BeginPaint
    CreateWindowExA
    DefWindowProcA
    DestroyWindow
    DispatchMessageA
    EndPaint
    FillRect
    GetClientRect
    GetMessageA
    InvalidateRect
    MessageBoxA
    PeekMessageA
    PostQuitMessage
    RegisterClassExA
    ShowWindow
    TranslateMessage
    UpdateWindow
