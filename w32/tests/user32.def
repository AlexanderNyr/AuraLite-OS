    DestroyIcon
    DestroyMenu
    DialogBoxIndirectParamW
    DialogBoxParamW
    DialogBoxW
    DrawEdge
    DrawFocusRect
    DrawFrameControl
    DrawIcon
    DrawIconEx
    DrawMenuBar
    DrawTextW
    EmptyClipboard
    EndDialog
    FindResourceW
    GetCaretPos
    GetClipboardData
    GetClipboardOwner
    GetClipboardViewer
    GetDialogBaseUnits
    GetDlgItem
    GetDlgItemInt
    GetDlgItemTextW
    GetMenu
    GetMenuItemCount
    GetMenuItemID
    GetMessageW
    GetSubMenu
    GetSystemMenu
    HideCaret
    InsertMenuW
    IsClipboardFormatAvailable
    IsDialogMessageW
    KillTimer
    LoadAcceleratorsW
    LoadCursorW
    LoadIconW
    LoadImageW
    LoadMenuW
    LoadResource
    LoadStringW
    LockResource
    MapDialogRect
    MessageBoxW
    NotifyWinEvent
    OpenClipboard
    PeekMessageW
    RegisterClipboardFormatW
    RegisterClassExW
    RemoveMenu
    SetCaretPos
    SetClipboardData
    SetDlgItemInt
    SetDlgItemTextW
    SetMenu
    SetTimer
    SetWindowsHookExW
    ShowCaret
    SizeofResource
    TrackPopupMenu
    TranslateAcceleratorW
    UnhookWindowsHookEx
    UpdateWindow
; -- W32A-6 (continued): A-variants and the remaining bound surface --
    AppendMenuA
    CountClipboardFormats
    DeleteMenu
    DialogBoxA
    DialogBoxIndirectParamA
    DialogBoxParamA
    DispatchMessageW
    DrawTextA
    DrawTextExW
    EnableMenuItem
    EnableWindow
    EnumClipboardFormats
    EnumResourceNamesA
    EnumResourceNamesW
    FindResourceA
