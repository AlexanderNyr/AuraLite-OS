<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- W32A-1 fixture: the v5 branch.  A Common-Controls dependency pinned
     at 5.82 (not 6.x), asInvoker, no dpi stanza, no supportedOS.  The
     gate must print "comctl v5" -- the version discriminates, not the
     mere presence of the dependency. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="5.82.0.0" processorArchitecture="amd64" publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>
</assembly>
