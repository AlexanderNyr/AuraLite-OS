; kernel32.def — the export list for the import library the test .exe links
; against.  WIN32_PLAN.md phase W32-4, decision D7: this is exactly the set the
; gate binaries import, not "all of KERNEL32".
;
; lld-link turns this into an import library; nothing here is a Microsoft file
; and no DLL is redistributed -- the names are the interface being
; reimplemented (w32/LICENSING.md).
LIBRARY KERNEL32.dll
EXPORTS
    CloseHandle
    CreateFileA
    ExitProcess
    FreeLibrary
    GetCommandLineA
    GetLastError
    GetModuleHandleA
    GetProcAddress
    GetProcessHeap
    GetStdHandle
    GetTickCount64
    HeapAlloc
    HeapFree
    LoadLibraryA
    RaiseException
    ReadFile
    RtlCaptureContext
    RtlLookupFunctionEntry
    RtlPcToFileHeader
    RtlUnwind
    RtlUnwindEx
    RtlVirtualUnwind
    SetUnhandledExceptionFilter
    UnhandledExceptionFilter
    _XcptFilter
    __C_specific_handler
    SetLastError
    Sleep
    VirtualAlloc
    VirtualFree
    WriteFile

; W32A-3 (W32APP_PLAN.md): threads + TLS.  D7-exact: the union of what the
; two guest fixtures import (45 threads + 17 TLS - 8 already above = 45 new).
    AcquireSRWLockExclusive
    CloseThreadpoolWork
    CreateEventA
    CreateMutexA
    CreateSemaphoreW
    CreateThread
    CreateThreadpoolWork
    DeleteCriticalSection
    EnterCriticalSection
    ExitThread
    FlsAlloc
    FlsFree
    FlsGetValue
    FlsSetValue
    FreeLibraryAndExitThread
    GetCurrentThread
    GetCurrentThreadId
    GetExitCodeThread
    GetThreadTimes
    InitOnceBeginInitialize
    InitOnceComplete
    InitializeCriticalSection
    InitializeSListHead
    InterlockedFlushSList
    LeaveCriticalSection
    QueueUserAPC
    ReleaseMutex
    ReleaseSRWLockExclusive
    ReleaseSemaphore
    ResetEvent
    ResumeThread
    SetEvent
    SetThreadAffinityMask
    SleepConditionVariableSRW
    SleepEx
    SubmitThreadpoolWork
    TerminateThread
    TlsAlloc
    TlsFree
    TlsGetValue
    TlsSetValue
    TryAcquireSRWLockExclusive
    WaitForMultipleObjects
    WaitForSingleObject
    WakeAllConditionVariable
