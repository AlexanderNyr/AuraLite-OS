<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- W32A-1 fixture: well-formed, but requireAdministrator.  There is no
     elevation to grant, so the gate must refuse before mapping anything:
     "w32run: refused: manifest requests requireAdministrator (elevation
     is not supported)". -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
