diff --git a/boot/bios/stage2/lmcheck.inc b/boot/bios/stage2/lmcheck.inc
index d7e6af7..abd6db4 100644
--- a/boot/bios/stage2/lmcheck.inc
+++ b/boot/bios/stage2/lmcheck.inc
@@ -74,3 +74,58 @@ check_long_mode:
     pop  ebx
     stc
     ret
+
+; ---------------------------------------------------------------------------
+; check_i686 -- the 32-bit kernel floor (I386_PLAN I3, decision D1).
+;
+; The i386 kernel assumes P6-class features: PSE (the direct map is
+; built from 4 MiB pages), CMPXCHG8B and CMOV.  A CPU below that floor
+; must get the I0 refusal, not a #UD on `mov cr4` three instructions
+; before the kernel banner.  Called only after check_long_mode said
+; "no", so CPUID presence must be re-established (a 486 reaches here).
+;
+; On return: CF=0  i686-class, safe for KERNEL32.ELF.
+;            CF=1  below the floor -- refuse honestly.
+; ---------------------------------------------------------------------------
+check_i686:
+    push ebx
+    push ecx
+    push edx
+
+    ; CPUID present?  (EFLAGS.ID toggle; a 486 fails right here.)
+    pushfd
+    pop  eax
+    mov  ecx, eax
+    xor  eax, (1 << 21)
+    push eax
+    popfd
+    pushfd
+    pop  eax
+    push ecx
+    popfd
+    xor  eax, ecx
+    test eax, (1 << 21)
+    jz   .below_floor
+
+    ; Leaf 1 EDX: PSE (bit 3), CX8 (bit 8), CMOV (bit 15).
+    mov  eax, 1
+    cpuid
+    test edx, (1 << 3)
+    jz   .below_floor
+    test edx, (1 << 8)
+    jz   .below_floor
+    test edx, (1 << 15)
+    jz   .below_floor
+
+    pop  edx
+    pop  ecx
+    pop  ebx
+    clc
+    ret
+
+.below_floor:
+    pop  edx
+    pop  ecx
+    pop  ebx
+    stc
+    ret
diff --git a/boot/bios/stage2/stage2_start.asm b/boot/bios/stage2/stage2_start.asm
index a00f00a..febb941 100644
--- a/boot/bios/stage2/stage2_start.asm
+++ b/boot/bios/stage2/stage2_start.asm
@@ -202,9 +202,40 @@ stage2_entry:
     mov  si, msg_no_lm_1
     call uart16_puts
     call vga_puts
+
+    ; I3: the 32-bit kernel's floor is i686-class (plan D1) -- it
+    ; builds its direct map from PSE 4 MiB pages.  A 486/586 must get
+    ; the honest refusal HERE, not a #UD on `mov cr4` three
+    ; instructions before the kernel banner.
+    call check_i686
+    jnc  .i686_ok
+    mov  si, msg_below_floor
+    call uart16_puts
+    call vga_puts
+    mov  si, msg_no_lm_2
+    call uart16_puts
+    call vga_puts
+.floor_hang:
+    hlt
+    jmp  .floor_hang
+.i686_ok:
     mov  si, msg_lm_32path
     call uart16_puts
     call vga_puts
+
+    ; I3: the 32-bit kernel direct-maps phys [0, 896 MiB) at
+    ; 0xC0000000 and validates hhdm_offset against that (the same
+    ; loader-owns-it contract as the 64-bit path's
+    ; 0xFFFF800000000000).  Overwrite the qword BL3 wrote earlier:
+    ; low dword = 0xC0000000, high dword = 0.
+    push es
+    mov  ax, BOOT_INFO_SEG
+    mov  es, ax
+    mov  word [es:BOOT_HHDM_OFF + 0], 0x0000
+    mov  word [es:BOOT_HHDM_OFF + 2], 0xC000
+    mov  word [es:BOOT_HHDM_OFF + 4], 0x0000
+    mov  word [es:BOOT_HHDM_OFF + 6], 0x0000
+    pop  es
     jmp  .lm_done
 .lm_ok:
     mov  si, msg_lm_ok
@@ -426,6 +457,7 @@ msg_no_lm_1:     db "[BL10] this CPU has no long mode (x86_64)", 0x0D, 0x0A, 0
 msg_no_lm_2:     db "[BL10] halting -- see I386_PLAN.md for the 32-bit kernel roadmap", 0x0D, 0x0A, 0
 msg_lm_32path:   db "[BL10] taking the 32-bit path: KERNEL32.ELF", 0x0D, 0x0A, 0
 msg_no_k32:      db "[BL10] no KERNEL32.ELF on the boot partition; cannot boot this CPU", 0x0D, 0x0A, 0
+msg_below_floor: db "[BL10] CPU is below the i686 floor (needs PSE+CX8+CMOV, plan D1)", 0x0D, 0x0A, 0
 msg_elf32_ok:    db "[BL10] ELF32 PT_LOAD segments copied to phys", 0x0D, 0x0A, 0
 msg_pm32_go:     db "[BL10] entering protected mode; jumping to kernel32 _start", 0x0D, 0x0A, 0
 msg_acpi_rsdp_ok:   db "[BL9] ACPI RSDP found", 0x0D, 0x0A, 0
diff --git a/kernel/arch/i386/boot32.asm b/kernel/arch/i386/boot32.asm
index 37519c3..310a248 100644
--- a/kernel/arch/i386/boot32.asm
+++ b/kernel/arch/i386/boot32.asm
@@ -1,39 +1,94 @@
 ; =============================================================================
-; kernel/arch/i386/boot32.asm -- i386 kernel entry point (I386_PLAN I2).
+; kernel/arch/i386/boot32.asm -- i386 kernel entry point (I386_PLAN I2,
+; higher-half since I3).
 ;
-; Grown from the I1 stub's entry: same contract (Stage 2's enter_prot32
-; jumps here in 32-bit protected mode, paging OFF, ESI = boot_info_t
-; phys, flat segments), bigger stack (64 KiB, matching the x86_64
-; boot.asm) because a real kmain with self-tests lives behind it now.
+; Stage 2's enter_prot32 jumps to _start in 32-bit protected mode with
+; paging OFF and ESI = boot_info_t phys.  Since I3 the kernel is linked
+; at 0xC0100000 (KERNEL_VMA + 1 MiB) but loaded at 0x00100000, so entry
+; happens in the .boot section (VMA = LMA, see kernel32.ld) which:
 ;
-;   1. cli -- no IDT until idt_init.
-;   2. Zero .bss.
-;   3. ESP := stack_top.
-;   4. Push ESI, call kmain32 (cdecl).
-;   5. If kmain32 returns: hlt loop.
+;   1. Builds the boot page directory with PSE 4 MiB pages:
+;        PDE[0..223]    identity  [0, 896 MiB)   -- survives the PG flip
+;        PDE[768..991]  direct map [0, 896 MiB) at 0xC0000000
+;      Zero page tables needed -- this is why check_i686 requires PSE.
+;   2. CR3 := page directory, CR4.PSE := 1, CR0.PG|WP := 1.
+;   3. Jumps to the higher half (indirect -- the linker resolved the
+;      target at its VMA).
+;
+; The higher-half half then zeroes .bss, sets the real stack and calls
+; kmain32(ESI) exactly as before.  The identity window is dropped by
+; paging32_drop_identity() once kmain32 is running -- it exists only so
+; the instruction after `mov cr0` fetches successfully.
 ; =============================================================================
 
 bits 32
 
-STACK_SIZE equ 64*1024
+KERNEL_VMA     equ 0xC0000000
+DIRECT_MAP_MB  equ 896
+PDE_COUNT      equ DIRECT_MAP_MB / 4          ; 224 4-MiB PDEs
 
-section .bss
-align 16
-stack_bottom:
-    resb STACK_SIZE
-stack_top:
+; PDE bits: P | RW | PS  (kernel-only, global left off until PGE audit)
+PDE_FLAGS      equ (1 << 0) | (1 << 1) | (1 << 7)
 
-section .text
-global _start
-extern kmain32
+; -----------------------------------------------------------------------------
+; .boot -- physical-mode entry (VMA = LMA = 0x00100000 region)
+; -----------------------------------------------------------------------------
+section .boot
+align 4096
+global boot_page_directory
+boot_page_directory:
+    times 4096 db 0
 
+global _start
 _start:
     cli
+    ; ESI = boot_info phys; nothing below may clobber it.
+
+    ; ---- 1. Fill the page directory (runs at physical addresses). ----
+    ; Identity PDEs 0..223 and direct-map PDEs 768..991 share frames:
+    ; entry i maps phys i*4MiB.
+    mov  edi, boot_page_directory
+    xor  ecx, ecx                       ; ecx = PDE index 0..223
+.fill_pde:
+    mov  eax, ecx
+    shl  eax, 22                        ; phys = index * 4 MiB
+    or   eax, PDE_FLAGS
+    mov  [edi + ecx*4], eax             ; identity
+    mov  [edi + (ecx + 768)*4], eax     ; +0xC0000000
+    inc  ecx
+    cmp  ecx, PDE_COUNT
+    jb   .fill_pde
+
+    ; ---- 2. Turn paging on. ----
+    mov  eax, boot_page_directory
+    mov  cr3, eax
+
+    mov  eax, cr4
+    or   eax, (1 << 4)                  ; CR4.PSE
+    mov  cr4, eax
 
-    ; Zero .bss (dword granularity; __bss_start/__bss_end are 4-aligned
-    ; by kernel32.ld).  ESI survives: rep stosd touches EDI/ECX/EAX only.
-    extern __bss_start
-    extern __bss_end
+    mov  eax, cr0
+    or   eax, (1 << 31) | (1 << 16)     ; CR0.PG | CR0.WP
+    mov  cr0, eax
+
+    ; ---- 3. To the higher half.  Indirect jump: the target symbol
+    ; lives in .text, so the linker resolved it at its VMA. ----
+    mov  eax, higher_half
+    jmp  eax
+
+; -----------------------------------------------------------------------------
+; .text -- the higher-half kernel proper
+; -----------------------------------------------------------------------------
+section .text
+extern kmain32
+extern __bss_start
+extern __bss_end
+
+STACK_SIZE equ 64*1024
+
+higher_half:
+    ; Zero .bss (VMA addresses; the direct map backs them now).
+    ; ESI survives: rep stosd touches EDI/ECX/EAX only.
     mov  edi, __bss_start
     mov  ecx, __bss_end
     sub  ecx, edi
@@ -43,9 +98,15 @@ _start:
 
     mov  esp, stack_top
 
-    push esi
+    push esi                            ; cdecl: kmain32(boot_info_phys)
     call kmain32
 
 .hang:
     hlt
     jmp  .hang
+
+section .bss
+align 16
+stack_bottom:
+    resb STACK_SIZE
+stack_top:
diff --git a/kernel/arch/i386/kernel32.ld b/kernel/arch/i386/kernel32.ld
index 424a8ed..c979cbc 100644
--- a/kernel/arch/i386/kernel32.ld
+++ b/kernel/arch/i386/kernel32.ld
@@ -1,51 +1,70 @@
 /*
- * kernel/arch/i386/stub/kernel32.ld -- linker script for the i386 boot
- * stub (I386_PLAN I1).
+ * kernel/arch/i386/kernel32.ld -- linker script for the i386 kernel
+ * (I386_PLAN I2, higher-half since I3).
  *
- * Unlike kernel.ld (higher-half, VMA 0xFFFFFFFF80100000, phys derived by
- * subtraction in elf.inc), the stub is linked with VMA = LMA = 0x00100000:
- * Stage 2's 32-bit path enables no paging, so p_paddr is the destination
- * verbatim and the entry jump is a physical address.  The real i386
- * kernel (I3) moves to 0xC0100000 higher-half once it owns paging; this
- * script is scoped to the stub and dies with it.
+ * I3 layout: the kernel LIVES at virtual KERNEL_VMA + phys (0xC0100000
+ * region, plan D3) but is LOADED at physical 0x00100000 -- Stage 2's
+ * 32-bit path still enables no paging, so a small .boot section stays
+ * VMA = LMA at 0x00100000, builds a minimal PSE page directory, turns
+ * on CR0.PG and jumps to the higher half.  Every other section carries
