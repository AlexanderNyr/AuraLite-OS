++static void test_memcmp_wordwide(void) {
++    unsigned char a[64], b[64];
++    for (unsigned diff_at = 0; diff_at < 40; diff_at++) {
++        for (unsigned ofs = 0; ofs <= 8 && ofs + 40 < sizeof(a); ofs++) {
++            fill_pattern(a, sizeof(a), 9);
