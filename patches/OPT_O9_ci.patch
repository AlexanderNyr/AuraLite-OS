++static struct tlb_mailbox mailboxes[TLB_MAX_CPUS];
++static uint64_t last_handled[TLB_MAX_CPUS];      /* owner-CPU private   */
++static volatile uint64_t cpu_cr3_shadow[TLB_MAX_CPUS];
