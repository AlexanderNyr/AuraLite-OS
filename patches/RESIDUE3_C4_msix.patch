+ * Same shape as virtio-blk's attach: the shared walker in
+ * kernel/arch/x86_64/msi.c does the capability parsing and the MSI-X table
+ * programming, this file only supplies the transport accessors.
+ * --------------------------------------------------------------------- */
+static uint32_t gpu_msi_vector;
+static volatile uint32_t gpu_msi_irqs;
+
+static void virtio_gpu_msi_handler(void *cookie) {
+    (void)cookie;
+    if (isr_cfg) (void)*isr_cfg;      /* read-to-clear retires the message */
+    gpu_msi_irqs++;
+}
+
+static uint8_t  gmsi_cfg8 (void *ctx, uint16_t off) { (void)ctx; return pci_read8_at((uint8_t)off); }
+static uint16_t gmsi_cfg16(void *ctx, uint16_t off) { (void)ctx; return pci_read16_at((uint8_t)off); }
+static uint32_t gmsi_cfg32(void *ctx, uint16_t off) {
+    (void)ctx;
+    return pci_config_read(pci_bus, pci_dev, pci_func, off & 0xFC);
+}
+static void gmsi_w16(void *ctx, uint16_t off, uint16_t v) {
+    (void)ctx;
+    uint32_t cur = pci_config_read(pci_bus, pci_dev, pci_func, off & 0xFC);
+    uint32_t sh = (off & 2) * 8;
+    uint32_t nv = (cur & ~(0xFFFFu << sh)) | ((uint32_t)v << sh);
+    pci_config_write(pci_bus, pci_dev, pci_func, off & 0xFC, nv);
+}
+static void gmsi_w32(void *ctx, uint16_t off, uint32_t v) {
+    (void)ctx;
+    pci_config_write(pci_bus, pci_dev, pci_func, off & 0xFC, v);
+}
+static volatile uint8_t *gmsi_bar(void *ctx, uint8_t bar, uint32_t off, uint32_t len) {
+    (void)ctx;
+    uint64_t va = map_bar_region(bar, off, len ? len : 0x1000);
+    return va ? (volatile uint8_t *)(uintptr_t)va : 0;
+}
+
+static void virtio_gpu_msi_attach(void) {
+    msi_pci_io_t io;
+    memset(&io, 0, sizeof(io));
+    io.ctx = 0;
+    io.cfg8 = gmsi_cfg8; io.cfg16 = gmsi_cfg16; io.cfg32 = gmsi_cfg32;
+    io.w16 = gmsi_w16; io.w32 = gmsi_w32; io.bar_map = gmsi_bar;
+
+    uint32_t vec = 0;
+    int rc = msi_attach_pci(&io, virtio_gpu_msi_handler, 0, "virtio-gpu", &vec);
+    if (rc != 0) {
+        if (rc == -1)
+            kprintf("[msi] virtio-gpu: no MSI/MSI-X capability -- "
+                    "INTx/polling path\n");
+        else if (msi_enabled())
+            kprintf("[msi] virtio-gpu: attach refused (see above) -- "
+                    "INTx/polling path\n");
+        return;
+    }
+    gpu_msi_vector = vec;
+
+    /* Table INDEX, not the x86 vector -- see MSI_TABLE_ENTRY in msi.h. */
+    common_cfg->queue_select = 0;
+    common_cfg->queue_msix_vector = (uint16_t)MSI_TABLE_ENTRY;
+    uint16_t got = common_cfg->queue_msix_vector;
+    if (got == 0xFFFF) {
+        kprintf("[msi] virtio-gpu: device refused queue 0 entry %u "
+                "(NO_VECTOR); keeping INTx\n", (unsigned)MSI_TABLE_ENTRY);
+        gpu_msi_vector = 0;
+        return;
+    }
+    kprintf("[msi] virtio-gpu: queue 0 -> table entry %u (readback %u), "
+            "x86 vector %u\n", (unsigned)MSI_TABLE_ENTRY, (unsigned)got,
+            (unsigned)vec);
+}
+
+/* The receipt: printed once, after a command has actually completed and the
+ * counter shows the message arrived.  A grace spin is needed because the
+ * message can trail the used-ring write. */
+static void virtio_gpu_msi_receipt(void) {
+    if (!gpu_msi_vector || gpu_msi_irqs == 0) return;
+    kprintf("[msi] virtio-gpu: %u interrupt(s) delivered on vector %u\n",
+            (unsigned)gpu_msi_irqs, (unsigned)gpu_msi_vector);
+}
+
 static int setup_control_queue(void) {
     common_cfg->queue_select = 0;
     uint16_t qsz = common_cfg->queue_size;
@@ -772,6 +856,9 @@ int virtio_gpu_init(void) {
 
     uint64_t dev_features = read_device_features();
     uint64_t wanted = (1ULL << VIRTIO_F_VERSION_1);
+    /* VIRTIO_PCI_F_MSI_X (bit 27): accept it when offered so queue_msix_vector
+     * is meaningful; declining leaves the INTx line in charge. */
+    wanted |= dev_features & (1ULL << 27);
     if (dev_features & (1ULL << VIRTIO_GPU_F_VIRGL)) {
         info.virgl_supported = 1;
         wanted |= (1ULL << VIRTIO_GPU_F_VIRGL);
@@ -792,6 +879,11 @@ int virtio_gpu_init(void) {
     }
 
     common_cfg->device_status |= VIRTIO_STATUS_DRIVER_OK;
+
+    /* C4: attach before the first command, so the very first completion is
+     * the one that proves the vector works. */
+    virtio_gpu_msi_attach();
+
     if (get_display_info() != 0) {
         kprintf("[virtio-gpu] control queue ready, display-info command failed\n");
     }
@@ -804,6 +896,15 @@ int virtio_gpu_init(void) {
         else
             kprintf("[virtio-gpu] default VirGL context create failed\n");
     }
+    if (gpu_msi_vector) {
+        for (uint32_t i = 0; i < 200000 && gpu_msi_irqs == 0; i++)
+            __asm__ volatile ("pause");
+        if (gpu_msi_irqs == 0)
+            kprintf("[msi] virtio-gpu: no message received on vector %u "
+                    "(commands polled to completion)\n", (unsigned)gpu_msi_vector);
+    }
+    virtio_gpu_msi_receipt();
+
     init_result = 0;
     return init_result;
 }
diff --git a/drivers/pci/msi_caps.c b/drivers/pci/msi_caps.c
new file mode 100644
index 0000000..52bc6a5
--- /dev/null
+++ b/drivers/pci/msi_caps.c
@@ -0,0 +1,184 @@
+/* msi_caps.c — MSI / MSI-X capability parsing and programming.
+ * See msi_caps.h for the contract and for why the accessors are injectable.
+ *
+ * Capability layouts (PCI Local Bus 3.0 §6.8, PCIe 2.0 §7.7):
+ *
+ *   MSI (id 0x05)
+ *     +0  cap id       +1  next
+ *     +2  message control  (bit0 EN, bit3 64-bit, bit4 per-vector mask,
+ *                           bits 13:11 multiple-message capable,
+ *                           bits 9:7  multiple-message enable)
+ *     +4  message address low
+ *     +8  message address high   (only if 64-bit capable)
+ *     +12 message data           (+16 .. if per-vector mask capable)
+ *
+ *   MSI-X (id 0x11)
+ *     +0  cap id       +1  next
+ *     +2  message control  (bit15 ENABLE, bit14 FUNCTION MASK,
+ *                           bits 10:0 table size - 1)
+ *     +4  table BIR (bits 2:0) + table offset (bits 31:3)
+ *     +8  PBA  BIR + offset
+ *     table entry (16 bytes): addr lo, addr hi, data, vector control (bit0
+ *     = mask this vector)
+ */
+
+#include <stdint.h>
+
+#include "drivers/pci/msi_caps.h"
+
+static void put_reason(char *why, unsigned n, const char *s) {
+    if (!why || n == 0) return;
+    unsigned i = 0;
+    for (; s[i] && i + 1 < n; i++) why[i] = s[i];
+    why[i] = '\0';
+}
+
+static void put_u32(char *why, unsigned n, const char *pre, uint32_t v) {
+    if (!why || n == 0) return;
+    unsigned i = 0;
+    char tmp[11];
+    int t = 0;
+    for (; pre[i] && i + 1 < n; i++) why[i] = pre[i];
+    if (v == 0) tmp[t++] = '0';
+    while (v && t < (int)sizeof(tmp)) { tmp[t++] = (char)('0' + (v % 10u)); v /= 10u; }
+    while (t > 0 && i + 1 < n) why[i++] = tmp[--t];
+    why[i] = '\0';
+}
+
+int msi_scan(const msi_pci_io_t *io, msi_caps_t *out) {
+    if (!io || !out || !io->cfg8) return MSI_KIND_NONE;
+    out->kind = MSI_KIND_NONE;
+    out->cap_off = 0;
+    out->n_vectors = 0;
+    out->bir = 0;
+    out->table_off = 0;
+    out->cap64 = 0;
+
+    /* Status bit 4 = capability list present. */
+    uint16_t status = 0;
+    if (io->cfg16) {
+        status = io->cfg16(io->ctx, 0x06);
+    } else {
+        status = (uint16_t)(io->cfg8(io->ctx, 0x06) |
+                            (io->cfg8(io->ctx, 0x07) << 8));
+    }
+    if (!(status & 0x0010)) return MSI_KIND_NONE;
+
+    uint8_t ptr = (uint8_t)(io->cfg8(io->ctx, 0x34) & 0xFC);
+    int fuse = 48;                       /* a malformed list must terminate */
+    msi_caps_t msix, msi;
+    msix.kind = MSI_KIND_NONE;
+    msi.kind  = MSI_KIND_NONE;
+    while (ptr && fuse--) {
+        uint8_t id  = io->cfg8(io->ctx, ptr);
+        uint8_t nxt = (uint8_t)(io->cfg8(io->ctx, ptr + 1u) & 0xFC);
+        if (id == PCI_CAP_ID_MSIX && msix.kind == MSI_KIND_NONE) {
+            uint16_t mc = io->cfg16 ? io->cfg16(io->ctx, (uint16_t)(ptr + 2u)) : 0;
+            uint32_t tbl = io->cfg32 ? io->cfg32(io->ctx, (uint16_t)(ptr + 4u)) : 0;
+            msix.kind      = MSI_KIND_MSIX;
+            msix.cap_off   = ptr;
+            msix.n_vectors = (uint16_t)((mc & 0x07FFu) + 1u);
+            msix.bir       = (uint8_t)(tbl & 0x07u);
+            msix.table_off = tbl & 0xFFFFFFF8u;
+            msix.cap64     = 0;
+        } else if (id == PCI_CAP_ID_MSI && msi.kind == MSI_KIND_NONE) {
+            uint16_t mc = io->cfg16 ? io->cfg16(io->ctx, (uint16_t)(ptr + 2u)) : 0;
+            msi.kind      = MSI_KIND_MSI;
+            msi.cap_off   = ptr;
+            msi.n_vectors = (uint16_t)(1u << ((mc >> 11) & 0x07u));
+            msi.cap64     = (uint8_t)((mc & 0x0008u) ? 1 : 0);
+        }
+        if (nxt == ptr) break;           /* self-referential list: stop */
+        ptr = nxt;
+    }
+
+    /* Prefer MSI-X: per-vector masking and a table are what a queue per
+     * device needs, and every virtio-pci device that offers both offers
+     * MSI-X for a reason. */
+    *out = (msix.kind == MSI_KIND_MSIX) ? msix : msi;
+    return out->kind;
+}
+
+int msi_program(const msi_pci_io_t *io, const msi_caps_t *caps,
+                uint8_t vector, uint8_t dest_apic_id,
+                char *why, unsigned why_n) {
+    if (!io || !caps || caps->kind == MSI_KIND_NONE) {
+        put_reason(why, why_n, "no MSI/MSI-X capability");
+        return -1;
+    }
+    if (!io->w16 || !io->w32) {
+        put_reason(why, why_n, "transport has no config writer");
+        return -3;
+    }
+
+    uint32_t msg_addr = MSI_APIC_ADDR_BASE | ((uint32_t)dest_apic_id << 12);
+
+    if (caps->kind == MSI_KIND_MSIX) {
+        if (!io->bar_map) {
+            put_reason(why, why_n, "transport cannot map the MSI-X table");
+            return -3;
+        }
+        uint32_t len = (uint32_t)caps->n_vectors * 16u;
+        if (len < 16u) len = 16u;
+        volatile uint8_t *tbl = io->bar_map(io->ctx, caps->bir,
+                                           caps->table_off, len);
+        if (!tbl) {
+            put_u32(why, why_n, "MSI-X table BAR unmappable: BAR", caps->bir);
+            return -3;
+        }
+
+        volatile uint32_t *e = (volatile uint32_t *)tbl;   /* entry 0 */
+        e[0] = msg_addr;          /* address low  */
+        e[1] = 0;                 /* address high */
+        e[2] = (uint32_t)vector;  /* data         */
+        e[3] = 0;                 /* unmask       */
+
+        /* Enable, then clear the function mask, then read it back.  The
+         * order matters: enabling with the mask set still delivers
+         * nothing, and a device that drops the write must be seen. */
+        uint16_t off = (uint16_t)(caps->cap_off + 2u);
+        uint16_t mc  = io->cfg16 ? io->cfg16(io->ctx, off) : 0;
+        mc |= 0x8000u;            /* MSI-X enable      */
+        mc &= (uint16_t)~0x4000u; /* function mask off */
+        io->w16(io->ctx, off, mc);
+        uint16_t back = io->cfg16 ? io->cfg16(io->ctx, off) : 0;
+        if (!(back & 0x8000u)) {
+            put_reason(why, why_n, "device refused the MSI-X enable bit");
+            return -2;
+        }
+        if (back & 0x4000u) {
+            put_reason(why, why_n, "device kept the MSI-X function mask set");
+            return -2;
+        }
+        return 0;
+    }
+
+    /* ---- MSI ---- */
+    uint16_t off = (uint16_t)(caps->cap_off + 2u);
+    uint16_t mc  = io->cfg16 ? io->cfg16(io->ctx, off) : 0;
+    mc &= (uint16_t)~0x0700u;          /* multiple-message enable = 1 msg */
+    mc &= (uint16_t)~0x0001u;          /* program while disabled          */
+    io->w16(io->ctx, off, mc);
+
+    io->w32(io->ctx, (uint16_t)(caps->cap_off + 4u), msg_addr);
+    uint16_t data_off = (uint16_t)(caps->cap_off + 12u);
+    if (caps->cap64) {
+        io->w32(io->ctx, (uint16_t)(caps->cap_off + 8u), 0);
+        data_off = (uint16_t)(caps->cap_off + 12u);
+    }
+    /* The data field is a WORD in the layout; write it as one. */
+    io->w16(io->ctx, data_off, (uint16_t)vector);
+    if (mc & 0x0010u) {
+        /* Per-vector masking capable: clear every mask bit (one vector, so
+         * the low 32 bits of the mask register cover it). */
+        io->w32(io->ctx, (uint16_t)(caps->cap_off + 16u), 0);
+    }
+    mc |= 0x0001u;                     /* enable */
+    io->w16(io->ctx, off, mc);
+    uint16_t back = io->cfg16 ? io->cfg16(io->ctx, off) : 0;
+    if (!(back & 0x0001u)) {
+        put_reason(why, why_n, "device refused the MSI enable bit");
+        return -2;
+    }
+    return 0;
+}
diff --git a/drivers/pci/msi_caps.h b/drivers/pci/msi_caps.h
new file mode 100644
index 0000000..d425dc9
--- /dev/null
+++ b/drivers/pci/msi_caps.h
@@ -0,0 +1,73 @@
+/* msi_caps.h — MSI / MSI-X capability parsing and programming
+ * (RESIDUE3 C4, ledger RES-36).
+ *
+ * The logic lives here, in the portable driver tree, and touches the device
+ * ONLY through a small accessor table: config space is whatever the transport
+ * speaks (the x86_64 virtio-blk path uses port I/O through `pci_config_read`;
+ * the modern virtio-pci path uses ECAM), and the MSI-X table is a BAR the
+ * caller maps.  That is what makes the whole thing host-testable
+ * (tests/unit/test_msi_caps.c drives it against a synthetic config space),
+ * which matters because a capability walker that is only ever run on QEMU is
+ * a walker whose edge cases nobody has seen.
+ *
+ * Scope, measured on QEMU (2026-11-03):
+ *   - cap id 0x05 = MSI, 0x11 = MSI-X.  MSI-X is preferred when both exist.
+ *   - the message address for the local APIC is 0xFEE00000 | (dest << 12);
+ *     the message data is the vector.  No DMAR/IRQ-remapping is enabled on
+ *     this tree, so the classic encoding is the correct one.
+ *   - every write is READ BACK: a device that refuses the enable bit is
+ *     reported, not assumed to have taken it.
+ */
+#ifndef AURALITE_DRIVERS_PCI_MSI_CAPS_H
+#define AURALITE_DRIVERS_PCI_MSI_CAPS_H
+
+#include <stdint.h>
+
+#define PCI_CAP_ID_MSI   0x05
+#define PCI_CAP_ID_MSIX  0x11
+
+#define MSI_KIND_NONE  0
+#define MSI_KIND_MSI   1
+#define MSI_KIND_MSIX  2
+
+/* The local APIC's message address, and the shape of a message. */
+#define MSI_APIC_ADDR_BASE 0xFEE00000u
+
+/* The caller supplies everything that is transport-specific.  Any of the
+ * writers may be NULL on a read-only transport; programming then fails
+ * loudly instead of silently doing nothing. */
+typedef struct {
+    void *ctx;
+    uint8_t  (*cfg8) (void *ctx, uint16_t off);
+    uint16_t (*cfg16)(void *ctx, uint16_t off);
+    uint32_t (*cfg32)(void *ctx, uint16_t off);
+    void     (*w16)  (void *ctx, uint16_t off, uint16_t v);
+    void     (*w32)  (void *ctx, uint16_t off, uint32_t v);
+    /* Map [bar:off, bar:off+len) into CPU-addressable memory.  0 = cannot. */
+    volatile uint8_t *(*bar_map)(void *ctx, uint8_t bar, uint32_t off,
+                                 uint32_t len);
+} msi_pci_io_t;
+
+typedef struct {
+    int      kind;          /* MSI_KIND_*                                     */
+    uint8_t  cap_off;       /* config-space offset of the capability          */
+    uint16_t n_vectors;     /* MSI-X: table entries; MSI: 1 << MMC            */
+    uint8_t  bir;           /* MSI-X: BAR indicator of the table              */
+    uint32_t table_off;     /* MSI-X: table offset inside that BAR            */
+    uint8_t  cap64;         /* MSI: 64-bit address capable                    */
+} msi_caps_t;
+
+/* Walk the capability list and describe what the device offers.
+ * Returns MSI_KIND_MSIX / MSI_KIND_MSI / MSI_KIND_NONE. */
+int msi_scan(const msi_pci_io_t *io, msi_caps_t *out);
+
+/* Program vector @vector to be delivered to APIC id @dest for the device
+ * described by @caps.  Returns 0 on success (and only after reading the
+ * enable bit back), -1 when there is no capability, -2 when the device
+ * refused, -3 when the transport cannot write or map.  @why receives a
+ * one-line reason on failure (may be NULL). */
+int msi_program(const msi_pci_io_t *io, const msi_caps_t *caps,
+                uint8_t vector, uint8_t dest_apic_id,
+                char *why, unsigned why_n);
+
+#endif /* AURALITE_DRIVERS_PCI_MSI_CAPS_H */
diff --git a/drivers/virtio_blk/virtio_blk.c b/drivers/virtio_blk/virtio_blk.c
index 2ecc78f..8ddcf66 100644
--- a/drivers/virtio_blk/virtio_blk.c
+++ b/drivers/virtio_blk/virtio_blk.c
@@ -6,6 +6,7 @@
 #include "kernel/mm/pmm.h"
 #include "kernel/lib/string.h"
 #include "kernel/lib/kprintf.h"
+#include "kernel/arch/arch.h"   /* RESIDUE3 C4: MSI, via the width seam */
 
 #define VIRTIO_VENDOR_ID         0x1AF4
 #define VIRTIO_BLK_MODERN_DEVICE 0x1042
@@ -63,10 +64,28 @@ static int present = 0;
 static uint8_t pci_bus, pci_dev, pci_func;
 static volatile struct virtio_pci_common_cfg *common_cfg;
 static volatile uint8_t *notify_base;
+/* C4: the ISR-status region (virtio-pci cfg_type 3).  Reading it is
+ * what retires the interrupt -- it is READ-TO-CLEAR, which is why the
+ * handler must touch this and nothing else. */
+static volatile uint8_t *isr_base;
+static volatile uint8_t *devcfg_base;
+/* C4: the device-config region (cfg_type 4), where virtio-blk's capacity
+ * lives.  The old code read BAR0 out of PCI config space and called it a
+ * sector count (measured: 18356408198371524609 sectors on an 8 MiB disk) --
+ * harmless only because the bound check it fed was always satisfied. */
 static uint32_t notify_multiplier;
 
 static struct vblk_queue q;
 static uint64_t device_capacity_sectors;
+/* C4: the MSI-X vector this device was attached to (0 = INTx/polling), and
+ * the number of interrupts it has taken.  The counter is the receipt that
+ * proves the vector is not merely programmed but DELIVERED. */
+static uint32_t msi_vector;
+/* Did the device offer VIRTIO_PCI_F_MSI_X (bit 27)?  Probing MSI-X on a
+ * device that did not is legal but the answer means nothing. */
+static int      msi_offered;
+static volatile uint32_t msi_irqs;
+static int      msi_report_done;
 
 static uint8_t pci_read8_at(uint8_t off) {
     uint32_t v = pci_config_read(pci_bus, pci_dev, pci_func, off & 0xFC);
@@ -86,6 +105,44 @@ static uint64_t map_bar_region(uint8_t bar, uint32_t offset, uint32_t length) {
     return hhdm + phys;
 }
 
+/* ---- RESIDUE3 C4 (RES-36): the MSI/MSI-X transport shims ---------------
+ *
+ * kernel/drivers/pci/msi_caps.c does not know how this driver reaches its
+ * config space (port I/O through pci_config_read) or its BARs
+ * (map_bar_region), so those are handed to it as an accessor table.  Nothing
+ * here makes a decision: it is the same three reads and two writes the
+ * capability walk above already does, in the shape the walker expects. */
+static uint8_t  msi_cfg8 (void *ctx, uint16_t off) { (void)ctx; return pci_read8_at((uint8_t)off); }
+static uint16_t msi_cfg16(void *ctx, uint16_t off) {
+    (void)ctx;
+    return (uint16_t)(pci_read8_at((uint8_t)off) | (pci_read8_at((uint8_t)(off + 1)) << 8));
+}
+static uint32_t msi_cfg32(void *ctx, uint16_t off) {
+    (void)ctx;
+    return pci_config_read(pci_bus, pci_dev, pci_func, (uint8_t)off);
+}
+static void msi_w16(void *ctx, uint16_t off, uint16_t v) {
+    (void)ctx;
+    /* The config mechanism exposes dword writes only: read, patch the half,
+     * write back.  A torn read-modify-write is not possible here -- this runs
+     * with interrupts disabled during probe, and nothing else touches this
+     * device's config space. */
+    uint32_t cur = pci_config_read(pci_bus, pci_dev, pci_func, (uint8_t)(off & 0xFC));
+    unsigned sh = (unsigned)(off & 2u) * 8u;
+    uint32_t mask = 0xFFFFu << sh;
+    pci_config_write(pci_bus, pci_dev, pci_func, (uint8_t)(off & 0xFC),
+                     (cur & ~mask) | ((uint32_t)v << sh));
+}
+static void msi_w32(void *ctx, uint16_t off, uint32_t v) {
+    (void)ctx;
+    pci_config_write(pci_bus, pci_dev, pci_func, (uint8_t)off, v);
+}
+static volatile uint8_t *msi_bar(void *ctx, uint8_t bar, uint32_t off, uint32_t len) {
+    (void)ctx;
+    uint64_t va = map_bar_region(bar, off, len ? len : 0x1000);
+    return (volatile uint8_t *)(uintptr_t)va;
+}
+
