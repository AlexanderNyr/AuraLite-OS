diff --git a/kernel/arch/i386/user32.c b/kernel/arch/i386/user32.c
index b709700..d9a4a7b 100644
--- a/kernel/arch/i386/user32.c
+++ b/kernel/arch/i386/user32.c
@@ -26,6 +26,8 @@
 #include "kernel/arch/i386/pmm32.h"
 #include "kernel/arch/i386/kprintf32.h"
 #include "kernel/arch/i386/thread32.h"
+#include "kernel/arch/i386/initrd32.h"
+#include "kernel/arch/i386/elf32load.h"
 
 /* user_entry32.asm */
 extern void user32_enter(uint32_t entry, uint32_t user_esp);
@@ -76,16 +78,25 @@ static void syscall32_dispatch(struct registers32 *regs)
 {
     switch (regs->eax) {
     case SYS32_WRITE: {
-        /* write(fd=ebx, buf=ecx, len=edx) -> console only at I4.
-         * Bound and range-check the user pointer against the user
-         * window; copy_from_user with fault fixup arrives in I5. */
-        if (regs->ebx != 1 ||
-            regs->ecx <  USER_STACK_VADDR ||
-            regs->ecx + regs->edx > USER_TEXT_VADDR + PAGE_SIZE_32 ||
-            regs->edx > PAGE_SIZE_32) {
+        /* write(fd=ebx, buf=ecx, len=edx) -> console only at I4/I5.
+         * I5 widened the check from the fixed I4 window to "every
+         * touched page is user-mapped": ELF images live at
+         * 0x08048000-region now, not just the hand-built page.  The
+         * probe walk is the bring-up stand-in for copy_from_user
+         * fault fixup (I6). */
