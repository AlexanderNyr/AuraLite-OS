+static uint32_t      g_stk[512];
+static wv_disp_t     g_di[4096];
+static char          g_lpo[131072];
+static wv_blk_t      g_lb[520];
+static wv_inl_t      g_li[520];
+static wv_walk_t     g_lw[520];
