+
+/* page-build arenas, global so load_html() can rebuild them */
+static wv_token_t    g_tt[2048];
+static wv_attr_t     g_ta[2048];
+static char          g_tp[65536];
+static wv_dom_node_t g_dn[2048];
+static wv_attr_t     g_dda[2048];
