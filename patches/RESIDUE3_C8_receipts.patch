+    SetLastError(0);
+    ok = CryptQueryObject(0, NULL, NULL, NULL, NULL, NULL, NULL, NULL);
+    err = GetLastError();
+    if (ok || err != 120) bad("CryptQueryObject", "unexpected", 120, err);
+    else receipt("CryptQueryObject", "FALSE", "as documented: ERROR_CALL_NOT_IMPLEMENTED");
+}
