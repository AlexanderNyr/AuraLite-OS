+}
+
+static void kernel32_checks(void) {
+    SetLastError(0);
+    BOOL ok = ReadDirectoryChangesW(NULL, NULL, 0, FALSE, 0, NULL, NULL, NULL);
+    DWORD err = GetLastError();
+    if (ok || err != 50) bad("ReadDirectoryChangesW", "unexpected", 50, err);
+    else receipt("ReadDirectoryChangesW", "FALSE", "as documented: ERROR_NOT_SUPPORTED");
+}
+
+static void sensapi_checks(void) {
+    DWORD flags = 0xFFFF;
+    BOOL alive = IsNetworkAlive(&flags);
+    /* Not a refusal: the personality probes and reports.  Both answers are
+     * honest, so the receipt records which one this machine gave. */
+    receipt("IsNetworkAlive", alive ? "TRUE" : "FALSE",
+            "probe: reachability reported, not invented");
+
+    BOOL r = IsDestinationReachableW(L"10.0.2.2:53", NULL);
+    receipt("IsDestinationReachableW", r ? "TRUE" : "FALSE",
+            "probe: reachability reported, not invented");
+
+    /* ...and the refusal half it does have: an empty destination. */
+    SetLastError(0);
+    r = IsDestinationReachableW(L"", NULL);
+    if (r != FALSE) bad("IsDestinationReachableW", "unexpected", 0, (DWORD)r);
+    else receipt("IsDestinationReachableW(empty)", "FALSE",
+                 "as documented: nothing to probe");
+}
+
+static void user32_checks(void) {
+    COMBOBOXINFO cbi;
+    zero(&cbi, (unsigned)sizeof cbi);
+    cbi.cbSize = sizeof cbi;
+    SetLastError(0);
+    BOOL ok = GetComboBoxInfo((HWND)(ULONG_PTR)0x1234, &cbi);
+    DWORD err = GetLastError();
+    if (ok || err != 6) bad("GetComboBoxInfo", "unexpected", 6, err);
+    else receipt("GetComboBoxInfo", "FALSE", "as documented: ERROR_INVALID_HANDLE");
+}
+
+static void wintrust_checks(void) {
+    LONG r = WinVerifyTrust(NULL, NULL, NULL);
+    if ((ULONG)r != (ULONG)C8_TRUST_E_NOSIGNATURE) bad("WinVerifyTrust", "unexpected", 0x800B0100u, (DWORD)r);
+    else receipt("WinVerifyTrust", "0x800B0100", "as documented: TRUST_E_NOSIGNATURE");
+}
+
+void __stdcall winstart(void) {
+    out = GetStdHandle(STD_OUTPUT_HANDLE);
+    fails = 0;
+    checks = 0;
+    say("C8: FAIL-CLEAN live receipts (docs/win32.md generates 35)\r\n");
+
+    advapi32_checks();     /*  9 */
+    comdlg32_checks();     /* 10 */
+    crypt32_checks();      /* 18 */
+    dwm_checks();          /* 20 */
+    imm_checks();          /* 30 */
+    kernel32_checks();     /* 31 */
+    sensapi_checks();      /* 34 (two probes + one refusal) */
+    user32_checks();       /* 35 */
+    wintrust_checks();     /* 36 */
+
+    if (fails) {
+        say("C8-FAILCLEAN-FAIL\r\n");
+        ExitProcess(1);
+    }
+    say("C8-FAILCLEAN-OK\r\n");
+    ExitProcess(78);
+}
diff --git a/home/user/AuraLite-OS/w32/tests/w32c8_static_slice.c b/w32/tests/w32c8_static_slice.c
new file mode 100644
index 0000000..7a25913
--- /dev/null
+++ b/w32/tests/w32c8_static_slice.c
@@ -0,0 +1,248 @@
+/* SPDX-License-Identifier: Apache-2.0.  Written for AuraLite OS; mingw-w64's
+ * public headers are used as a declaration source only, and every symbol below
+ * goes through the personality's own LoadLibraryA/GetProcAddress by NAME.
+ *
+ * w32/tests/w32c8_static_slice.c -- RESIDUE3_PLAN.md phase C8, box 2 (RES-57).
+ *
+ * The five app ledgers carry 1694 `static-only` markers: symbols the apps
+ * import, that the personality's export tables provide, and that nothing has
+ * ever been watched binding from the guest side.  RES-57 says so in the ledger:
+ * "bound but never called at runtime".
+ *
+ * This fixture closes the *binding* half by measurement, and demonstrates the
+ * calling half on a slice:
+ *
+ *   1. LoadLibraryA for each of the 20 DLLs the markers name;
+ *   2. GetProcAddress for each of the 820 distinct named pairs, per DLL,
+ *      printing `[w32] STATIC-ONLY <dll>: <have>/<total> resolved`;
+ *   3. every pair that comes back NULL is printed by name -- an import marker
+ *      over a symbol the personality does not actually export is a ledger
+ *      error and this is where it would show;
+ *   4. a 30-call slice of argument-free stubs (three to eight per DLL) is
+ *      *called*, not just resolved, so the FAIL-CLEAN notes fire and the
+ *      receipts are the personality's own;
+ *   5. exit 78 on a clean run, 1 if any resolution or call disagrees with the
+ *      table the host generated.
+ *
+ * The name/count tables are generated by tools/w32_static_slice.py from the
+ * ledgers and the export tables, so the guest and the host cannot disagree
+ * about what the list is.
+ */
+
+/* GetProcAddress returns FARPROC; the casts below are the point of the test,
+ * so the diagnostic that they are incompatible types is silenced where it
+ * applies rather than globally. */
+#pragma GCC diagnostic ignored "-Wcast-function-type"
+
+#include <windows.h>
+
+#define K_SO_PAIR_FIRST /* marker: the table below needs w32_so_pair_t */
+
+typedef struct { const char *dll; const char *sym; } w32_so_pair_t;
+
+#include "w32_static_slice.h"
+
+static HANDLE out;
+static unsigned bad_count;
+
+static unsigned long slen(const char *s) {
+    const char *p = s;
+    while (*p) p++;
+    return (unsigned long)(p - s);
+}
+
+static void say(const char *s) {
+    DWORD n = 0;
+    WriteFile(out, s, (DWORD)slen(s), &n, NULL);
+}
+
+static void say_dec(unsigned long v) {
+    char buf[24];
+    int i = 23;
+    buf[i--] = 0;
+    if (!v) buf[i--] = '0';
+    while (v) { buf[i--] = (char)('0' + (v % 10)); v /= 10; }
+    say(&buf[i + 1]);
+}
+
+static void say_key(const char *dll, const char *sym) {
+    say("[w32] STATIC-ONLY MISSING ");
+    say(dll);
+    say("!");
+    say(sym);
+    say("\r\n");
+}
+
+int winstart(void) {
+    out = GetStdHandle((DWORD)-11);
+    if (out == INVALID_HANDLE_VALUE) out = GetStdHandle((DWORD)-12);
+
+    say("C8: static-only receipts (RES-57: 1694 markers, ");
+    say_dec((unsigned long)K_SO_TOTAL);
+    say(" distinct named pairs)\r\n");
+
+    /* 1. LoadLibraryA for every DLL the markers name. */
+    HMODULE mod[K_SO_DLLS];
+    unsigned dlls_ok = 0;
+    for (unsigned i = 0; i < (unsigned)K_SO_DLLS; i++) {
+        mod[i] = LoadLibraryA(k_so_dlls[i]);
+        if (mod[i]) dlls_ok++;
+        else {
+            say("[w32] STATIC-ONLY MISSING MODULE ");
+            say(k_so_dlls[i]);
+            say("\r\n");
+            bad_count++;
+        }
+    }
+    say("[w32] STATIC-ONLY modules: ");
+    say_dec(dlls_ok);
+    say("/");
+    say_dec((unsigned long)K_SO_DLLS);
+    say(" loaded\r\n");
+
+    /* 2/3. Resolve every pair; count per DLL and name every NULL. */
+    unsigned resolved = 0;
+    for (unsigned i = 0; i < (unsigned)K_SO_DLLS; i++) {
+        if (!mod[i]) continue;
+        unsigned have = 0, total = 0;
+        for (unsigned p = 0; p < (unsigned)K_SO_PRINTED; p++) {
+            if (lstrcmpiA(k_so_printed[p].dll, k_so_dlls[i]) != 0) continue;
+            total++;
+            void *fp = (void *)GetProcAddress(mod[i], k_so_printed[p].sym);
+            if (fp) have++;
+            else {
+                say_key(k_so_printed[p].dll, k_so_printed[p].sym);
+                bad_count++;
+            }
+        }
+        if (!total) continue;
+        resolved += have;
+        say("[w32] STATIC-ONLY ");
+        say(k_so_dlls[i]);
+        say(": ");
+        say_dec(have);
+        say("/");
+        say_dec(total);
+        say(" resolved via GetProcAddress\r\n");
+        if (have != total) bad_count++;
+    }
+
+    /* K_SO_MISSING is 0 today; the loop stays so a future ledger/tables
+     * disagreement prints names instead of only a count. */
+    for (int p = 0; p < (int)K_SO_MISSING; p++)
+        say_key(k_so_missing[p].dll, k_so_missing[p].sym);
+
+    say("[w32] STATIC-ONLY ");
+    say_dec(resolved);
+    say("/");
+    say_dec((unsigned long)K_SO_PRINTED);
+    say(" resolved over ");
+    say_dec((unsigned long)K_SO_DLLS);
+    say(" modules (");
+    say_dec((unsigned long)K_SO_ORDINALS);
+    say(" further markers are ordinal imports: no name to resolve)\r\n");
+    if (resolved != (unsigned)K_SO_PRINTED) bad_count++;
+
+    /* 4. Call the slice.  These are the generated FAIL-CLEAN stubs, which take
+     * no arguments, so calling them through a `(void)` pointer cannot walk off
+     * the stack -- and the answer each one produces is its own receipt. */
+    unsigned called = 0, calls_real = 0;
+    for (unsigned c = 0; c < (unsigned)K_SO_CALLS; c++) {
+        unsigned idx = 0;
+        int found = 0;
+        for (unsigned i = 0; i < (unsigned)K_SO_DLLS && !found; i++) {
+            if (lstrcmpiA(k_so_callable[c].dll, k_so_dlls[i]) != 0) continue;
+            idx = i;
+            found = 1;
+        }
+        if (!found || !mod[idx]) { bad_count++; continue; }
+        void *fp = (void *)GetProcAddress(mod[idx], k_so_callable[c].sym);
+        if (!fp) { bad_count++; continue; }
+        unsigned long long (*fn)(void) = (unsigned long long (*)(void))fp;
+        unsigned long long r = fn();
+        say("[w32] STATIC-ONLY call ");
+        say(k_so_callable[c].dll);
+        say("!");
+        say(k_so_callable[c].sym);
+        say(" -> 0x");
+        {
+            char hex[20];
+            int i2 = 0;
+            for (int shift = 60; shift >= 0; shift -= 4) {
+                int nib = (int)((r >> shift) & 0xF);
+                hex[i2++] = (char)(nib < 10 ? '0' + nib : 'a' + nib - 10);
+            }
+            hex[i2] = 0;
+            say(hex);
+        }
+        say(" (called, not merely bound)\r\n");
+        called++;
+    }
+    say("[w32] STATIC-ONLY calls: ");
+    say_dec(called);
+    say("/");
+    say_dec((unsigned long)K_SO_CALLS);
+    say(" made\r\n");
+    if (called != (unsigned)K_SO_CALLS) bad_count++;
+
+    /* 4b. A hand-written slice of the *real* implementations the markers
+     * name -- the ones the argument-free rule above has to skip.  Four calls
+     * with their real prototypes, so the receipt is about more than stubs:
+     * static-only does not mean "stub", it means "nobody watched it". */
+    {
+        HMODULE u = LoadLibraryA("user32.dll");
+        HMODULE k = LoadLibraryA("kernel32.dll");
+        if (u) {
+            int (*p_gsm)(int) = (int (*)(int))GetProcAddress(u, "GetSystemMetrics");
+            if (!p_gsm) { bad_count++; }
+            else {
+                say("[w32] STATIC-ONLY call user32.dll!GetSystemMetrics(0) -> ");
+                say_dec((unsigned long)(unsigned)p_gsm(0));
+                say(" (real implementation, hand-written prototype)\r\n");
+                calls_real++;
+            }
+        } else bad_count++;
+        if (k) {
+            DWORD (*p_gv)(void) = (DWORD (*)(void))GetProcAddress(k, "GetVersion");
+            DWORD (*p_acp)(void) = (DWORD (*)(void))GetProcAddress(k, "GetACP");
+            LCID (*p_lcid)(void) = (LCID (*)(void))GetProcAddress(k, "GetUserDefaultLCID");
+            if (!p_gv || !p_acp || !p_lcid) { bad_count++; }
+            else {
+                say("[w32] STATIC-ONLY call kernel32.dll!GetVersion() -> 0x");
+                {
+                    char hex[20];
+                    DWORD r2 = p_gv();
+                    int i2 = 0;
+                    for (int shift = 28; shift >= 0; shift -= 4) {
+                        int nib = (int)((r2 >> shift) & 0xF);
+                        hex[i2++] = (char)(nib < 10 ? '0' + nib : 'a' + nib - 10);
+                    }
+                    hex[i2] = 0;
+                    say(hex);
+                }
+                say(" (packed major.minor.build)\r\n");
+                say("[w32] STATIC-ONLY call kernel32.dll!GetACP() -> ");
+                say_dec((unsigned long)p_acp());
+                say("\r\n");
+                say("[w32] STATIC-ONLY call kernel32.dll!GetUserDefaultLCID() -> 0x");
+                say_dec((unsigned long)p_lcid());
+                say("\r\n");
+                calls_real += 3;
+            }
+        } else bad_count++;
+        say("[w32] STATIC-ONLY real calls: ");
+        say_dec(calls_real);
+        say("/4\r\n");
+    }
+
+    if (bad_count) {
+        say("[w32] STATIC-ONLY FAIL ");
+        say_dec(bad_count);
+        say(" disagreement(s) with the generated table\r\n");
+        say("C8-STATIC-FAIL\r\n");
+        ExitProcess(1);       /* a plain `return` from the entry point exits
+                               * 0 through w32run, so the code is set here */
+    }
+    say("C8-STATIC-OK\r\n");
+    ExitProcess(78);
+}
diff --git a/home/user/AuraLite-OS/tools/w32_static_slice.py b/tools/w32_static_slice.py
new file mode 100755
index 0000000..46f16e7
--- /dev/null
+++ b/tools/w32_static_slice.py
@@ -0,0 +1,252 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""tools/w32_static_slice.py -- RESIDUE3_PLAN.md C8, box 2 (RES-57).
+
+The five W32 app ledgers record 1694 `static-only` import markers: 1670 by name
+and 24 by ordinal, which is 820 distinct named DLL/symbol pairs.  They are
+symbols the personality's export tables bind and that no pinned application was
+ever seen *calling*.  A marker like that is a claim about
+reachability that nothing has tested from the guest side -- the apps import
+them, but nobody has watched `LoadLibraryA` + `GetProcAddress` hand a real
+pointer back for them.
+
+This tool turns the markers into a fixture:
+
+  * it reads the ledgers, keeps the `static-only` pairs;
+  * it reads `w32/src/w32_bind.c`'s export table (the longhand `{ DLL, "Name"`
+    rows, resolved through the `#define`s at the top);
+  * it writes `build/w32_static_slice.h`: one name pair per line, split into
+    EXPORTED (the table has it -- the guest must get a non-NULL pointer back)
+    and ABSENT (the table does not -- the guest must get NULL, and the fixture
+    names it, because a static-only marker over a symbol the personality does
+    not export is a ledger error worth seeing).
+
+The guest fixture (`w32/tests/w32c8_static_slice.c`) resolves all of them by
+hand and calls a hand-picked slice whose signatures are known, so the
+marker count drops by measurement rather than by relabelling: after this gate
+runs, every pair in the file has a receipt from the machine.
+"""
+
+import os
+import re
+import sys
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+LEDGER_DIR = os.path.join(ROOT, "w32", "app_ledger")
+BIND_C = os.path.join(ROOT, "w32", "src", "w32_bind.c")
+# The export surface is two tables: the longhand D7 table and the generated
+# FAIL-CLEAN stubs.  A parser that reads only the first reports 9 exported
+# symbols as absent -- measured, and the reason this list has two files.
+STUBS_C = os.path.join(ROOT, "w32", "src", "w32_stubs_gen.c")
+OUT_H = os.path.join(ROOT, "build", "w32_static_slice.h")
+OUT_TXT = os.path.join(ROOT, "build", "w32_static_slice.txt")
+
+
+ORDINALS = []
+
+
+def parse_ledgers():
+    """Return {(dll, sym): [ledger names]} for the static-only markers."""
+    marks = {}
+    for name in sorted(os.listdir(LEDGER_DIR)):
+        if not name.endswith(".imports"):
+            continue
+        for line in open(os.path.join(LEDGER_DIR, name), encoding="utf-8"):
+            line = line.strip()
+            if not line or line.startswith("#") or line.startswith("imports_total"):
+                continue
+            parts = line.split()
+            if len(parts) < 3:
+                continue
+            dll, sym = parts[0], parts[1]
+            if not dll.endswith(".dll"):
+                continue
+            if "static-only" not in parts[2:]:
+                continue
+            if sym.startswith("#"):          # ordinal import: no name to resolve
+                ORDINALS.append((dll.lower(), sym))
+                continue
+            marks.setdefault((dll.lower(), sym), []).append(name)
+    return marks
+
+
+DEF_RE = re.compile(r'^#define\s+(\w+)\s+"([^"]+\.dll)"\s*$', re.IGNORECASE)
+# A row is `{ MACRO, "Name", ... }` or `{ "dll.name.dll", "Name", ... }` --
+# both spellings appear in the table, and the second one is the reason a
+# macro-only parser reports 72 "absent" symbols that are in fact exported.
+ROW_RE = re.compile(r'^\s*\{\s*(?:"([^"]+\.dll)"|(\w+))\s*,\s*"([^"]+)"\s*,',
+                    re.IGNORECASE)
+
+
+def parse_stub_exports():
+    """Only the generated stub table: these take `(void)`, so the fixture can
+    call one with no arguments and it cannot walk off the stack."""
+    rows = []
+    for line in open(STUBS_C, encoding="utf-8"):
+        m = ROW_RE.match(line)
+        if m and m.group(1):
+            rows.append((m.group(1).lower(), m.group(3)))
+    return set(rows)
+
+
+def parse_bind_exports():
+    """The longhand D7 table only."""
+    defines, rows = {}, []
+    for line in open(BIND_C, encoding="utf-8"):
+        m = DEF_RE.match(line)
+        if m:
+            defines[m.group(1)] = m.group(2).lower()
+            continue
+        m = ROW_RE.match(line)
+        if not m:
+            continue
+        if m.group(1):
+            rows.append((m.group(1).lower(), m.group(3)))
+        elif m.group(2) in defines:
+            rows.append((defines[m.group(2)], m.group(3)))
+    return set(rows)
+
+
+def parse_exports():
+    defines, rows = {}, []
+    for line in open(BIND_C, encoding="utf-8"):
+        m = DEF_RE.match(line)
+        if m:
+            defines[m.group(1)] = m.group(2).lower()
+            continue
+        m = ROW_RE.match(line)
+        if not m:
+            continue
+        if m.group(1):
+            rows.append((m.group(1).lower(), m.group(3)))
+        elif m.group(2) in defines:
+            rows.append((defines[m.group(2)], m.group(3)))
+    for line in open(STUBS_C, encoding="utf-8"):
+        m = ROW_RE.match(line)
+        if m and m.group(1):
+            rows.append((m.group(1).lower(), m.group(3)))
+    return set(rows)
+
+
+def _unused():  # keeps the old loop shape readable in diffs
+    defines, rows = {}, []
+    for line in []:
+        m = DEF_RE.match(line)
+        if m:
+            defines[m.group(1)] = m.group(2).lower()
+            continue
+        m = ROW_RE.match(line)
+        if not m:
+            continue
+        if m.group(1):
+            rows.append((m.group(1).lower(), m.group(3)))
+        elif m.group(2) in defines:
+            rows.append((defines[m.group(2)], m.group(3)))
+    return set(rows)
+
+
+def main():
+    marks = parse_ledgers()
+    sum_suppressed = [len(ORDINALS) + sum(len(v) for v in marks.values())]
+    exports = parse_exports()
+    stubs = parse_stub_exports()
+    # A symbol present in BOTH tables is a real implementation that shadows
+    # the generated stub (w32_resolve prefers the longhand table).  Calling
+    # one with fabricated arguments is not a binding test: measured, the slice
+    # went through user32!CreateIconIndirect -- a real function -- and faulted
+    # at CR2=0xa4 because its first argument was NULL.  Calls are restricted
+    # to stubs that nothing shadows, which by construction take no arguments.
+    shadowed = parse_bind_exports()
+    have = sorted(p for p in marks if p in exports)
+    # The representative slice: static-only symbols the fixture can CALL as
+    # well as resolve.  Three per DLL, taken from the generated stub table so
+    # the call is argument-free and the answer is the stub's own receipt.
+    per_dll, callable_ = {}, []
+    for d, sym in have:
+        if (d, sym) not in stubs or (d, sym) in shadowed:
+            continue
+        # msvcrt's surface is CRT machinery: data exports (`_acmdln`), the SEH
+        # dispatcher, C++ terminate.  Calling one of those with fabricated
+        # registers is not a test of binding, it is a crash -- measured: the
+        # first version of this slice called msvcrt!__C_specific_handler and
+        # faulted at RIP 0x40007bf8 (CR2=0x42) before printing a receipt.
+        # They stay in the resolution list (that is what RES-57 asks about)
+        # and leave the call slice.
+        if d == "msvcrt.dll" or sym.startswith("_"):
+            continue
+        # The C++ runtime stubs are FAIL-CLEAN in name only: `?terminate`,
+        # `_CxxThrowException` and friends *abort the run* by design, which is
+        # not a receipt about binding.  Measured -- calling
+        # msvcrt!??1type_info@@UEAA@XZ ended the guest with W32-CXX-TERMINATE.
+        if sym.startswith("?") or sym.startswith("_Cxx") or \
+           sym.startswith("__Cxx") or sym.startswith("_Xcpt") or \
+           "terminate" in sym:
+            continue
+        if per_dll.get(d, 0) >= 8:
+            continue
+        per_dll[d] = per_dll.get(d, 0) + 1
+        callable_.append((d, sym))
+    absent = sorted(p for p in marks if p not in exports)
+    total = len(marks)
+
+    if not have:
+        print("w32_static_slice: no static-only marker resolves -- is the "
+              "export table still parsed?", file=sys.stderr)
+        return 1
+
+    dlls = sorted({d for d, _ in have})
+    out = []
+    out.append("/* Generated by tools/w32_static_slice.py -- do not edit.\n"
+               " * RESIDUE3_PLAN.md C8 box 2: every `static-only` ledger pair,\n"
+               " * split by whether the personality's export tables provide it. */\n")
+    out.append("#define K_SO_ORDINALS %d\n" % len(ORDINALS))
+    out.append("#define K_SO_MARKERS %d\n" % sum_suppressed[0])
+    out.append("#define K_SO_TOTAL %d\n" % total)
+    out.append("#define K_SO_PRINTED %d\n" % len(have))
+    out.append("#define K_SO_MISSING %d\n" % len(absent))
+    out.append("#define K_SO_DLLS %d\n" % len(dlls))
+    out.append("#define K_SO_CALLS %d\n\n" % len(callable_))
+    out.append("static const w32_so_pair_t k_so_printed[] = {\n")
+    for d, sym in have:
+        out.append('    { "%s", "%s" },\n' % (d, sym))
+    out.append("};\n\nstatic const w32_so_pair_t k_so_missing[] = {\n")
+    for d, sym in absent:
+        out.append('    { "%s", "%s" },\n' % (d, sym))
+    out.append("};\n\nstatic const w32_so_pair_t k_so_callable[] = {\n")
+    for d, sym in callable_:
+        out.append('    { "%s", "%s" },\n' % (d, sym))
+    out.append("};\n\nstatic const char *const k_so_dlls[] = {\n")
+    for d in dlls:
+        out.append('    "%s",\n' % d)
+    out.append("};\n")
+    with open(OUT_H, "w", encoding="utf-8") as f:
+        f.write("".join(out))
+
+    with open(OUT_TXT, "w", encoding="utf-8") as f:
+        for d, s in have:
+            f.write("have %s %s %s\n" % (d, s, ",".join(sorted(set(marks[(d, s)])))))
+        for d, s in absent:
+            f.write("absent %s %s %s\n" % (d, s, ",".join(sorted(set(marks[(d, s)])))))
+
+    per_dll = {}
+    for d, _ in marks:
+        per_dll[d] = per_dll.get(d, 0) + 1
+    print("w32_static_slice: %d static-only markers (%d by name, %d by ordinal),"
+          " %d distinct named pairs"
+          % (sum_suppressed[0], sum(len(v) for v in marks.values()),
+             len(ORDINALS), total))
+    print("  callable slice (argument-free stubs): %d, over %d DLLs"
+          % (len(callable_), len(per_dll)))
+    print("  exported by the personality: %d   absent from the table: %d   "
+          "input DLLs: %d" % (len(have), len(absent), len(dlls)))
+    for d in sorted(per_dll):
+        print("    %-16s %4d" % (d, per_dll[d]))
+    if absent:
+        print("  absent (these markers name symbols the table does not export):")
+        for d, s in absent[:20]:
+            print("    %s!%s" % (d, s))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
