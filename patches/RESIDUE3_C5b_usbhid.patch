diff --git a/tests/unit/test_usb_ehci_qh.c b/tests/unit/test_usb_ehci_qh.c
new file mode 100644
index 0000000..b5adf57
--- /dev/null
+++ b/tests/unit/test_usb_ehci_qh.c
@@ -0,0 +1,237 @@
+/*
+ * test_usb_ehci_qh.c — RESIDUE3 C5b: the EHCI queue-head capability words,
+ * including the split-transaction fields.
+ *
+ * drivers/usb/ehci_qh.c is compiled UNMODIFIED; this file supplies endpoint
+ * parameters and decodes the two 32-bit words back into named fields, so a
+ * failure names the field that moved rather than a hex difference.
+ *
+ * WHY THIS EXISTS.  C5b's plan asked for an integration case with a FS/LS
+ * device behind a high-speed hub on EHCI, so the TT fields would be shown to
+ * schedule a real periodic transfer.  That case cannot be built on QEMU: its
+ * only hub, `usb-hub`, is a full-speed device and QEMU refuses it on a
+ * high-speed bus ("speed mismatch trying to attach usb device \"QEMU USB
+ * Hub\" (full speed) to bus \"e.0\", port \"1\" (high speed)").  The register
+ * encoding is therefore verified here, bit position by bit position, against
+ * EHCI 1.0 §3.6 and §4.12 — and the split decision is logged by ehci.c at
+ * runtime, so a machine that does have a TT shows it in the boot log.
+ */
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "drivers/usb/ehci_qh.h"
+
+static int passed = 0, failed = 0, tn = 0;
+#define RUN(f) do { int b = failed; f(); tn++; if (failed == b) passed++; } while (0)
+#define CHECK(c) do { if (!(c)) { printf("  FAIL L%d: %s\n", __LINE__, #c); failed++; } } while (0)
+#define CHECK_EQ(a,e) do { long _a=(long)(a), _e=(long)(e); if (_a!=_e) { \
+    printf("  FAIL L%d: %s = %ld, want %ld\n", __LINE__, #a, _a, _e); failed++; } } while (0)
+
+/* --- field extraction, spelled the way EHCI 1.0 §3.6 labels them --------- */
+static uint32_t f_devaddr (uint32_t c1) { return  c1        & 0x7Fu; }
+static uint32_t f_inact   (uint32_t c1) { return (c1 >> 7)  & 0x1u;  }
+static uint32_t f_epnum   (uint32_t c1) { return (c1 >> 8)  & 0xFu;  }
+static uint32_t f_eps     (uint32_t c1) { return (c1 >> 12) & 0x3u;  }
+static uint32_t f_dtc     (uint32_t c1) { return (c1 >> 14) & 0x1u;  }
+static uint32_t f_mpl     (uint32_t c1) { return (c1 >> 16) & 0x7FFu; }
+static uint32_t f_smask   (uint32_t c2) { return  c2        & 0xFFu; }
+static uint32_t f_cmask   (uint32_t c2) { return (c2 >> 8)  & 0xFFu; }
+static uint32_t f_hubaddr (uint32_t c2) { return (c2 >> 16) & 0x7Fu; }
+static uint32_t f_hubport (uint32_t c2) { return (c2 >> 23) & 0x7Fu; }
+static uint32_t f_mult    (uint32_t c2) { return (c2 >> 30) & 0x3u;  }
+
+static ehci_qh_params_t base_params(void) {
+    ehci_qh_params_t p;
+    memset(&p, 0, sizeof(p));
+    p.dev_addr = 1;
+    p.ep_num = 1;                 /* 0x81 -> endpoint number 1 */
+    p.speed = EHCI_QH_SPEED_HIGH;
+    p.max_packet = 8;
+    p.mult = 1;
+    p.start_microframe = 0;
+    return p;
+}
+
+/* ---------------------------------------------------------------- cases --- */
+
+/* A high-speed device on a root port: no TT, no split, S-mask still set
+ * because the QH is periodic. */
+static void test_high_speed_no_split(void) {
+    ehci_qh_params_t p = base_params();
+    ehci_qh_caps_t c;
+    ehci_qh_build_caps(&p, &c);
+
+    CHECK_EQ(c.is_split, 0);
+    CHECK_EQ(f_eps(c.ep_caps1), EHCI_QH_SPEED_HIGH);
+    CHECK_EQ(f_devaddr(c.ep_caps1), 1);
+    CHECK_EQ(f_epnum(c.ep_caps1), 1);
+    CHECK_EQ(f_mpl(c.ep_caps1), 8);
+    CHECK_EQ(f_dtc(c.ep_caps1), 1);      /* data toggle comes from the qTD */
+    CHECK_EQ(f_inact(c.ep_caps1), 0);
+    CHECK_EQ(f_smask(c.ep_caps2), 0x01);
+    CHECK_EQ(f_cmask(c.ep_caps2), 0x00); /* no complete-splits without a TT */
+    CHECK_EQ(f_hubaddr(c.ep_caps2), 0);
+    CHECK_EQ(f_hubport(c.ep_caps2), 0);
+    CHECK_EQ(f_mult(c.ep_caps2), 1);
+}
+
+/* QEMU's actual case (C5b measurement): a full-speed keyboard attached
+ * straight to the EHCI controller.  Full speed, hub address 0 -- and
+ * therefore NOT a split, whatever the speed says. */
+static void test_full_speed_direct_has_no_tt(void) {
+    ehci_qh_params_t p = base_params();
+    p.speed = EHCI_QH_SPEED_FULL;
+    p.max_packet = 8;
+    ehci_qh_caps_t c;
+    ehci_qh_build_caps(&p, &c);
+
+    CHECK_EQ(c.is_split, 0);
+    CHECK_EQ(f_eps(c.ep_caps1), EHCI_QH_SPEED_FULL);
+    CHECK_EQ(f_cmask(c.ep_caps2), 0);
+    CHECK_EQ(f_hubaddr(c.ep_caps2), 0);
+    CHECK_EQ(ehci_qh_needs_split(EHCI_QH_SPEED_FULL, 0), 0);
+}
+
+/* The split case the plan wanted: full speed behind a TT at hub address 2,
+ * port 3.  This is where the TT fields have to be exactly right. */
+static void test_full_speed_behind_tt(void) {
+    ehci_qh_params_t p = base_params();
+    p.speed = EHCI_QH_SPEED_FULL;
+    p.hub_addr = 2;
+    p.hub_port = 3;
+    ehci_qh_caps_t c;
+    ehci_qh_build_caps(&p, &c);
+
+    CHECK_EQ(c.is_split, 1);
+    CHECK_EQ(f_eps(c.ep_caps1), EHCI_QH_SPEED_FULL);
+    CHECK_EQ(f_hubaddr(c.ep_caps2), 2);
+    CHECK_EQ(f_hubport(c.ep_caps2), 3);
+    /* One start-split, in microframe 0. */
+    CHECK_EQ(f_smask(c.ep_caps2), 0x01);
+    CHECK_EQ(c.s_mask & (uint8_t)(c.s_mask - 1), 0);   /* exactly one bit */
+    /* Complete-splits follow the start-split, and never overlap it. */
+    CHECK_EQ(f_cmask(c.ep_caps2) & f_smask(c.ep_caps2), 0);
+    CHECK(f_cmask(c.ep_caps2) != 0);
+    /* Microframe 0 is the last start, so the three flags in 1..3. */
+    CHECK_EQ(f_cmask(c.ep_caps2), 0x0E);
+}
+
+/* Low speed behind the same TT: same split fields, different EPS. */
+static void test_low_speed_behind_tt(void) {
+    ehci_qh_params_t p = base_params();
+    p.speed = EHCI_QH_SPEED_LOW;
+    p.hub_addr = 5;
+    p.hub_port = 1;
+    p.max_packet = 4;
+    ehci_qh_caps_t c;
+    ehci_qh_build_caps(&p, &c);
+
+    CHECK_EQ(c.is_split, 1);
+    CHECK_EQ(f_eps(c.ep_caps1), EHCI_QH_SPEED_LOW);
+    CHECK_EQ(f_hubaddr(c.ep_caps2), 5);
+    CHECK_EQ(f_hubport(c.ep_caps2), 1);
+    CHECK_EQ(f_mpl(c.ep_caps1), 4);
+}
+
+/* A non-zero start microframe must move both masks and keep them disjoint,
+ * for every one of the eight possible phases. */
+static void test_start_microframe_rotates_masks(void) {
+    for (uint8_t mf = 0; mf < 8; mf++) {
+        ehci_qh_params_t p = base_params();
+        p.speed = EHCI_QH_SPEED_FULL;
+        p.hub_addr = 2;
+        p.hub_port = 1;
+        p.start_microframe = mf;
+        ehci_qh_caps_t c;
+        ehci_qh_build_caps(&p, &c);
+
+        CHECK_EQ(f_smask(c.ep_caps2), 1u << mf);
+        CHECK_EQ(f_cmask(c.ep_caps2) & f_smask(c.ep_caps2), 0);
+        /* Three complete-split micro-frames, starting right after the start
+         * and wrapping past bit 7 (a late start must not leave the mask
+         * empty -- the controller would never see a complete-split). */
+        CHECK(f_cmask(c.ep_caps2) != 0);
+        {
+            uint8_t cm = (uint8_t)f_cmask(c.ep_caps2);
+            int bits = 0;
+            for (int b = 0; b < 8; b++) bits += (cm >> b) & 1;
+            CHECK_EQ(bits, 3);
+        }
+        CHECK_EQ(f_cmask(c.ep_caps2) & ~0xFFu, 0);
+        CHECK_EQ(f_hubaddr(c.ep_caps2), 2);
+    }
+}
+
+/* Field widths: address and port are 7 bits each, endpoints 4, MPL 11, Mult
+ * 2.  Values wider than a field must be truncated at the field, not bleed
+ * into the neighbouring one. */
+static void test_field_widths(void) {
+    ehci_qh_params_t p = base_params();
+    p.dev_addr = 0xFF;          /* 7 bits  -> 0x7F */
+    p.ep_num = 0xFF;            /* 4 bits  -> 0x0F */
+    p.max_packet = 0xFFFF;      /* 11 bits -> 0x7FF */
+    p.speed = EHCI_QH_SPEED_FULL;
+    p.hub_addr = 0xFF;          /* 7 bits  -> 0x7F */
+    p.hub_port = 0xFF;          /* 7 bits  -> 0x7F */
+    p.mult = 0xFF;              /* 2 bits  -> 0x3  */
+    ehci_qh_caps_t c;
+    ehci_qh_build_caps(&p, &c);
+
+    CHECK_EQ(f_devaddr(c.ep_caps1), 0x7F);
+    CHECK_EQ(f_epnum(c.ep_caps1), 0x0F);
+    CHECK_EQ(f_mpl(c.ep_caps1), 0x7FF);
+    CHECK_EQ(f_eps(c.ep_caps1), EHCI_QH_SPEED_FULL);
+    CHECK_EQ(f_hubaddr(c.ep_caps2), 0x7F);
+    CHECK_EQ(f_hubport(c.ep_caps2), 0x7F);
+    CHECK_EQ(f_mult(c.ep_caps2), 0x3);
+    /* The two words must not collide: caps1 stops at bit 26, eps at 13. */
+    CHECK_EQ(c.ep_caps1 & ~((1u << 27) - 1), 0);
+}
+
+/* Mult = 0 means "one transaction per microframe" in this driver; it must not
+ * be encoded as the reserved value 0. */
+static void test_mult_zero_becomes_one(void) {
+    ehci_qh_params_t p = base_params();
+    p.mult = 0;
+    ehci_qh_caps_t c;
+    ehci_qh_build_caps(&p, &c);
+    CHECK_EQ(f_mult(c.ep_caps2), 1);
+}
+
+/* The split decision as a standalone predicate, including the combination
+ * that would be a bug: a high-speed device reached "through a hub" needs no
+ * split (hubs are transparent to high-speed traffic). */
+static void test_needs_split_predicate(void) {
+    CHECK_EQ(ehci_qh_needs_split(EHCI_QH_SPEED_FULL, 0), 0);
+    CHECK_EQ(ehci_qh_needs_split(EHCI_QH_SPEED_LOW, 0), 0);
+    CHECK_EQ(ehci_qh_needs_split(EHCI_QH_SPEED_FULL, 1), 1);
+    CHECK_EQ(ehci_qh_needs_split(EHCI_QH_SPEED_LOW, 1), 1);
+    CHECK_EQ(ehci_qh_needs_split(EHCI_QH_SPEED_HIGH, 3), 0);
+}
+
+/* NULL tolerance: called from an error path, must not fault. */
+static void test_rejects_null(void) {
+    ehci_qh_caps_t c;
+    memset(&c, 0xAA, sizeof(c));
+    ehci_qh_build_caps(NULL, &c);
+    CHECK_EQ(c.ep_caps1, 0xAAAAAAAAu);
+    ehci_qh_params_t p = base_params();
+    ehci_qh_build_caps(&p, NULL);
+}
+
+int main(void) {
+    printf("=== AuraLite OS EHCI queue-head capability tests ===\n");
+    RUN(test_high_speed_no_split);
+    RUN(test_full_speed_direct_has_no_tt);
+    RUN(test_full_speed_behind_tt);
+    RUN(test_low_speed_behind_tt);
+    RUN(test_start_microframe_rotates_masks);
+    RUN(test_field_widths);
+    RUN(test_mult_zero_becomes_one);
+    RUN(test_needs_split_predicate);
+    RUN(test_rejects_null);
+    printf("\n=== Results: %d/%d passed, %d failed ===\n", passed, tn, failed);
+    return failed ? 1 : 0;
+}
diff --git a/tests/unit/test_usb_hid_report.c b/tests/unit/test_usb_hid_report.c
new file mode 100644
index 0000000..67bf2de
--- /dev/null
+++ b/tests/unit/test_usb_hid_report.c
@@ -0,0 +1,290 @@
+/*
+ * test_usb_hid_report.c — RESIDUE3 C5b (RES-62): the HID report-descriptor
+ * parser, driven against fixtures.
+ *
+ * drivers/usb/hid_report.c is compiled UNMODIFIED.  What this file supplies is
+ * descriptors: a boot keyboard, a two-report-ID device (keyboard + consumer
+ * controls), a truncated descriptor and one with nothing usable in it.
+ *
+ * Why it matters: before C5b the parser kept ONE `report_id` for the whole
+ * descriptor and one running bit cursor, so a device declaring IDs 1 and 2
+ * folded report 2's fields onto ID 1 and started its layout at bit 8 of the
+ * wrong report.  Every case below is one that a QEMU-only parser never saw --
+ * QEMU's `usb-kbd` and `usb-tablet` happen to use layouts where the bug is
+ * invisible.
+ */
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "drivers/usb/hid_report.h"
+
+static int passed = 0, failed = 0, tn = 0;
+#define RUN(f) do { int b = failed; f(); tn++; if (failed == b) passed++; } while (0)
+#define CHECK(c) do { if (!(c)) { printf("  FAIL L%d: %s\n", __LINE__, #c); failed++; } } while (0)
+#define CHECK_EQ(a,e) do { long _a=(long)(a), _e=(long)(e); if (_a!=_e) { \
+    printf("  FAIL L%d: %s = %ld, want %ld\n", __LINE__, #a, _a, _e); failed++; } } while (0)
+
+/* ---- the classic 8-byte boot keyboard, no Report ID ------------------- */
+static const uint8_t desc_boot_kbd[] = {
+    0x05, 0x01,        /* Usage Page (Generic Desktop) */
+    0x09, 0x06,        /* Usage (Keyboard) */
+    0xA1, 0x01,        /* Collection (Application) */
+    0x05, 0x07,        /*   Usage Page (Keyboard) */
+    0x19, 0xE0,        /*   Usage Min (0xE0) */
+    0x29, 0xE7,        /*   Usage Max (0xE7) */
+    0x15, 0x00,        /*   Logical Min (0) */
+    0x25, 0x01,        /*   Logical Max (1) */
+    0x75, 0x01,        /*   Report Size (1) */
+    0x95, 0x08,        /*   Report Count (8) */
+    0x81, 0x02,        /*   Input (Data,Var,Abs)  -> 8 modifier bits */
+    0x95, 0x01,        /*   Report Count (1) */
+    0x75, 0x08,        /*   Report Size (8) */
+    0x81, 0x01,        /*   Input (Const)         -> 1 reserved byte */
+    0x95, 0x06,        /*   Report Count (6) */
+    0x75, 0x08,        /*   Report Size (8) */
+    0x15, 0x00,        /*   Logical Min (0) */
+    0x25, 0x65,        /*   Logical Max (101) */
+    0x05, 0x07,        /*   Usage Page (Keyboard) */
+    0x19, 0x00,        /*   Usage Min (0) */
+    0x29, 0x65,        /*   Usage Max (101) */
+    0x81, 0x00,        /*   Input (Data,Array)    -> 6 keycodes */
+    0xC0,              /* End Collection */
+};
+
+/* ---- two reports: ID 1 keyboard (mods + 2 keys), ID 2 consumer --------- */
+static const uint8_t desc_two_ids[] = {
+    0x05, 0x01,        /* Usage Page (Generic Desktop) */
+    0x09, 0x06,        /* Usage (Keyboard) */
+    0xA1, 0x01,        /* Collection (Application) */
+
+    0x85, 0x01,        /*   Report ID (1) */
+    0x05, 0x07,        /*   Usage Page (Keyboard) */
+    0x19, 0xE0,        /*   Usage Min (0xE0) */
+    0x29, 0xE7,        /*   Usage Max (0xE7) */
+    0x15, 0x00, 0x25, 0x01,
+    0x75, 0x01, 0x95, 0x08,
+    0x81, 0x02,        /*   Input: 8 modifier bits, bits 0..7   */
+    0x95, 0x02,        /*   Report Count (2) */
+    0x75, 0x08,        /*   Report Size (8) */
+    0x15, 0x00, 0x25, 0x65,
+    0x05, 0x07, 0x19, 0x00, 0x29, 0x65,
+    0x81, 0x00,        /*   Input: 2 keycodes, bits 8..23      */
+
+    0x85, 0x02,        /*   Report ID (2)  -- new report, cursor restarts */
+    0x05, 0x0C,        /*   Usage Page (Consumer) */
+    0x09, 0xE9,        /*   Usage (Volume Up) */
+    0x15, 0x00, 0x25, 0x01,
+    0x75, 0x01, 0x95, 0x04,
+    0x81, 0x02,        /*   Input: 4 bits, bits 0..3 of report 2 */
+    0xC0,              /* End Collection */
+};
+
+/* Padding-only: parses, but declares nothing this driver interprets. */
+static const uint8_t desc_padding_only[] = {
+    0x05, 0x01, 0x09, 0x06, 0xA1, 0x01,
+    0x75, 0x08, 0x95, 0x04, 0x81, 0x01,   /* Input (Const) x4 */
+    0xC0,
+};
+
+static void test_boot_keyboard(void) {
+    hid_report_t r;
+    CHECK_EQ(hid_report_parse(&r, desc_boot_kbd, sizeof(desc_boot_kbd)), 0);
+    CHECK_EQ(r.has_report_id, 0);
+    CHECK_EQ(r.is_keyboard, 1);
+    CHECK_EQ(r.is_mouse, 0);
+    /* 8 modifier bits + 6 keycodes; the reserved byte is constant and is not
+     * a field, but it DOES advance the cursor. */
+    CHECK_EQ(r.field_count, 14);
+    CHECK_EQ(hid_report_wire_len(&r), 8);
+    CHECK_EQ(r.fields[0].report_id, 0);
+    CHECK_EQ(r.fields[0].bit_offset, 0);
+    CHECK_EQ(r.fields[0].size, 1);
+    /* The first keycode starts after the 8 modifier bits and the reserved
+     * byte: bit 16. */
+    CHECK_EQ(r.fields[8].bit_offset, 16);
+    CHECK_EQ(r.fields[8].size, 8);
+    CHECK_EQ(r.fields[8].usage_page, HID_USAGE_PAGE_KEYBOARD);
+}
+
+static void test_two_report_ids(void) {
+    hid_report_t r;
+    CHECK_EQ(hid_report_parse(&r, desc_two_ids, sizeof(desc_two_ids)), 0);
+    CHECK_EQ(r.has_report_id, 1);
+    CHECK_EQ(r.report_id_count, 2);
+    CHECK_EQ(r.report_ids[0], 1);
+    CHECK_EQ(r.report_ids[1], 2);
+
+    /* Report 1: 8 mod bits + 2 keycodes = 24 bits. */
+    CHECK_EQ(hid_report_bits(&r, 1), 24);
+    /* Report 2: 4 bits -- NOT 8+ something, because the cursor restarts at
+     * the second Report ID item.  This is the assertion the old parser
+     * failed: it would have reported 28 bits for "report 2". */
+    CHECK_EQ(hid_report_bits(&r, 2), 4);
+
+    /* Fields carry their own report ID. */
+    CHECK_EQ(r.fields[0].report_id, 1);
+    CHECK_EQ(r.fields[0].usage, 0xE0);
+    uint8_t last_kbd = 0;
+    for (uint8_t i = 0; i < r.field_count; i++)
+        if (r.fields[i].report_id == 1) last_kbd = i;
+    CHECK_EQ(r.fields[last_kbd].report_id, 1);
+    /* The consumer-control bits are report 2, starting at bit 0 of ITS
+     * report (four one-bit fields). */
+    int consumer = -1, consumer_n = 0;
+    for (uint8_t i = 0; i < r.field_count; i++) {
+        if (r.fields[i].report_id != 2) continue;
+        if (consumer < 0) consumer = i;
+        consumer_n++;
+    }
+    CHECK_EQ(consumer_n, 4);
+    CHECK(consumer >= 0);
+    CHECK_EQ(r.fields[consumer].bit_offset, 0);
+    CHECK_EQ(r.fields[consumer].usage_page, 0x0C);
+
+    /* Wire length is the largest body (3 bytes) plus the ID prefix. */
+    CHECK_EQ(hid_report_wire_len(&r), 4);
+}
+
+static void test_body_split(void) {
+    hid_report_t r;
+    uint32_t body_len = 0;
+    uint8_t id = 0;
+    CHECK_EQ(hid_report_parse(&r, desc_two_ids, sizeof(desc_two_ids)), 0);
+
+    /* Report 1: ID 0x01, mods = 0x02 (Left Shift), keycodes {0x04, 0x00}. */
+    const uint8_t rep1[] = { 0x01, 0x02, 0x04, 0x00 };
+    const uint8_t *body = hid_report_body(&r, rep1, sizeof(rep1), &body_len, &id);
+    CHECK(body != NULL);
+    CHECK_EQ(id, 1);
+    CHECK_EQ(body_len, 3);
+    int kbd_mod = -1, kbd_key0 = -1;
+    for (uint8_t i = 0; i < r.field_count; i++) {
+        if (r.fields[i].report_id != 1) continue;
+        if (r.fields[i].usage == 0xE1) kbd_mod = i;          /* Left Shift */
+        if (r.fields[i].size == 8 && kbd_key0 < 0) kbd_key0 = i;
+    }
+    CHECK(kbd_mod >= 0);
+    CHECK_EQ(hid_report_field_value(body, &r.fields[kbd_mod]), 1);
+    CHECK(kbd_key0 >= 0);
+    CHECK_EQ(hid_report_field_value(body, &r.fields[kbd_key0]), 0x04);
+
+    /* Report 2: ID 0x02, one bit set -> decoded against ITS layout. */
+    const uint8_t rep2[] = { 0x02, 0x01 };
+    body = hid_report_body(&r, rep2, sizeof(rep2), &body_len, &id);
+    CHECK(body != NULL);
+    CHECK_EQ(id, 2);
+    CHECK_EQ(body_len, 1);
+    int consumer = -1;
+    for (uint8_t i = 0; i < r.field_count; i++)
+        if (r.fields[i].report_id == 2) { consumer = i; break; }
+    CHECK(consumer >= 0);
+    CHECK_EQ(hid_report_field_value(body, &r.fields[consumer]), 1);
+}
+
+static void test_negative_unknown_report_id(void) {
+    hid_report_t r;
+    uint32_t body_len = 123;
+    uint8_t id = 99;
+    CHECK_EQ(hid_report_parse(&r, desc_two_ids, sizeof(desc_two_ids)), 0);
+    /* Report ID 7 was never declared: refused, and the outputs are cleared. */
+    const uint8_t rep[] = { 0x07, 0xFF, 0xFF };
+    CHECK(hid_report_body(&r, rep, sizeof(rep), &body_len, &id) == NULL);
+    CHECK_EQ(body_len, 0);
+    CHECK_EQ(id, 0);
+    /* An ID byte with no body is not a report either. */
+    const uint8_t bare[] = { 0x01 };
+    CHECK(hid_report_body(&r, bare, sizeof(bare), &body_len, &id) == NULL);
+    CHECK_EQ(hid_report_has_id(&r, 7), 0);
+    CHECK_EQ(hid_report_has_id(&r, 1), 1);
+}
+
+static void test_negative_truncated(void) {
+    hid_report_t r;
+    /* Cut the descriptor in the middle of the last Input item's payload:
+     * the parser must stop cleanly, keep what it understood, and not read
+     * past the buffer (ASan is on for this binary). */
+    uint8_t truncated[sizeof(desc_boot_kbd)];
+    memcpy(truncated, desc_boot_kbd, sizeof(truncated));
+    uint16_t len = (uint16_t)(sizeof(truncated) - 1);
+    int rc = hid_report_parse(&r, truncated, len);
+    CHECK_EQ(rc, 0);                 /* what was complete still counts */
+    CHECK(r.field_count > 0);
+    /* A descriptor cut down to its first item parses to nothing usable. */
+    CHECK_EQ(hid_report_parse(&r, desc_boot_kbd, 2), -1);
+}
+
+static void test_negative_nothing_interpretable(void) {
+    hid_report_t r;
+    CHECK_EQ(hid_report_parse(&r, desc_padding_only, sizeof(desc_padding_only)), -1);
+    CHECK_EQ(r.field_count, 0);
+    /* Empty input is refused rather than "parsed". */
+    CHECK_EQ(hid_report_parse(&r, desc_padding_only, 0), -1);
+}
+
+static void test_no_report_id_body_is_whole_report(void) {
+    hid_report_t r;
+    uint32_t body_len = 0;
+    uint8_t id = 77;
+    CHECK_EQ(hid_report_parse(&r, desc_boot_kbd, sizeof(desc_boot_kbd)), 0);
+    const uint8_t rep[8] = { 0x02, 0x00, 0x04, 0, 0, 0, 0, 0 };
+    const uint8_t *body = hid_report_body(&r, rep, sizeof(rep), &body_len, &id);
+    CHECK(body == rep);              /* no prefix to strip */
+    CHECK_EQ(body_len, 8);
+    CHECK_EQ(id, 0);
+}
+
+
+/* A Report ID is shared by input, output and feature reports, but the lengths
+ * are separate.  QEMU's usb-kbd is exactly this shape: 8 input bytes plus an
+ * LED output report, both under ID 1, on a 9-byte interrupt packet.  If the
+ * output bits were folded into the input length the driver would ask the
+ * endpoint for 10 bytes and the short-packet accounting would be wrong. */
+static void case_output_shares_id(void) {
+    static const uint8_t d[] = {
+        0x05, 0x01,        /* Usage Page (Generic) */
+        0x09, 0x06,        /* Usage (Keyboard) */
+        0xA1, 0x01,        /* Collection (Application) */
+        0x85, 0x01,        /*   Report ID (1) */
+        0x05, 0x07,        /*   Usage Page (Keyboard) */
+        0x19, 0xE0, 0x29, 0xE7,   /* Usage Min/Max (modifiers) */
+        0x15, 0x00, 0x25, 0x01,   /* Logical Min/Max */
+        0x75, 0x01, 0x95, 0x08,   /* Report Size 1, Count 8 */
+        0x81, 0x02,               /*   Input (Data,Var,Abs) */
+        0x75, 0x08, 0x95, 0x01,   /* Report Size 8, Count 1 */
+        0x81, 0x03,               /*   Input (Const) -- QEMU's reserved byte */
+        0x75, 0x08, 0x95, 0x06,   /* Report Size 8, Count 6 */
+        0x15, 0x00, 0x26, 0xFF, 0x00,
+        0x19, 0x00, 0x2A, 0xFF, 0x00,
+        0x81, 0x00,               /*   Input (Data,Array) */
+        0x05, 0x08,               /*   Usage Page (LEDs) */
+        0x19, 0x01, 0x29, 0x05,
+        0x75, 0x01, 0x95, 0x05,   /* Report Size 1, Count 5 */
+        0x91, 0x02,               /*   Output (Data,Var,Abs) */
+        0x75, 0x03, 0x95, 0x01,   /* Report Size 3, Count 1 (pad) */
+        0x91, 0x03,               /*   Output (Const) */
+        0xC0,                     /* End Collection */
+    };
+    hid_report_t r;
+    CHECK_EQ(hid_report_parse(&r, d, sizeof(d)), 0);
+    CHECK_EQ(r.report_id_count, 1);
+    CHECK_EQ(r.report_ids[0], 1);
+    CHECK_EQ(r.report_bits_max, 64);          /* 8 mods + 48 key bits */
+    CHECK_EQ(hid_report_wire_len(&r), 9);     /* 8 body bytes + the ID byte */
+}
+
+int main(void) {
+    printf("=== AuraLite OS HID report-descriptor unit tests ===\n\n");
+    RUN(test_boot_keyboard);
+    RUN(test_two_report_ids);
+    RUN(test_body_split);
+    RUN(test_negative_unknown_report_id);
+    RUN(test_negative_truncated);
+    RUN(test_negative_nothing_interpretable);
+    RUN(test_no_report_id_body_is_whole_report);
+    RUN(case_output_shares_id);
+
+    printf("\n=== Results: %d/%d passed, %d failed ===\n", passed, tn, failed);
+    return failed == 0 ? 0 : 1;
+}
diff --git a/tests/unit/test_usb_hid_report_negcontrol.sh b/tests/unit/test_usb_hid_report_negcontrol.sh
new file mode 100755
index 0000000..8b4f15f
--- /dev/null
+++ b/tests/unit/test_usb_hid_report_negcontrol.sh
@@ -0,0 +1,74 @@
+#!/usr/bin/env bash
+# test_usb_hid_report_negcontrol.sh — RESIDUE3 C5b: does the new host test
+# actually DISCRIMINATE?
+#
+# The plan's definition of done for C5b was "a HID case that fails against
+# today's parser and passes after".  The old parser no longer exists in the
+# tree, so it is reconstructed here, mechanically: drivers/usb/hid_report.c is
+# copied into a scratch file and the two report-ID behaviours are reverted to
+# the shape hid.c had before C5b --
+#
+#   * on a Report ID item the bit cursor keeps going (one cursor for the whole
+#     descriptor instead of one per report), and
+#   * the report-ID bookkeeping still records each ID, but the per-report body
+#     length is therefore wrong, so wire_len and every field offset after the
+#     first report are wrong as well.
+#
+# Then the SAME test file is compiled against the old-shape parser.  If the
+# test still passed, it would be measuring nothing; the expected result is a
+# failure, and this script fails if that failure does not happen.
+#
+# Usage: tests/unit/test_usb_hid_report_negcontrol.sh   (exit 0 = control held)
+
+set -u
+cd "$(dirname "$0")/../.."
+ROOT=$PWD
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+
+cp drivers/usb/hid_report.h "$TMP/"
+python3 - "$TMP" <<'PY'
+import sys, pathlib
+tmp = pathlib.Path(sys.argv[1])
+src = (tmp.parent / "x") # unused
+s = open("drivers/usb/hid_report.c").read()
+old = """            case 0x8: { /* Report ID: a new report starts here */
+                /* Persist the size of the report we are leaving. */
+                if (cur_slot >= 0) r->report_bits[cur_slot] = bitpos;
+                cur_id = (uint8_t)uval;
+                r->has_report_id = 1;
+                cur_slot = report_slot(r, cur_id);
+                bitpos = (cur_slot >= 0) ? r->report_bits[cur_slot] : 0;
+                break;
+            }"""
+new = """            case 0x8: { /* OLD BEHAVIOUR: one shared bit cursor */
+                cur_id = (uint8_t)uval;
+                r->has_report_id = 1;
+                cur_slot = report_slot(r, cur_id);
+                break;
+            }"""
+if old not in s:
+    raise SystemExit("negative control is stale: the Report ID branch changed")
+s = s.replace(old, new, 1)
+(tmp / "hid_report_old.c").write_text(s)
+PY
+
+cc -std=c11 -Wall -Wextra -Werror -O1 -I "$TMP" -I "$ROOT" \
+    tests/unit/test_usb_hid_report.c "$TMP/hid_report_old.c" -o "$TMP/t_old" || {
+    echo "negcontrol: FAIL (old-shape parser did not compile)"; exit 1; }
+
+set +e
+OUT=$("$TMP/t_old" 2>&1)
+RC=$?
+set -e
+echo "$OUT" | tail -8
+
+FAILS=$(echo "$OUT" | grep -c "FAIL L" || true)
+if [ "$RC" -eq 0 ] || [ "${FAILS:-0}" -lt 3 ]; then
+    echo
+    echo "negcontrol: FAIL — the host test passes against the pre-C5b parser"
+    echo "            (rc=$RC, $FAILS failing checks). The test does not discriminate."
+    exit 1
+fi
+echo
+echo "negcontrol: PASS — the pre-C5b parser fails $FAILS check(s) in the same test"
diff --git a/tests/unit/test_usb_msc_csw.c b/tests/unit/test_usb_msc_csw.c
new file mode 100644
index 0000000..1139ac9
--- /dev/null
+++ b/tests/unit/test_usb_msc_csw.c
@@ -0,0 +1,168 @@
+/*
+ * test_usb_msc_csw.c — RESIDUE3 C5b: the USB BOT command-status wrapper.
+ *
+ * drivers/usb/msc_csw.c is compiled UNMODIFIED and driven with byte arrays.
+ * The cases are the ones a working QEMU storage device never produces: a
+ * truncated wrapper, an over-long one, a stale tag, and the two status codes
+ * BOT defines (failed = 1, phase error = 2).
+ *
+ * The first case is the bug this pins: before C5 the driver checked the
+ * signature of a zeroed struct after a short read, so 4 bytes of nothing
+ * produced "bad CSW signature 0x0" -- a message about the wrong layer.
+ */
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "drivers/usb/msc_csw.h"
+
+static int passed = 0, failed = 0, tn = 0;
+#define RUN(f) do { int b = failed; f(); tn++; if (failed == b) passed++; } while (0)
+#define CHECK(c) do { if (!(c)) { printf("  FAIL L%d: %s\n", __LINE__, #c); failed++; } } while (0)
+#define CHECK_EQ(a,e) do { long _a=(long)(a), _e=(long)(e); if (_a!=_e) { \
+    printf("  FAIL L%d: %s = %ld, want %ld\n", __LINE__, #a, _a, _e); failed++; } } while (0)
+
+#define TAG 0x11223344u
+
+/* A well-formed CSW: "USBS", tag, residue, status. */
+static void build_csw(uint8_t *b, uint32_t sig, uint32_t tag, uint32_t res, uint8_t st) {
+    b[0] = (uint8_t)(sig);       b[1] = (uint8_t)(sig >> 8);
+    b[2] = (uint8_t)(sig >> 16); b[3] = (uint8_t)(sig >> 24);
+    b[4] = (uint8_t)(tag);       b[5] = (uint8_t)(tag >> 8);
+    b[6] = (uint8_t)(tag >> 16); b[7] = (uint8_t)(tag >> 24);
+    b[8] = (uint8_t)(res);       b[9] = (uint8_t)(res >> 8);
+    b[10] = (uint8_t)(res >> 16); b[11] = (uint8_t)(res >> 24);
+    b[12] = st;
+}
+
+static void test_good_csw(void) {
+    uint8_t b[MSC_CSW_LEN];
+    build_csw(b, MSC_CSW_SIGNATURE, TAG, 0, 0);
+    msc_csw_check_t c;
+    msc_csw_validate(b, (int)sizeof(b), TAG, &c);
+    CHECK_EQ(c.result, MSC_CSW_OK);
+    CHECK_EQ(c.signature, 0x53425355u);
+    CHECK_EQ(c.tag, TAG);
+    CHECK_EQ(c.residue, 0);
+    CHECK_EQ(c.status, 0);
+    CHECK(strcmp(msc_csw_result_name(c.result), "ok") == 0);
+}
+
+/* The C5b case: 4 bytes.  Must be SHORT, not a signature complaint, and no
+ * field may be decoded from a buffer that was not fully received. */
+static void test_short_csw_is_not_a_signature_error(void) {
+    uint8_t b[4] = { 0x55, 0x53, 0x42, 0x53 };   /* "USBS" and nothing else */
+    msc_csw_check_t c;
+    msc_csw_validate(b, 4, TAG, &c);
+    CHECK_EQ(c.result, MSC_CSW_SHORT);
+    CHECK_EQ(c.signature, 0);
+    CHECK_EQ(c.tag, 0);
+    CHECK_EQ(c.residue, 0);
+    CHECK(strstr(msc_csw_result_name(c.result), "short") != NULL);
+}
+
+/* One byte short of a wrapper: still short, still zero fields. */
+static void test_twelve_bytes(void) {
+    uint8_t b[MSC_CSW_LEN];
+    build_csw(b, MSC_CSW_SIGNATURE, TAG, 0, 0);
+    for (int n = 1; n < (int)MSC_CSW_LEN; n++) {
+        msc_csw_check_t c;
+        msc_csw_validate(b, n, TAG, &c);
+        CHECK_EQ(c.result, MSC_CSW_SHORT);
+    }
+}
+
+/* One byte too many is its own error: the phases disagree. */
+static void test_over_long_csw(void) {
+    uint8_t b[MSC_CSW_LEN + 1];
+    build_csw(b, MSC_CSW_SIGNATURE, TAG, 0, 0);
+    b[MSC_CSW_LEN] = 0xAA;
+    msc_csw_check_t c;
+    msc_csw_validate(b, MSC_CSW_LEN + 1, TAG, &c);
+    CHECK_EQ(c.result, MSC_CSW_LONG);
+    CHECK(strstr(msc_csw_result_name(c.result), "over-long") != NULL);
+}
+
+static void test_bad_signature(void) {
+    uint8_t b[MSC_CSW_LEN];
+    build_csw(b, 0xDEADBEEF, TAG, 0, 0);
+    msc_csw_check_t c;
+    msc_csw_validate(b, (int)sizeof(b), TAG, &c);
+    CHECK_EQ(c.result, MSC_CSW_BAD_SIGNATURE);
+    CHECK_EQ(c.signature, 0xDEADBEEFu);
+}
+
+static void test_stale_tag(void) {
+    uint8_t b[MSC_CSW_LEN];
+    build_csw(b, MSC_CSW_SIGNATURE, TAG + 1, 0, 0);
+    msc_csw_check_t c;
+    msc_csw_validate(b, (int)sizeof(b), TAG, &c);
+    CHECK_EQ(c.result, MSC_CSW_BAD_TAG);
+    CHECK_EQ(c.tag, TAG + 1);
+}
+
+/* Both failure statuses, with the residue the device reported preserved so the
+ * log can say how many bytes never made it. */
+static void test_failed_status_keeps_residue(void) {
+    uint8_t b[MSC_CSW_LEN];
+    build_csw(b, MSC_CSW_SIGNATURE, TAG, 512, 1);
+    msc_csw_check_t c;
+    msc_csw_validate(b, (int)sizeof(b), TAG, &c);
+    CHECK_EQ(c.result, MSC_CSW_BAD_STATUS);
+    CHECK_EQ(c.status, 1);
+    CHECK_EQ(c.residue, 512);
+}
+
+static void test_phase_error_status(void) {
+    uint8_t b[MSC_CSW_LEN];
+    build_csw(b, MSC_CSW_SIGNATURE, TAG, 0, 2);
+    msc_csw_check_t c;
+    msc_csw_validate(b, (int)sizeof(b), TAG, &c);
+    CHECK_EQ(c.result, MSC_CSW_BAD_STATUS);
+    CHECK_EQ(c.status, 2);
+}
+
+/* Nothing at all: a failed transfer, reported as short, not as garbage. */
+static void test_null_and_zero(void) {
+    msc_csw_check_t c;
+    msc_csw_validate(NULL, 13, TAG, &c);
+    CHECK_EQ(c.result, MSC_CSW_SHORT);
+    uint8_t b[MSC_CSW_LEN];
+    memset(b, 07, sizeof(b));
+    msc_csw_validate(b, 0, TAG, &c);
+    CHECK_EQ(c.result, MSC_CSW_SHORT);
+    msc_csw_validate(b, -5, TAG, &c);
+    CHECK_EQ(c.result, MSC_CSW_SHORT);
+    msc_csw_validate(b, (int)sizeof(b), TAG, NULL);   /* must not fault */
+}
+
+/* Every result name is distinct and non-empty: the log lines are asserted by
+ * pattern in the integration cases, so two names that collapsed would make a
+ * grep for one match the other. */
+static void test_result_names_distinct(void) {
+    msc_csw_result_t all[] = { MSC_CSW_OK, MSC_CSW_SHORT, MSC_CSW_LONG,
+                               MSC_CSW_BAD_SIGNATURE, MSC_CSW_BAD_TAG, MSC_CSW_BAD_STATUS };
+    for (unsigned i = 0; i < sizeof(all) / sizeof(all[0]); i++) {
+        const char *a = msc_csw_result_name(all[i]);
+        CHECK(a && *a);
+        for (unsigned j = i + 1; j < sizeof(all) / sizeof(all[0]); j++)
+            CHECK(strcmp(a, msc_csw_result_name(all[j])) != 0);
+    }
+}
+
+int main(void) {
+    printf("=== AuraLite OS USB MSC command-status-wrapper tests ===\n");
+    RUN(test_good_csw);
+    RUN(test_short_csw_is_not_a_signature_error);
+    RUN(test_twelve_bytes);
+    RUN(test_over_long_csw);
+    RUN(test_bad_signature);
+    RUN(test_stale_tag);
+    RUN(test_failed_status_keeps_residue);
+    RUN(test_phase_error_status);
+    RUN(test_null_and_zero);
+    RUN(test_result_names_distinct);
+    printf("\n=== Results: %d/%d passed, %d failed ===\n", passed, tn, failed);
+    return failed ? 1 : 0;
+}
