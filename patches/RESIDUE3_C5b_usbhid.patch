     for (int p = 0; p < XHCI_MAX_PORTS && found < USB_MAX_DEVICES; p++) {
diff --git a/tests/integration/cases/test_usb_ehci_split.sh b/tests/integration/cases/test_usb_ehci_split.sh
new file mode 100755
index 0000000..43029bf
--- /dev/null
+++ b/tests/integration/cases/test_usb_ehci_split.sh
@@ -0,0 +1,106 @@
+#!/usr/bin/env bash
+# test_usb_ehci_split.sh — RESIDUE3 C5b: EHCI split transactions, and the
+# measurement that says why the split branch has no device case.
+#
+# WHAT C5b FOUND
+#
+# The EHCI periodic path built its queue head with two shortcuts:
+#   - port speed was a stub that returned "high-speed" for every port, so a
+#     full-speed device on a high-speed root port was enumerated as high-speed
+#     (`enumerate_device(USB_CTRL_EHCI, p, USB_SPEED_HIGH)` in usb_core.c) and
+#     its QH said eps=high-speed;
+#   - the split fields were computed inline, and the C-mask for a start in
+#     micro-frame 7 came out empty, so that endpoint would never complete.
+#
+# Both are fixed: the port's PORTSC.PSPD is decoded, the speed travels into
+# enumeration and into the QH, and the capability words are built by
+# drivers/usb/ehci_qh.c, which tests/unit/test_usb_ehci_qh.c pins bit by bit
+# (including all eight start micro-frames).
+#
+# WHY THERE IS NO "TT DEVICE" CASE
+#
+# The plan asked for an FS/LS device behind a high-speed hub on EHCI.  QEMU
+# cannot express that: its only hub is `usb-hub`, a full-speed device, and QEMU
+# refuses to attach it to a high-speed bus.  Case 2 asserts that refusal
+# directly, so the gap is a measured property of the emulator rather than a
+# case that was quietly dropped.  What CAN be measured on QEMU is the branch
+# that matters for the machine in front of you: a full-speed device on an EHCI
+# root port, which must be full-speed with no split (a split without a TT
+# address would be a lie to the controller).
+
+set -u
+cd "$(dirname "$0")/.."
+. lib/lib.sh
+il_init
+il_have qemu-system-x86_64
+
+il_section "EHCI: port speed, split decision, and the TT gap (RESIDUE3 C5b)"
+
+run_case() {
+    local label="$1"; shift
+    local log="$IL_LOGDIR/ehci_split_${label}.log"
+    rm -f "$log"
+    IL_LAST_LOG="$log"
+    set +e
+    timeout --foreground 75 "$IL_QEMU" \
+        -drive "file=$IL_ISO,format=raw,if=ide,snapshot=on" \
+        -m 512M -smp 2 -display none \
+        -serial "file:$log" \
+        -no-reboot -cpu qemu64 -boot order=c \
+        "$@" >/dev/null 2>&1
+    set -e
+    echo "$log"
+}
+
+# --- Case 1: full-speed keyboard on an EHCI root port ---------------------
+ELOG=$(run_case fsport -device usb-ehci,id=e -device usb-kbd,bus=e.0)
+IL_LAST_LOG="$ELOG"
+
+il_assert_grep "$ELOG" "\[ehci\] port 0: full-speed device \(PSPD=0\)" \
+    "EHCI: PORTSC.PSPD is decoded, not assumed (a full-speed device is not high-speed)"
+il_assert_grep "$ELOG" "\[usb\] device at addr .: .* speed=full \(12 Mbps\)" \
+    "EHCI: the port's speed reaches enumeration (used to be hardcoded high-speed)"
+il_assert_grep "$ELOG" "\[ehci\] interrupt endpoint 0x81 dev=. on periodic schedule .*eps=0, split=no" \
+    "EHCI: queue head carries eps=full and no split (no TT on a root port)"
+il_assert_grep "$ELOG" "S-mask=0x01 C-mask=0x00" \
+    "EHCI: S-mask set for the periodic schedule, C-mask empty without a TT"
+il_assert_no_grep "$ELOG" "\[ehci\]   TT:" \
+    "EHCI: no TT receipt is printed for a root-port device"
+# Delivery itself is asserted by test_usb_hid_input.sh case 3, which injects
+# keystrokes; QEMU's keyboard sends nothing on its own, so asserting on a
+# report line here would pass only by accident.  What belongs here is that the
+# corrected queue head does not break the poll: no qTD errors, no timeouts.
+il_assert_no_grep "$ELOG" "interrupt qTD error|async qTD timeout" \
+    "EHCI: the corrected queue head does not error out on every poll"
+il_assert_grep "$ELOG" "\[hid\] PASS: 1 USB HID input device\(s\) active" \
+    "EHCI: the keyboard stays bound after the speed correction"
+il_assert_no_grep "$ELOG" "PANIC|Page Fault" \
+    "EHCI: no faults on the periodic path"
+
+# --- Case 2: QEMU refuses to build the TT topology ------------------------
+# This is the receipt for the missing device case: a full-speed hub cannot sit
+# on a high-speed bus, so no FS/LS device can be placed behind a TT on EHCI.
+rm -f "$IL_LOGDIR/ehci_split_hub.log"
+set +e
+HUBOUT=$(timeout --foreground 20 "$IL_QEMU" \
+    -drive "file=$IL_ISO,format=raw,if=ide,snapshot=on" \
+    -m 512M -smp 2 -display none -serial null \
+    -no-reboot -cpu qemu64 -boot order=c \
+    -device usb-ehci,id=e -device usb-hub,bus=e.0,port=1 \
+    -device usb-kbd,bus=e.0,port=1.2 2>&1)
+HUBRC=$?
+set -e
+printf '%s\n' "$HUBOUT" > "$IL_LOGDIR/ehci_split_hub.log"
+
+IL_ASSERT_COUNT=$(( ${IL_ASSERT_COUNT:-0} + 1 ))
+if [ "$HUBRC" -ne 0 ]; then
+    il_pass "TT topology: QEMU exits rather than attach a full-speed hub to a high-speed bus"
+else
+    il_fail "TT topology: QEMU exits rather than attach a full-speed hub to a high-speed bus (rc=$HUBRC)"
+fi
+il_assert_grep "$IL_LOGDIR/ehci_split_hub.log" "speed mismatch trying to attach usb device .QEMU USB Hub. .full speed. to bus .e.0., port .1. .high speed." \
+    "TT topology: the refusal names the reason (full-speed hub, high-speed bus)"
+il_assert_grep "$IL_LOGDIR/ehci_split_hub.log" "usb-hub,bus=e.0,port=1" \
+    "TT topology: the command line that cannot be built is recorded verbatim"
+
+il_summary
diff --git a/tests/integration/cases/test_usb_hid_report_ids.sh b/tests/integration/cases/test_usb_hid_report_ids.sh
new file mode 100755
index 0000000..ea217e0
--- /dev/null
+++ b/tests/integration/cases/test_usb_hid_report_ids.sh
@@ -0,0 +1,105 @@
+#!/usr/bin/env bash
+# test_usb_hid_report_ids.sh — RESIDUE3 C5b: HID descriptors with report IDs.
+#
+# WHY THIS EXISTS
+#
+# The HID driver used to remember ONE report ID: the last `0x85` item in the
+# report descriptor.  Everything about the driver then assumed that ID: which
+# reports to accept, and where the report body starts.  A device that declares
+# two report IDs (a very ordinary thing — a keyboard that also sends consumer
+# volume keys under ID 2) parsed into a single blob, so report 1 was either
+# dropped (its ID did not match the remembered one) or, worse, decoded with
+# report 2's field layout.
+#
+# C5b splits the descriptor parser out into drivers/usb/hid_report.c, gives
+# every field its own report_id and its own bit origin, and keeps a per-report
+# body length.  Two independent checks cover that:
+#
+#   1. tests/unit/test_usb_hid_report.c — eight descriptors, host-compiled
+#      against the same translation unit the kernel links.
+#   2. the kernel-side selftest below — proves the *kernel build* reaches the
+#      same conclusions, including the two-ID split and per-report decoding.
+#
+# Why not a multi-ID *device*: none of QEMU's HID devices declare a Report ID
+# item at all.  That was measured, not assumed — dumping the descriptors sent
+# by usb-kbd, usb-tablet and usb-mouse shows zero 0x85 items (receipt in
+# docs/plans/RESIDUE3_PLAN.md, section C5b).  A device case here would have
+# tested the single-report path and called it multi-ID coverage.
+#
+# What the real devices ARE used for: the parsed input length must equal the
+# endpoint wMaxPacketSize, and that is asserted per device.  It also pins the
+# bug this phase found on its own: output-report bits folded into the input
+# length made QEMU's 9-byte keyboard look like an 8-byte packet with a reserved
+# byte and an LED report, i.e. it computed 10 bytes for a 9-byte endpoint.
+
+set -u
+cd "$(dirname "$0")/.."
+. lib/lib.sh
+il_init
+il_have qemu-system-x86_64
+
+il_section "HID report descriptors: report IDs, bodies, wire lengths (RESIDUE3 C5b)"
+
+run_case() {
+    # $1 = label, $2.. = qemu device arguments
+    local label="$1"; shift
+    local log="$IL_LOGDIR/hid_rid_${label}.log"
+    rm -f "$log"
+    IL_LAST_LOG="$log"
+    set +e
+    timeout --foreground 75 "$IL_QEMU" \
+        -drive "file=$IL_ISO,format=raw,if=ide,snapshot=on" \
+        -m 512M -smp 2 -display none \
+        -serial "file:$log" \
+        -no-reboot -cpu qemu64 -boot order=c \
+        "$@" >/dev/null 2>&1
+    set -e
+    echo "$log"
+}
+
+# --- Case 1: kernel-side selftest, no USB device needed -------------------
+# The selftest runs from usb_hid_init(), so it executes even on a machine with
+# no HID hardware.  That is deliberate: the multi-ID contract must hold on a
+# bare boot, not only when a particular device happens to be attached.
+SLOG=$(run_case selftest)
+IL_LAST_LOG="$SLOG"
+
+il_assert_grep "$SLOG" "\[hid\] selftest: two-ID descriptor -> ids=2 \(1,2\)" \
+    "selftest: one descriptor yields two report IDs, both remembered"
+il_assert_grep "$SLOG" "input bits: r1=64 r2=4 wire=9" \
+    "selftest: per-report body sizes (8 bytes under ID 1, 4 bits under ID 2) and one wire length"
+il_assert_grep "$SLOG" "\[hid\] selftest: QEMU-shaped keyboard -> report_id=none input bits=64 wire=8" \
+    "selftest: LED output report shares the ID but does NOT lengthen the input report"
+il_assert_grep "$SLOG" "\[hid\] selftest: PASS report-ID split and per-report decoding" \
+    "selftest: body split after the prefix, per-report decode, unknown ID rejected"
+il_assert_no_grep "$SLOG" "\[hid\] selftest: FAIL" \
+    "selftest: no failed check"
+
+# --- Case 2: three real devices, parsed length == endpoint packet size -----
+# kbd: 8 mods + 1 reserved + 6 keys = 64 bits = 8 bytes (endpoint 8).
+# tablet: 3 buttons + 5 pad + X 16 + Y 16 + wheel 8 = 48 bits = 6 bytes (6).
+# mouse: 5 buttons + 3 pad + X 8 + Y 8 + wheel 8 = 32 bits = 4 bytes (4).
+DLOG=$(run_case devices -device qemu-xhci,id=x \
+                            -device usb-kbd,bus=x.0 \
+                            -device usb-mouse,bus=x.0 \
+                            -device usb-tablet,bus=x.0)
+IL_LAST_LOG="$DLOG"
+
+il_assert_grep "$DLOG" "\[hid\] parsed generic keyboard report: fields=14 input_bits=64 report_id=none" \
+    "QEMU keyboard: 14 fields, 64 input bits (LED output bits excluded)"
+il_assert_grep "$DLOG" "\[hid\] parsed generic pointer report: fields=8 input_bits=32 report_id=none" \
+    "QEMU mouse: 8 fields, 32 input bits"
+il_assert_grep "$DLOG" "\[hid\] parsed generic pointer report: fields=6 input_bits=48 report_id=none" \
+    "QEMU tablet: 6 fields including the wheel, 48 input bits"
+il_assert_grep "$DLOG" "\[hid\] keyboard ready: addr=. iface=0 ep=0x81 poll_len=8 ep_maxpkt=8" \
+    "QEMU keyboard: polled length 8 exactly fills the 8-byte endpoint"
+il_assert_grep "$DLOG" "\[hid\] mouse ready: addr=. iface=0 ep=0x81 poll_len=4 ep_maxpkt=4" \
+    "QEMU mouse: polled length 4 exactly fills the 4-byte endpoint"
+il_assert_grep "$DLOG" "\[hid\] generic-mouse ready: addr=. iface=0 ep=0x81 poll_len=6 ep_maxpkt=8" \
+    "QEMU tablet: 6-byte descriptor inside an 8-byte endpoint (device over-allocates)"
+il_assert_no_grep "$DLOG" "\[hid\] note: addr .* descriptor wire length" \
+    "no descriptor asks for more input than one packet can carry"
+il_assert_grep "$DLOG" "\[hid\] PASS: 3 USB HID input device\(s\) active" \
+    "all three devices bound through the report-ID-aware parser"
+
+il_summary
