+        kprintf("[isoc] PASS: %u packet(s) streamed on %s ep 0x%02x "
+                "(%u B/packet, 440 Hz sine, %u frames of audio)\n",
+                packets,
+                (aud->dev->controller == USB_CTRL_XHCI) ? "xHCI" : "USB",
+                st->isoc_out_ep, pkt, (unsigned)(frames_per_pkt * packets));
