+                "empty bursts %u, timeouts %u, isoclock frame(s) elapsed %u%s\n",
+                sub, comp, over, under, tmo, xhci_isoc_last_frames(),
+                xhci_isoc_clock_live() ? "" : " (MFINDEX FROZEN)");
+    } else {
+        kprintf("[isoc] FAIL: stream did not complete (%d), %u/%u packet(s)\n",
+                r, packets, npkts);
+    }
+    return packets;
+}
