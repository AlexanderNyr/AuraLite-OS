+ * extern declaration rather than an include of an arch header (the width
+ * sweep's ratchet counts direct x86_64 includes from portable code, and it is
+ * right to).  kernel/kernel.c does the same for the other probes. */
+extern int fwcfg_read_opt(const char *wanted, char *out, int out_max);
+
+/* 10.0.2.2 — SLIRP's host alias, the same peer net_self_test() pings. */
+#define LANE_HOST_V4 0x0A000202u
+
+static uint8_t lane_buf[LANE_CHUNK];
+
+static int lane_once(const char *name, uint16_t port, int expect_scaled) {
+    kprintf("[tcp] wscale lane (%s): connecting to 10.0.2.2:%u for %u bytes\n",
+            name, (unsigned)port, (unsigned)LANE_BYTES);
+
+    tcp_handle_t h = tcp_open(LANE_HOST_V4, port);
+    if (h < 0) {
+        kprintf("[tcp] wscale lane (%s): connect failed (%d)\n", name, h);
+        return -1;
+    }
+    if (tcp_state_h(h) != TCP_ESTABLISHED) {
+        kprintf("[tcp] wscale lane (%s): handshake did not complete (state %d)\n",
+                name, (int)tcp_state_h(h));
+        tcp_close_h(h);
+        return -1;
+    }
+
+    uint8_t shift = tcp_snd_shift_h(h);
+    uint32_t wnd = tcp_snd_wnd_h(h);
+    kprintf("[tcp] wscale lane (%s): ESTABLISHED, peer shift %u, snd_wnd %u\n",
+            name, (unsigned)shift, wnd);
+
+    memset(lane_buf, 'A', sizeof(lane_buf));
+    uint64_t t0 = timer_get_ticks();
+    uint32_t sent = 0;
+    while (sent < LANE_BYTES) {
+        uint32_t chunk = LANE_BYTES - sent;
+        if (chunk > LANE_CHUNK) chunk = LANE_CHUNK;
+        int rc = tcp_send_h(h, lane_buf, chunk);
+        if (rc <= 0) {
+            kprintf("[tcp] wscale lane (%s): send failed at %u bytes (%d)\n",
+                    name, sent, rc);
+            tcp_close_h(h);
+            return -1;
+        }
+        sent += (uint32_t)rc;
+    }
+    uint64_t t1 = timer_get_ticks();
+    uint32_t peak = tcp_inflight_peak_h(h);
+    uint32_t ms = (uint32_t)((t1 - t0) * (1000u / 100u));   /* PIT is 100 Hz */
+
+    kprintf("[tcp] wscale lane (%s): sent %u bytes in %u ms, "
+            "peak in-flight %u bytes, peer window %u (shift %u)\n",
+            name, sent, ms, peak, tcp_snd_wnd_h(h), (unsigned)shift);
+
+    int ok = 1;
+    if (expect_scaled) {
+        /* The whole point: more than a 16-bit window can express was in
+         * flight, so the peer's advertised window was genuinely scaled. */
+        if (peak > LANE_16BIT)
+            kprintf("[tcp] wscale lane (%s): PASS %u bytes were in flight at "
+                    "once — above the %u-byte unscaled ceiling\n",
+                    name, peak, LANE_16BIT);
+        else {
+            kprintf("[tcp] wscale lane (%s): FAIL peak in-flight %u never "
+                    "cleared the %u-byte unscaled ceiling\n",
+                    name, peak, LANE_16BIT);
+            ok = 0;
+        }
+    } else {
+        /* Negative control: clamped peer, so nothing above 16 bits may
+         * appear.  If it does, the BIG result is an artefact. */
+        if (peak <= LANE_16BIT)
+            kprintf("[tcp] wscale lane (%s): PASS peak in-flight %u stayed "
+                    "inside the %u-byte window the peer actually granted\n",
+                    name, peak, LANE_16BIT);
+        else {
+            kprintf("[tcp] wscale lane (%s): FAIL peak in-flight %u exceeds "
+                    "the %u-byte window the peer granted — the guest is "
+                    "inventing window\n", name, peak, LANE_16BIT);
+            ok = 0;
+        }
+    }
+
+    tcp_close_h(h);
+    return ok ? 0 : -1;
+}
+
+int tcp_ws_lane_run(uint16_t big_port, uint16_t clamp_port) {
+    uint64_t t0 = timer_get_ticks();
+    int a = lane_once("big", big_port, 1);
+    int b = lane_once("clamped", clamp_port, 0);
+    uint32_t ms = (uint32_t)((timer_get_ticks() - t0) * (1000u / 100u));
+
+    if (a == 0 && b == 0) {
+        kprintf("[tcp] wscale lane: PASS 1 MiB over a scaled window, and a "
+                "clamped peer held the same transfer inside 16 bits (%u ms "
+                "total)\n", ms);
+        return 0;
+    }
+    kprintf("[tcp] wscale lane: FAIL (big=%d clamped=%d)\n", a, b);
+    return -1;
+}
+
+/* Read `opt/auralite.tcp_ws` = "<big>,<clamped>" and run the lane.  Absent
+ * (or unparseable) means the lane does not run and prints nothing: a boot
+ * that was not asked for this measurement must not pretend to have made it. */
+void tcp_ws_lane_boot_probe(void) {
+    char val[32];
+    if (!fwcfg_read_opt("opt/auralite.tcp_ws", val, (int)sizeof(val))) return;
+
+    uint16_t ports[2] = { 0, 0 };
+    int n = 0;
+    const char *p = val;
+    while (*p && n < 2) {
+        uint32_t v = 0;
+        while (*p >= '0' && *p <= '9') { v = v * 10u + (uint32_t)(*p - '0'); p++; }
+        if (v == 0 || v > 65535u) return;         /* refuse, do not guess */
+        ports[n++] = (uint16_t)v;
+        if (*p == ',' || *p == ' ' || *p == ':') p++;
+        else break;
+    }
+    if (n != 2) {
+        kprintf("[tcp] wscale lane: fw_cfg opt/auralite.tcp_ws=%s is not "
+                "big,clamped; lane not run\n", val);
+        return;
+    }
+    kprintf("[tcp] wscale lane: asked for by fw_cfg (%s)\n", val);
+    tcp_ws_lane_run(ports[0], ports[1]);
+}
diff --git a/kernel/net/tcp_ws_lane.h b/kernel/net/tcp_ws_lane.h
new file mode 100644
index 0000000..cb04740
--- /dev/null
+++ b/kernel/net/tcp_ws_lane.h
@@ -0,0 +1,34 @@
+#ifndef AURALITE_NET_TCP_WS_LANE_H
+#define AURALITE_NET_TCP_WS_LANE_H
+
+#include <stdint.h>
+
+/*
+ * The 1 MiB window-scaling lane (RESIDUE3 C7).
+ *
+ * WHY A BOOT LANE AND NOT A UNIT TEST.  test_tcp_wscale.c pins the arithmetic
+ * of kernel/net/tcp_wscale.h, and that is necessary but not sufficient: it
+ * cannot show that tcp.c actually carries a scaled window to a peer, nor that
+ * the send scheduler spends it.  This lane moves a megabyte across a real TCP
+ * connection to a host peer and prints what the connection did.
+ *
+ * WHY THE PORT COMES FROM fw_cfg.  A lane that always runs would slow every
+ * boot and fail noisily whenever no peer is listening, and a lane that runs
+ * "when it feels like it" is a silent gap.  The harness that wants this
+ * measurement says so on the QEMU command line:
+ *
+ *     -fw_cfg name=opt/auralite.tcp_ws,string=18099,18100
+ *
+ * two ports: the open lane and its negative control (a peer whose window is
+ * clamped to 16 bits, so it can never grant more than 65535).  Absent the
+ * option, the lane does not run and prints nothing at all.
+ */
+
+/* Returns 0 when both lanes behaved as their configuration demands, -1
+ * otherwise.  Never called unless fw_cfg named the ports. */
+int tcp_ws_lane_run(uint16_t big_port, uint16_t clamp_port);
+
+/* fw_cfg probe: reads opt/auralite.tcp_ws and runs the lane when present. */
+void tcp_ws_lane_boot_probe(void);
+
+#endif /* AURALITE_NET_TCP_WS_LANE_H */
diff --git a/kernel/net/tcp_wscale.h b/kernel/net/tcp_wscale.h
new file mode 100644
index 0000000..eda3369
--- /dev/null
+++ b/kernel/net/tcp_wscale.h
@@ -0,0 +1,157 @@
+#ifndef AURALITE_NET_TCP_WSCALE_H
+#define AURALITE_NET_TCP_WSCALE_H
+
+#include <stdint.h>
+
+/*
+ * TCP window scaling (RFC 7323 s2.2 / s2.3) — RESIDUE3 C7.
+ *
+ * The 16-bit window field caps a connection at 65535 bytes in flight.  With
+ * a 200 ms path that is 65535 * 8 / 0.2 = 2.6 Mbit/s no matter how fast the
+ * link is, which is why every modern stack negotiates a shift count in the
+ * handshake: both sides then read the window field as "field << shift".
+ *
+ * This header is pure: no kernel state, no I/O.  tcp.c applies the results,
+ * and tests/unit/test_tcp_wscale.c pins them, including the malformed cases
+ * a parser on network bytes has to survive.
+ *
+ * THE RULE THAT MATTERS MOST: the shift is offered in the SYN and answered in
+ * the SYN-ACK, and it is NEVER negotiated again for that connection.  A
+ * window field arriving on a later segment with a peer that never offered a
+ * shift must be read unscaled — scaling it would invent a window the peer
+ * never granted.
+ */
+
+/* RFC 7323: the shift count is 14 bits at most.  A peer that sends more is
+ * misbehaving; clamping keeps every shift computation in range. */
+#define TCP_WS_SHIFT_MAX 14u
+
+#define TCP_WS_KIND      3u   /* option kind */
+#define TCP_WS_OPT_LEN   3u   /* kind, length, shift */
+
+/* What a peer's option block said about window scaling. */
+typedef struct {
+    uint8_t offered;   /* 1 = the peer put a WSCALE option in its SYN */
+    uint8_t shift;     /* the shift it asked us to use (already clamped) */
+} tcp_ws_opt_t;
+
+static inline void tcp_ws_opt_init(tcp_ws_opt_t *o) {
+    o->offered = 0;
+    o->shift = 0;
+}
+
+/*
+ * Walk a TCP option block and report the window-scale option.
+ *
+ * Returns 0 if the block was well-formed (even when no WSCALE was found, in
+ * which case `out->offered` stays 0), -1 if it was malformed.  The caller
+ * uses whatever was found: a peer that fills the block with garbage still
+ * gets its window read unscaled, which is the safe reading.
+ *
+ * Every iteration consumes at least one byte.  That is not defensive
+ * decoration: a zero-length option is the classic way to spin a parser
+ * forever, and this runs before anything has been validated.
+ */
+static inline int tcp_ws_parse(const uint8_t *p, uint32_t len,
+                               tcp_ws_opt_t *out) {
+    tcp_ws_opt_init(out);
+    uint32_t i = 0;
+    int well_formed = 1;
+    while (i < len) {
+        uint8_t kind = p[i];
+        if (kind == 0u) break;                  /* End of option list */
+        if (kind == 1u) { i++; continue; }      /* NOP */
+        if (i + 1u >= len) { well_formed = 0; break; }
+        uint8_t olen = p[i + 1u];
+        if (olen < 2u) { well_formed = 0; i++; continue; }
+        if (i + olen > len) { well_formed = 0; break; }
+        if (kind == TCP_WS_KIND) {
+            if (olen == TCP_WS_OPT_LEN) {
+                uint8_t s = p[i + 2u];
+                if (s > TCP_WS_SHIFT_MAX) s = TCP_WS_SHIFT_MAX;
+                out->offered = 1;
+                out->shift = s;
+            } else {
+                /* Right kind, wrong length: not a scale we may act on. */
+                well_formed = 0;
+            }
+        }
+        i += olen;
+    }
+    return well_formed ? 0 : -1;
+}
+
+/*
+ * Write a WSCALE option into `buf`, padded to a 4-byte boundary with NOPs so
+ * the following options (and the header length) stay aligned.
+ *
+ * Returns the number of bytes written, or 0 when there is not enough room —
+ * in which case the caller must forget the option rather than emit a
+ * half-built one, because a truncated option block is worse than none.
+ */
+static inline uint32_t tcp_ws_emit(uint8_t *buf, uint32_t cap, uint8_t shift) {
+    if (shift > TCP_WS_SHIFT_MAX) shift = TCP_WS_SHIFT_MAX;
+    if (cap < 4u) return 0;
+    uint32_t i = 0;
+    buf[i++] = TCP_WS_KIND;
+    buf[i++] = TCP_WS_OPT_LEN;
+    buf[i++] = shift;
+    buf[i++] = 1u;                     /* NOP padding to the 4-byte boundary */
+    return i;
+}
+
+/* Window field -> real window: `field << shift`, saturating.  A shift of 0
+ * is the identity, which is exactly what an unscaled peer means. */
+static inline uint32_t tcp_ws_apply(uint32_t field, uint8_t shift) {
+    if (shift > TCP_WS_SHIFT_MAX) shift = TCP_WS_SHIFT_MAX;
+    if (shift == 0u) return field;
+    if (field > (0xFFFFFFFFu >> shift)) return 0xFFFFFFFFu;
+    return field << shift;
+}
+
+/* Real window -> the 16-bit field to put on the wire, for OUR advertised
+ * window: `wnd >> shift`, clamped to 65535. */
+static inline uint16_t tcp_ws_encode(uint32_t window, uint8_t shift) {
+    if (shift > TCP_WS_SHIFT_MAX) shift = TCP_WS_SHIFT_MAX;
+    uint32_t v = window >> shift;
+    if (v > 0xFFFFu) v = 0xFFFFu;
+    return (uint16_t)v;
+}
+
+/*
+ * The shift we may ask for, given a receive buffer of `buf_bytes`.
+ *
+ * This is not a tuning knob: it is the promise we make to the peer about how
+ * much unread data we can hold.  A buffer smaller than one window needs no
+ * shift (0), and every doubling of the buffer above 65535 buys one bit —
+ * flooring, never rounding up, because rounding up would advertise space
+ * that does not exist.
+ */
+static inline uint8_t tcp_ws_shift_for_buffer(uint32_t buf_bytes) {
+    uint8_t s = 0;
+    /* Largest shift whose maximum encodable window (65535 << s) still fits
+     * in the buffer: every value we could then advertise is one we can hold.
+     * Floor, never round up.
+     *
+     * 32-bit arithmetic on purpose: the largest candidate shift is 15, and
+     * 0xFFFF << 15 still fits a uint32_t, so no 64-bit widening is needed —
+     * and this tree ratchets widening casts in portable code, correctly. */
+    while (s < TCP_WS_SHIFT_MAX &&
+           (0xFFFFu << (uint32_t)(s + 1u)) <= buf_bytes)
+        s++;
+    return s;
+}
+
+/*
+ * Should we scale this connection at all?
+ *
+ * RFC 7323 s2.2: scaling is negotiated in the handshake and must not be
+ * applied unless the peer also offered it.  `we_offered` is what we put in
+ * our SYN/SYN-ACK; the peer's answer decides the shift we use for ITS window
+ * and for OURS.  Returns 1 when scaling is in force.
+ */
+static inline int tcp_ws_engaged(int we_offered, const tcp_ws_opt_t *peer) {
+    return we_offered && peer && peer->offered;
+}
+
+#endif /* AURALITE_NET_TCP_WSCALE_H */
diff --git a/tests/integration/cases/test_tcp_options.sh b/tests/integration/cases/test_tcp_options.sh
