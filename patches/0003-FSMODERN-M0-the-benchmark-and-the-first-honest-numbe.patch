++        const char *child;
++        if (root) {
++            child = (mp[0] == '/') ? mp + 1 : mp;
++        } else {
++            /* path + "/" prefix, then the remainder must be one component. */
++            if (strncmp(mp, path, plen) != 0) continue;
++            if (mp[plen] != '/') continue;
++            child = mp + plen + 1;
++        }
++        if (!*child) continue;
++        /* Direct child only: no further '/', and not "." or "..". */
++        {
++            int direct = 1;
++            for (const char *q = child; *q; q++) {
