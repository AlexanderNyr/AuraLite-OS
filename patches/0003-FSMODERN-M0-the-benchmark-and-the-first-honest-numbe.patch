++        copy_field(u->gecos, HOME_USER_DIR_MAX,   fields[4], flen[4])  != 0 ||
++        copy_field(u->dir,   HOME_USER_DIR_MAX,   fields[5], flen[5])  != 0 ||
++        copy_field(u->shell, HOME_USER_SHELL_MAX, fields[6], flen[6])  != 0) {
