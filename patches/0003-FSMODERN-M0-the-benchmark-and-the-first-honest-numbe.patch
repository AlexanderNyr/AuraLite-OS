++        if (users[i].in_use && users[i].uid == uid) return &users[i];
++    }
++    return NULL;
++}
++
++const struct home_user *home_user_by_name(const char *name) {
++    if (!name) return NULL;
++    for (int i = 0; i < user_count; i++) {
++        if (users[i].in_use && strcmp(users[i].name, name) == 0) {
++            return &users[i];
++        }
++    }
++    return NULL;
++}
