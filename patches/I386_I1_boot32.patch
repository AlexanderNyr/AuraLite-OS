diff --git a/boot/bios/stage2/elf32.inc b/boot/bios/stage2/elf32.inc
new file mode 100644
index 0000000..5f2b4c7
--- /dev/null
+++ b/boot/bios/stage2/elf32.inc
@@ -0,0 +1,188 @@
+; =============================================================================
+; boot/bios/stage2/elf32.inc -- ELF32 loader (real mode + unreal FS).
+;
+; Sibling of elf.inc (I386_PLAN I1).  Consumes an ELF32 image previously
+; staged at a flat linear address by fat_load, walks the 32-bit program
+; headers, and copies every PT_LOAD segment to its physical destination.
+;
+; Unlike the 64-bit kernel (linked higher-half, phys = p_paddr - VMA),
+; the i386 kernel/stub is linked with VMA = LMA = 0x00100000 -- paging
+; does not exist yet on this path, so p_paddr IS the destination and no
+; translation is needed.  That asymmetry is deliberate: the 32-bit
+; kernel enables paging itself in phase I3, exactly as the original
+; kernel did before the loader took the job over.
+;
+; ELF32 field offsets (System V ABI, Elf32_Ehdr / Elf32_Phdr):
+;   e_entry     @24 (4)      p_type   @ 0 (4)
+;   e_phoff     @28 (4)      p_offset @ 4 (4)
+;   e_phentsize @42 (2)      p_paddr  @12 (4)
+;   e_phnum     @44 (2)      p_filesz @16 (4)
+;                            p_memsz  @20 (4)
+;
+; Requires unreal mode (FS lifted to 4 GiB flat).
+;
+; Public entry
+; ------------
+;   elf32_load(EAX = image flat linear address)
+;       On success: CF=0, [elf32_entry_addr] = 4-byte kernel entry point.
+;       On failure: CF=1 (bad magic, or ELFCLASS != 1).
+; =============================================================================
+
+; Persistent state.
+elf32_entry_addr:     dd 0                 ; kernel32 _start physical address
+_elf32_image_base:    dd 0
+_elf32_phdr_off:      dd 0
+_elf32_phnum:         dd 0
+_elf32_phentsize:     dd 0
+
+ELFCLASS32            equ 1
+
+; ---------------------------------------------------------------------------
+; elf32_load(EAX = image flat address)
+; ---------------------------------------------------------------------------
+elf32_load:
+    push eax
+    push ebx
+    push ecx
+    push edx
+    push esi
+    push edi
+    push ebp
+
+    mov  [_elf32_image_base], eax
+    mov  esi, eax                         ; ESI = flat ptr to Ehdr
+
+    ; Magic: bytes 0..3 == { 0x7F, 'E', 'L', 'F' }.
+    mov  eax, [fs:esi]
+    cmp  eax, 0x464C457F
+    jne  .fail
+
+    ; ELFCLASS32 (byte at offset 4 == 1).  The 64-bit loader checks for
+    ; 2 here; each loader refuses the other's class so a mis-copied
+    ; kernel file fails loudly at parse time, not at jump time.
+    mov  al, [fs:esi + 4]
+    cmp  al, ELFCLASS32
+    jne  .fail
+
+    ; e_entry (4 bytes at offset 24).
+    mov  eax, [fs:esi + 24]
+    mov  [elf32_entry_addr], eax
+
+    ; e_phoff (4 bytes at offset 28).
+    mov  eax, [fs:esi + 28]
+    mov  [_elf32_phdr_off], eax
+
+    ; e_phentsize (u16 @42), e_phnum (u16 @44).
+    movzx eax, word [fs:esi + 42]
+    mov  [_elf32_phentsize], eax
+    movzx eax, word [fs:esi + 44]
+    mov  [_elf32_phnum], eax
+
+    ; Iterate program headers.
+    xor  ecx, ecx                         ; ECX = index
+.ph_loop:
+    cmp  ecx, [_elf32_phnum]
+    jae  .done
+
+    ; Flat address of this phdr: image_base + phoff + i*phentsize.
+    mov  eax, ecx
+    mul  dword [_elf32_phentsize]         ; EDX:EAX = i * phentsize
+    add  eax, [_elf32_phdr_off]
+    add  eax, [_elf32_image_base]
+    mov  edi, eax                         ; EDI = phdr flat addr
+
+    ; Skip non-PT_LOAD.  (PT_LOAD equ 1 comes from elf.inc, which is
+    ; always included alongside this file.)
+    mov  eax, [fs:edi + 0]                ; p_type
+    cmp  eax, PT_LOAD
+    jne  .next
+
+    push ecx
+    call _elf32_copy_segment              ; consumes EDI = phdr addr
+    pop  ecx
+
+.next:
+    inc  ecx
+    jmp  .ph_loop
+
+.done:
+    pop  ebp
+    pop  edi
+    pop  esi
+    pop  edx
+    pop  ecx
+    pop  ebx
+    pop  eax
+    clc
+    ret
+.fail:
+    pop  ebp
+    pop  edi
+    pop  esi
+    pop  edx
+    pop  ecx
+    pop  ebx
+    pop  eax
+    stc
+    ret
+
+; ---------------------------------------------------------------------------
+; Internal: copy one PT_LOAD segment.  EDI = flat address of the Phdr.
+; Same dword-then-tail copy and BSS zero-fill as the 64-bit sibling.
+; Trashes EAX, EBX, ECX, EDX, ESI, EDI.
+; ---------------------------------------------------------------------------
+_elf32_copy_segment:
+    push ebp
+
+    ; src = image_base + p_offset.
+    mov  esi, [fs:edi + 4]                ; p_offset
+    add  esi, [_elf32_image_base]         ; ESI = source flat
+
+    ; dst = p_paddr, verbatim (VMA = LMA, see header comment).
+    mov  ebp, [fs:edi + 12]               ; EBP = dst flat
+
+    ; filesz / memsz.
+    mov  ebx, [fs:edi + 16]               ; p_filesz
+    mov  edx, [fs:edi + 20]               ; p_memsz
+
+.copy_dwords:
+    cmp  ebx, 4
+    jb   .copy_tail
+    mov  eax, [fs:esi]
+    mov  [fs:ebp], eax
+    add  esi, 4
+    add  ebp, 4
+    sub  ebx, 4
+    jmp  .copy_dwords
+.copy_tail:
+    test ebx, ebx
+    jz   .zbss
+    mov  al, [fs:esi]
+    mov  [fs:ebp], al
+    inc  esi
+    inc  ebp
+    dec  ebx
+    jmp  .copy_tail
+
+.zbss:
+    ; Zero-fill (memsz - filesz) bytes; EBP points at dst + filesz.
+    mov  ecx, edx
+    sub  ecx, [fs:edi + 16]               ; ECX = bss bytes
+    xor  eax, eax
+.zloop_dwords:
+    cmp  ecx, 4
+    jb   .zloop_tail
+    mov  [fs:ebp], eax
+    add  ebp, 4
+    sub  ecx, 4
+    jmp  .zloop_dwords
+.zloop_tail:
+    test ecx, ecx
+    jz   .cs_done
+    mov  byte [fs:ebp], 0
+    inc  ebp
+    dec  ecx
+    jmp  .zloop_tail
+.cs_done:
+    pop  ebp
+    ret
diff --git a/boot/bios/stage2/pmode32.inc b/boot/bios/stage2/pmode32.inc
new file mode 100644
index 0000000..a7ccebb
--- /dev/null
+++ b/boot/bios/stage2/pmode32.inc
@@ -0,0 +1,81 @@
+; =============================================================================
+; boot/bios/stage2/pmode32.inc -- transition real mode -> 32-bit protected
+; mode and jump to the i386 kernel (I386_PLAN I1).
+;
+; This is the 32-bit sibling of longmode.inc.  The hand-off contract is
+; the same boot_info_t, differently delivered:
+;
+;   64-bit path: boot_info_t phys in RDI  (System V AMD64 argument 0)
+;   32-bit path: boot_info_t phys in ESI  (register parameter; the i386
+;                stub's boot32.asm pushes it for the cdecl C entry)
+;
+; ESI rather than the i386 cdecl stack because there IS no C stack yet at
+; the jump -- the kernel's own entry code sets one up, exactly as the
+; 64-bit _start does, and a register survives that; a stack argument
+; would have to be re-pushed anyway.
+;
+; Sequence (Intel SDM Vol.3 s.9.9.1):
+;   1. cli, load a flat 32-bit GDT (null / code32 / data32).
+;   2. CR0.PE = 1.
+;   3. Far-jump into the 32-bit code segment (serialises, loads CS).
+;   4. Reload data segments with the flat data selector.
+;   5. ESP to a low-memory scratch stack (kernel replaces it).
+;   6. ESI = boot_info_t phys, jump to [elf32_entry_addr].
+;
+; No paging is enabled here -- the i386 kernel owns that (phase I3), the
+; same division of labour the original kernel had before BL4 moved page
+; tables into the loader.  This routine NEVER returns.
+; =============================================================================
+
+; Flat 32-bit GDT.  Base 0, limit 4 GiB (G=1), D=1.
+align 8
+gdt32_start:
+    dq  0x0000000000000000                  ; 0x00 null
+    dq  0x00CF9A000000FFFF                  ; 0x08 code32 (D=1, R/E, DPL=0)
+    dq  0x00CF92000000FFFF                  ; 0x10 data32 (R/W, DPL=0)
+gdt32_end:
+
+gdt32_ptr:
+    dw  gdt32_end - gdt32_start - 1
+    dd  gdt32_start
+
+; ---------------------------------------------------------------------------
+; enter_prot32 -- takes over the CPU permanently.
+;
+; On entry: unreal mode active (A20 on, real-mode segments),
+;           boot_info_t filled at BOOT_INFO_PHYS,
+;           [elf32_entry_addr] holds the kernel32 physical entry point.
+; On exit : does not return.
+; ---------------------------------------------------------------------------
+enter_prot32:
+    cli
+    lgdt [gdt32_ptr]
+
+    mov  eax, cr0
+    or   eax, (1 << 0)                     ; CR0.PE
+    mov  cr0, eax
+
+    ; Far jump to flush the prefetch queue and load the 32-bit CS.
+    jmp  dword 0x08:.pm32
+
+bits 32
+.pm32:
+    mov  ax, 0x10                          ; flat data selector
+    mov  ds, ax
+    mov  es, ax
+    mov  fs, ax
+    mov  gs, ax
+    mov  ss, ax
+
+    ; Scratch stack just under the EBDA floor; the kernel entry
+    ; replaces it with its own .bss stack immediately.
+    mov  esp, 0x0009F000
+
+    ; Hand-off: ESI = boot_info_t physical address.
+    mov  esi, BOOT_INFO_PHYS
+
+    ; Indirect jump to the ELF32 entry point.
+    mov  eax, [elf32_entry_addr]
+    jmp  eax
+
+bits 16
