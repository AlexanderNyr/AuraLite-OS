diff --git a/drivers/bluetooth/bt_selftest.c b/drivers/bluetooth/bt_selftest.c
new file mode 100644
index 0000000..a9edff5
--- /dev/null
+++ b/drivers/bluetooth/bt_selftest.c
@@ -0,0 +1,207 @@
+/* bt_selftest.c — a scripted Bluetooth controller, in the kernel build
+ * (RESIDUE3 C6).
+ *
+ * The responder is the one from tests/unit/test_bt_transport.c, byte for byte:
+ * Command Complete for Reset / Read Local Version / Read BD_ADDR, Command
+ * Status + two Inquiry Results + Inquiry Complete for an inquiry.  The point
+ * is that bt.c and bt_transport.c are driven exactly as they would be by a
+ * dongle; only the wire is replaced.
+ */
+#include "drivers/bluetooth/bt_selftest.h"
+
+#include <stdint.h>
+
+#include "drivers/bluetooth/bt_hci.h"
+#include "drivers/bluetooth/bt_transport.h"
+#include "kernel/lib/kprintf.h"
+#include "kernel/lib/string.h"
+
+#define STQ 16
+
+typedef struct {
+    uint8_t evt[STQ][128];
+    int     evt_len[STQ];
+    int     head, tail;
+    int     cmds;
+    uint16_t last_opcode;
+    int     failures;
+} st_ctrl_t;
+
+static st_ctrl_t sc;
+
+static const uint8_t ST_BD_ADDR[6] = { 0x78, 0x56, 0x34, 0x12, 0x9A, 0xBC };
+static const uint8_t ST_PEER1[6]   = { 0x11, 0x22, 0x33, 0x44, 0x55, 0x66 };
+static const uint8_t ST_PEER2[6]   = { 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF };
+
+static void sc_push(const uint8_t *pkt, int len) {
+    if (sc.head - sc.tail >= STQ || len > 128) return;
+    int i = sc.head % STQ;
+    memcpy(sc.evt[i], pkt, (size_t)len);
+    sc.evt_len[i] = len;
+    sc.head++;
+}
+
+static void sc_cc(uint16_t opcode, uint8_t status, const uint8_t *ret,
+                  int ret_len) {
+    uint8_t e[128];
+    e[0] = HCI_EVT_PKT;
+    e[1] = HCI_EVT_CMD_COMPLETE;
+    e[2] = (uint8_t)(3 + ret_len);
+    e[3] = 1;
+    e[4] = (uint8_t)(opcode & 0xFF);
+    e[5] = (uint8_t)(opcode >> 8);
+    e[6] = status;
+    for (int i = 0; i < ret_len; i++) e[7 + i] = ret[i];
+    sc_push(e, 7 + ret_len);
+}
+
+static void sc_inq_result(const uint8_t addr[6], uint8_t tag) {
+    uint8_t e[4 + HCI_INQ_REC_LEN];
+    memset(e, 0, sizeof(e));
+    e[0] = HCI_EVT_PKT;
+    e[1] = HCI_EVT_INQUIRY_RESULT;
+    e[2] = (uint8_t)(1 + HCI_INQ_REC_LEN);
+    e[3] = 1;
+    memcpy(e + 4, addr, 6);
+    e[4 + 9] = tag;
+    sc_push(e, (int)sizeof(e));
+}
+
+static int sc_cmd_out(void *ctx, const uint8_t *pkt, uint16_t len) {
+    (void)ctx;
+    if (len < 4 || pkt[0] != HCI_CMD_PKT) return -1;
+    uint16_t opcode = (uint16_t)(pkt[1] | ((uint16_t)pkt[2] << 8));
+    sc.cmds++;
+    sc.last_opcode = opcode;
+
+    switch (opcode) {
+    case HCI_RESET:
+        sc_cc(HCI_RESET, 0, NULL, 0);
+        break;
+    case HCI_READ_LOCAL_VERSION: {
+        /* HCI 5.3, revision 0x0F23, LMP 12, manufacturer 0x001D (CSR),
+         * LMP subversion 0x001F. */
+        uint8_t ret[8] = { 12, 0x23, 0x0F, 12, 0x1D, 0x00, 0x1F, 0x00 };
+        sc_cc(HCI_READ_LOCAL_VERSION, 0, ret, 8);
+        break;
+    }
+    case HCI_READ_BD_ADDR:
+        sc_cc(HCI_READ_BD_ADDR, 0, ST_BD_ADDR, 6);
+        break;
+    case HCI_INQUIRY: {
+        uint8_t st[7] = { HCI_EVT_PKT, HCI_EVT_CMD_STATUS, 4, 0, 1,
+                          (uint8_t)(HCI_INQUIRY & 0xFF),
+                          (uint8_t)(HCI_INQUIRY >> 8) };
+        sc_push(st, 7);
+        sc_inq_result(ST_PEER1, 1);
+        sc_inq_result(ST_PEER2, 2);
+        {
+            uint8_t done[4] = { HCI_EVT_PKT, HCI_EVT_INQUIRY_COMPLETE, 1, 0 };
+            sc_push(done, 4);
+        }
+        break;
+    }
+    default: {
+        uint8_t st[7] = { HCI_EVT_PKT, HCI_EVT_CMD_STATUS, 4, 0, 1,
+                          (uint8_t)(opcode & 0xFF),
+                          (uint8_t)(opcode >> 8) };
+        sc_push(st, 7);
+        break;
+    }
+    }
+    return 0;
+}
+
+static int sc_evt_in(void *ctx, uint8_t *buf, uint16_t bufsize) {
+    (void)ctx;
+    if (sc.tail == sc.head) return 0;
+    int i = sc.tail % STQ;
+    int n = sc.evt_len[i];
+    if (n > bufsize) n = bufsize;
+    memcpy(buf, sc.evt[i], (size_t)n);
+    sc.tail++;
+    return n;
+}
+
+static void st_check(int ok, const char *what) {
+    if (!ok) {
+        sc.failures++;
+        kprintf("[bt] selftest: FAIL %s\n", what);
+    }
+}
+
+void bt_selftest_run(void) {
+    memset(&sc, 0, sizeof(sc));
+    sc.failures = 0;
+
+    bt_io_t io;
+    memset(&io, 0, sizeof(io));
+    io.ctx = &sc;
+    io.cmd_out = sc_cmd_out;
+    io.evt_in = sc_evt_in;
+
+    bt_ctrl_t st;
+    memset(&st, 0, sizeof(st));
+
+    if (bt_transport_bringup(&io, &st) != 0) {
+        kprintf("[bt] selftest: FAIL bring-up (status=%d)\n", st.last_status);
+        return;
+    }
+    kprintf("[bt] selftest: bring-up -> %d command(s), HCI version code 0x%02x "
+            "(5.3) rev 0x%04x, manufacturer 0x%04x (CSR)\n",
+            sc.cmds, (unsigned)st.hci_version,
+            (unsigned)st.hci_revision, (unsigned)st.manufacturer);
+    kprintf("[bt] selftest: BD_ADDR %02x:%02x:%02x:%02x:%02x:%02x read from a "
+            "Command Complete\n",
+            st.bd_addr[5], st.bd_addr[4], st.bd_addr[3],
+            st.bd_addr[2], st.bd_addr[1], st.bd_addr[0]);
+
+    st_check(sc.cmds == 3, "Reset + Read Local Version + Read BD_ADDR");
+    st_check(st.reset_done == 1, "Reset completed with status 0");
+    st_check(st.have_bd_addr == 1, "BD_ADDR kept from the controller");
+    st_check(st.bd_addr[0] == 0x78 && st.bd_addr[5] == 0xBC,
+             "BD_ADDR in wire order (LSB first)");
+    st_check(st.manufacturer == 0x001D, "manufacturer id decoded");
+    st_check(st.hci_version == 12 && st.lmp_version == 12,
+             "HCI and LMP version decoded");
+
+    int n = bt_transport_inquiry(&io, &st, 4, 0);
+    st_check(n == 2, "inquiry returned both reported addresses");
+    st_check(st.inquiry_complete == 1, "inquiry completed");
+    st_check(st.inquiry_addr[0][0] == 0x11 && st.inquiry_addr[1][5] == 0xFF,
+             "inquiry addresses in wire order");
+    kprintf("[bt] selftest: inquiry -> %d device(s), GIAC LAP %02x%02x%02x, "
+            "first %02x:%02x:%02x:%02x:%02x:%02x\n",
+            n, HCI_GIAC_LAP2, HCI_GIAC_LAP1, HCI_GIAC_LAP0,
+            st.inquiry_addr[0][5], st.inquiry_addr[0][4], st.inquiry_addr[0][3],
+            st.inquiry_addr[0][2], st.inquiry_addr[0][1], st.inquiry_addr[0][0]);
+
+    char why[192];
+    int refused = bt_transport_pair_refuse(why, sizeof(why));
+    st_check(refused == -1 && why[0] != 0, "pairing refused with a reason");
+    kprintf("[bt] selftest: pairing -> refused (%s)\n", why);
+
+    /* The negative control that matters: a controller answering the wrong
+     * opcode must not be mistaken for success. */
+    memset(&sc, 0, sizeof(sc));
+    sc.cmds = 0;
+    {
+        /* Queue a completion that answers Read BD_ADDR while the driver is
+         * about to send Reset: the opcode mismatch must be refused. */
+        uint8_t e[7] = { HCI_EVT_PKT, HCI_EVT_CMD_COMPLETE, 3, 1,
+                         (uint8_t)(HCI_READ_BD_ADDR & 0xFF),
+                         (uint8_t)(HCI_READ_BD_ADDR >> 8), 0 };
+        sc_push(e, 7);
+        bt_ctrl_t badst;
+        memset(&badst, 0, sizeof(badst));
+        int rc = bt_transport_cmd(&io, &badst, HCI_RESET, NULL, 0);
+        st_check(rc == -1, "a completion for the wrong opcode is refused");
+        kprintf("[bt] selftest: wrong-opcode control -> refused (%d)\n", rc);
+    }
+
+    if (sc.failures == 0)
+        kprintf("[bt] selftest: PASS HCI transport round trip (no controller "
+                "attached; QEMU has no Bluetooth device)\n");
+    else
+        kprintf("[bt] selftest: FAIL %d check(s)\n", sc.failures);
+}
diff --git a/drivers/bluetooth/bt_selftest.h b/drivers/bluetooth/bt_selftest.h
new file mode 100644
index 0000000..5408d29
--- /dev/null
+++ b/drivers/bluetooth/bt_selftest.h
@@ -0,0 +1,23 @@
+/* bt_selftest.h — the BT transport, driven by a scripted controller
+ * (RESIDUE3 C6).
+ *
+ * WHY.  tests/unit/test_bt_transport.c proves the same code on the host.  What
+ * it cannot prove is that the KERNEL build reaches those paths — the driver is
+ * compiled twice, and a build-specific difference (a different include, a
+ * different integer width on another architecture) would not show up there.
+ * It also cannot show the receipt lines a boot log carries.
+ *
+ * QEMU supplies no Bluetooth controller at all (its hw/bt subsystem was
+ * removed in 9.0), so the controller here is bytes: the same scripted
+ * CSR-class responder the host test uses, with the answers HCI Core 5.x
+ * specifies.  The receipts quote the controller's own BD_ADDR and inquiry
+ * addresses, so a reader can tell a real round trip from a printf.
+ */
+#ifndef AURALITE_DRIVERS_BLUETOOTH_BT_SELFTEST_H
+#define AURALITE_DRIVERS_BLUETOOTH_BT_SELFTEST_H
+
+/* Run the bring-up + inquiry + pairing-refusal flow against the scripted
+ * controller and print PASS/FAIL lines.  Never touches a device. */
+void bt_selftest_run(void);
+
+#endif /* AURALITE_DRIVERS_BLUETOOTH_BT_SELFTEST_H */
diff --git a/drivers/bluetooth/bt_transport.c b/drivers/bluetooth/bt_transport.c
new file mode 100644
index 0000000..16520bb
--- /dev/null
+++ b/drivers/bluetooth/bt_transport.c
@@ -0,0 +1,174 @@
+/* bt_transport.c — the HCI command/event round trip over an injected
+ * transport (RESIDUE3 C6).
+ *
+ * The logic here is what bt.c used to do inline: build a command, hand it to
+ * whatever the transport is, read one event, match it, and keep the
+ * controller's own answers.  Nothing in this file knows about USB — which is
+ * what makes it testable against a scripted controller, on the host and in the
+ * kernel build.
+ *
+ * Two behaviours are deliberate and are asserted by the tests:
+ *   - a Command Complete whose opcode does not match the command just sent is
+ *     treated as a failure, not silently accepted (the controller answering a
+ *     different question is exactly the kind of thing that otherwise shows up
+ *     later as "the BD_ADDR is zeroes");
+ *   - an event of a kind this driver does not use is skipped and the transport
+ *     is polled again, because a controller legitimately interleaves
+ *     informational events with completions.
+ */
+#include "drivers/bluetooth/bt_transport.h"
+
+#include <stddef.h>
+#include <stdint.h>
+
+#define BT_EVT_POLL_MAX 16
+
+int bt_transport_cmd(const bt_io_t *io, bt_ctrl_t *st, uint16_t opcode,
+                     const void *params, uint8_t param_len) {
+    if (!io || !io->cmd_out || !io->evt_in || !st) return -1;
+
+    uint8_t pkt[4 + 255];
+    int plen = bt_hci_cmd(pkt, opcode, param_len);
+    if (plen < 0) return -1;
+    if (params && param_len) {
+        for (uint8_t i = 0; i < param_len; i++)
+            pkt[4 + i] = ((const uint8_t *)params)[i];
+    }
+    if (io->cmd_out(io->ctx, pkt, (uint16_t)(4 + param_len)) < 0) {
+        st->last_status = -1;
+        return -1;
+    }
+
+    for (int poll = 0; poll < BT_EVT_POLL_MAX; poll++) {
+        uint8_t evt[256];
+        int n = io->evt_in(io->ctx, evt, sizeof(evt));
+        if (n < 0) { st->last_status = -1; return -1; }
+        if (n == 0) continue;                      /* nothing pending yet */
+        if (!bt_hci_evt_is(evt, n)) continue;      /* not an HCI event */
+
+        uint8_t code = bt_hci_evt_event(evt, n);
+
+        if (code == HCI_EVT_CMD_COMPLETE) {
+            uint16_t op = bt_hci_cc_opcode(evt, n);
+            if (op != opcode) {
+                /* Wrong answer to this question. */
+                st->last_status = -2;
+                return -1;
+            }
+            int status = bt_hci_status(evt, n);
+            st->last_status = status;
+            if (status != 0) return -1;
+
+            if (opcode == HCI_RESET) st->reset_done = 1;
+            if (opcode == HCI_READ_BD_ADDR) {
+                if (bt_hci_bd_addr(evt, n, st->bd_addr) == 0) {
+                    int zero = 1;
+                    for (int i = 0; i < 6; i++)
+                        if (st->bd_addr[i]) { zero = 0; break; }
+                    st->bd_addr_zero = zero;
+                    st->have_bd_addr = zero ? 0 : 1;
+                    if (zero) { st->last_status = -4; return -1; }
+                }
+            }
+            if (opcode == HCI_READ_LOCAL_VERSION && n >= 3 + 8) {
+                /* Params after the 3-byte event header and the 3-byte CC
+                 * prefix: status, hci_version, hci_rev(2), lmp_version,
+                 * manufacturer(2), lmp_subversion(2). */
+                const uint8_t *p = evt + 6;
+                st->hci_version     = p[1];
+                st->hci_revision    = (uint16_t)(p[2] | ((uint16_t)p[3] << 8));
+                st->lmp_version     = p[4];
+                st->manufacturer    = (uint16_t)(p[5] | ((uint16_t)p[6] << 8));
+                st->lmp_subversion  = (uint16_t)(p[7] | ((uint16_t)p[8] << 8));
+            }
+            return 0;
+        }
+
+        if (code == HCI_EVT_CMD_STATUS) {
+            int status = bt_hci_status(evt, n);
+            st->last_status = status;
+            return status == 0 ? 0 : -1;
+        }
+
+        /* Informational event (inquiry results arrive this way): handled by
+         * bt_transport_inquiry(), or irrelevant here.  Keep polling. */
+    }
+    st->last_status = -3;                          /* no answer at all */
+    return -1;
+}
+
+int bt_transport_bringup(const bt_io_t *io, bt_ctrl_t *st) {
+    if (bt_transport_cmd(io, st, HCI_RESET, NULL, 0) != 0) return -1;
+    if (bt_transport_cmd(io, st, HCI_READ_LOCAL_VERSION, NULL, 0) != 0) return -1;
+    if (bt_transport_cmd(io, st, HCI_READ_BD_ADDR, NULL, 0) != 0) return -1;
+    return st->have_bd_addr ? 0 : -1;
+}
+
+int bt_transport_inquiry(const bt_io_t *io, bt_ctrl_t *st,
+                         uint8_t duration, uint8_t max_results) {
+    if (!io || !io->cmd_out || !io->evt_in || !st) return -1;
+
+    /* Inquiry (HCI 7.1.1): LAP (GIAC, little-endian), duration in 1.28 s
+     * units, max responses (0 = unlimited). */
+    uint8_t params[5];
+    params[0] = HCI_GIAC_LAP0;
+    params[1] = HCI_GIAC_LAP1;
+    params[2] = HCI_GIAC_LAP2;
+    params[3] = duration;
+    params[4] = max_results;
+
+    st->inquiry_count = 0;
+    st->inquiry_complete = 0;
+
+    /* The command is acknowledged with Command Status, then results and the
+     * completion arrive as events. */
+    if (bt_transport_cmd(io, st, HCI_INQUIRY, params, 5) != 0) return -1;
+
+    for (int poll = 0; poll < BT_EVT_POLL_MAX * 8; poll++) {
+        uint8_t evt[256];
+        int n = io->evt_in(io->ctx, evt, sizeof(evt));
+        if (n < 0) return -1;
+        if (n == 0) continue;
+        if (!bt_hci_evt_is(evt, n)) continue;
+
+        uint8_t code = bt_hci_evt_event(evt, n);
+        if (code == HCI_EVT_INQUIRY_RESULT) {
+            int cnt = bt_hci_inq_count(evt, n);
+            for (int i = 0; i < cnt; i++) {
+                if (st->inquiry_count >= BT_INQUIRY_MAX_RESULTS) break;
+                if (bt_hci_inq_addr(evt, n, i,
+                        st->inquiry_addr[st->inquiry_count]) != 0) continue;
+                st->inquiry_pscan[st->inquiry_count] = 0;
+                st->inquiry_count++;
+            }
+            continue;
+        }
+        if (code == HCI_EVT_INQUIRY_COMPLETE) {
+            st->inquiry_complete = 1;
+            break;
+        }
+        if (code == HCI_EVT_CMD_COMPLETE) {
+            uint16_t op = bt_hci_cc_opcode(evt, n);
+            if (op == HCI_INQUIRY) {
+                int status = bt_hci_status(evt, n);
+                st->last_status = status;
+                if (status != 0) return -1;
+            }
+            continue;
+        }
+    }
+    return st->inquiry_count;
+}
+
+int bt_transport_pair_refuse(char *why, unsigned why_len) {
+    static const char msg[] =
+        "pairing is out of scope at RESIDUE3 C6: it needs SMP/SSP key "
+        "exchange and a link key store, neither of which exists here";
+    if (why && why_len) {
+        unsigned n = sizeof(msg) - 1;
+        if (n >= why_len) n = why_len - 1;
+        for (unsigned i = 0; i < n; i++) why[i] = msg[i];
+        why[n] = 0;
+    }
+    return -1;
+}
diff --git a/drivers/bluetooth/bt_transport.h b/drivers/bluetooth/bt_transport.h
new file mode 100644
index 0000000..69ee0b2
--- /dev/null
+++ b/drivers/bluetooth/bt_transport.h
@@ -0,0 +1,95 @@
+/* bt_transport.h — the HCI command/event round trip, with the transport
+ * injected (RESIDUE3 C6).
+ *
+ * WHY THIS EXISTS.  bt_hci.h (RESIDUE2 T6) pinned the HCI *bytes*: how a
+ * command header is built, how a Command Complete is recognised, where the
+ * status byte and the BD_ADDR sit.  What it could not pin is the thing bt.c
+ * does with them: send the command, read an event off the transport, match the
+ * opcode, keep the controller's own BD_ADDR, collect inquiry results.  That
+ * logic lived inline in bt.c next to `usb_bulk_transfer()`, so proving it
+ * needed a controller.
+ *
+ * QEMU cannot supply one.  Upstream removed the whole Bluetooth subsystem
+ * (hw/bt) in QEMU 9.0; the `-bt` command line option is gone ("invalid
+ * option") and `-device help` lists no usb-bt-dongle or bt-* device, so the
+ * plan's "attach -device usb-bt-dongle" lane is not buildable on the emulator
+ * this project tests against.  The transport is therefore injected:
+ *
+ *   bt_io_t.cmd_out  — hand one framed HCI command packet to the controller
+ *   bt_io_t.evt_in   — read one HCI event packet from it
+ *
+ * bt.c binds these to usb_core (bulk OUT / bulk IN on the dongle's endpoints);
+ * the unit test and the kernel self-test bind them to a scripted CSR-class
+ * controller carried in the tree.  The driver logic under test is identical in
+ * all three cases — which is the whole point.
+ */
+#ifndef AURALITE_DRIVERS_BLUETOOTH_BT_TRANSPORT_H
+#define AURALITE_DRIVERS_BLUETOOTH_BT_TRANSPORT_H
+
+#include <stdint.h>
+
+#include "drivers/bluetooth/bt_hci.h"
+
+typedef struct {
+    void *ctx;
+    /* Hand ONE framed HCI command packet (header + params) to the controller.
+     * Returns 0 on success, < 0 when the transport failed. */
+    int (*cmd_out)(void *ctx, const uint8_t *pkt, uint16_t len);
+    /* Read ONE framed HCI event packet.  Returns its length, 0 when the
+     * controller has nothing pending, < 0 on a transport error. */
+    int (*evt_in)(void *ctx, uint8_t *buf, uint16_t bufsize);
+} bt_io_t;
+
+#define BT_LOCAL_VERSION_MAX 16
+#define BT_INQUIRY_MAX_RESULTS 8
+
+typedef struct {
+    /* Read Local Version Information (HCI 4.6.3) — the controller's own
+     * answer, kept so a receipt can quote it. */
+    uint8_t  hci_version;
+    uint16_t hci_revision;
+    uint8_t  lmp_version;
+    uint16_t manufacturer;
+    uint16_t lmp_subversion;
+
+    /* Read BD_ADDR (HCI 4.6.5).  Byte order is the wire's (LSB first). */
+    uint8_t  bd_addr[6];
+    int      have_bd_addr;
+    /* A controller that answers Read BD_ADDR with 00:00:00:00:00:00 is a
+     * real class of broken clone.  It is NOT an address: the flag says so,
+     * bring-up fails, and a receipt can name the shape of the failure. */
+    int      bd_addr_zero;
+
+    int      reset_done;
+    int      last_status;          /* status of the last command */
+
+    /* Inquiry: addresses the controller reported (HCI 7.1.3). */
+    int      inquiry_count;
+    uint8_t  inquiry_addr[BT_INQUIRY_MAX_RESULTS][6];
+    int      inquiry_pscan[BT_INQUIRY_MAX_RESULTS];
+    int      inquiry_complete;
+} bt_ctrl_t;
+
+/* Issue one command and consume the matching event.  Returns 0 when the
+ * command completed with status 0, < 0 otherwise (`st->last_status` carries
+ * the controller's status when it answered). */
+int bt_transport_cmd(const bt_io_t *io, bt_ctrl_t *st, uint16_t opcode,
+                     const void *params, uint8_t param_len);
+
+/* Reset, Read Local Version, Read BD_ADDR — the bring-up sequence.  Returns 0
+ * when all three completed. */
+int bt_transport_bringup(const bt_io_t *io, bt_ctrl_t *st);
+
+/* Start an inquiry and consume Inquiry Result / Inquiry Complete events until
+ * the controller says it is done.  Returns the number of addresses found, or
+ * < 0 on a transport failure. */
+int bt_transport_inquiry(const bt_io_t *io, bt_ctrl_t *st,
+                         uint8_t duration, uint8_t max_results);
+
+/* Pairing: deliberately not implemented at this phase, and said out loud.
+ * Writes the reason into `why` (never NULL-terminates past `why_len`) and
+ * returns -1.  This exists so the gap is a named refusal with a receipt
+ * instead of a silent missing feature. */
+int bt_transport_pair_refuse(char *why, unsigned why_len);
+
+#endif /* AURALITE_DRIVERS_BLUETOOTH_BT_TRANSPORT_H */
