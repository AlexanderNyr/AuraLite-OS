diff --git a/drivers/wifi/wifi_netdev.c b/drivers/wifi/wifi_netdev.c
new file mode 100644
index 0000000..87f777e
--- /dev/null
+++ b/drivers/wifi/wifi_netdev.c
@@ -0,0 +1,96 @@
+/* wifi_netdev.c — the virtual wireless link as a `struct netdev`
+ * (RESIDUE3 C6).
+ *
+ * The seam and the contract are described in wifi_netdev.h.  Two details are
+ * worth their own comment because they are what makes the receipt real rather
+ * than a loopback:
+ *
+ *   1. `send` goes through wifi_send_data(), i.e. the Ethernet frame is
+ *      encapsulated into an 802.11 data frame with an LLC/SNAP header and
+ *      handed to the driver.  The AP parses THAT frame.  Nothing here knows
+ *      what an IP packet is.
+ *   2. `recv` returns what the AP queued after parsing what it received.  An
+ *      ICMP echo reply only exists because the AP saw an echo request on the
+ *      wire, copied the payload and recomputed both checksums.
+ *
+ * `recv_wait` polls with the timer instead of sleeping on an interrupt: the
+ * virtual link has no IRQ to wait on, and a busy-wait bounded by the caller's
+ * own deadline is what the stack expects from a polled device.
+ */
+
+#include <stdint.h>
+
+#include "drivers/wifi/wifi.h"
+#include "drivers/wifi/wifi_netdev.h"
+#include "drivers/wifi/wifi_virt.h"
+#include "kernel/lib/kprintf.h"
+#include "kernel/lib/string.h"
+#include "kernel/net/netdev.h"
+#include "drivers/timer/pit.h"
+
+static const struct netdev wifi_netdev;
+
+static int wifi_nd_send(const void *data, uint32_t len) {
+    return wifi_send_data(data, len);
+}
+
+static int wifi_nd_recv(void *buf, uint32_t bufsize) {
+    return wifi_virt_eth_pop(buf, bufsize);
+}
+
+static int wifi_nd_recv_wait(void *buf, uint32_t bufsize,
+                             uint64_t timeout_ticks) {
+    uint64_t start = timer_get_ticks();
+    for (;;) {
+        int n = wifi_virt_eth_pop(buf, bufsize);
+        if (n > 0) return n;
+        if (timeout_ticks != 0 && timer_get_ticks() - start >= timeout_ticks)
+            return 0;
+        /* The AP answers inside tx_raw(), so the common case needs no wait at
+         * all; this loop exists for a driver whose RX is asynchronous. */
+        for (volatile int spin = 0; spin < 1000; spin++) { }
+    }
+}
+
+static void wifi_nd_get_mac(uint8_t mac[6]) {
+    if (wifi_get_mac(mac) != 0) memset(mac, 0, 6);
+}
+
+static int wifi_nd_link_up(void) {
+    return wifi_get_state() == WIFI_STATE_CONNECTED ? 1 : 0;
+}
+
+static const struct netdev wifi_netdev = {
+    .name      = "wifi-virt",
+    .send      = wifi_nd_send,
+    .recv      = wifi_nd_recv,
+    .recv_wait = wifi_nd_recv_wait,
+    .get_mac   = wifi_nd_get_mac,
+    .link_up   = wifi_nd_link_up,
+};
+
+int wifi_virt_netdev_active(void) {
+    return netdev_active() == &wifi_netdev ? 1 : 0;
+}
+
+int wifi_virt_netdev_attach(void) {
+    /* The AP answers 10.0.2.2, the address kernel/net/net.c already treats as
+     * the gateway, so `net_self_test()`'s ping exercises this path with no
+     * new addressing rules: our static 10.0.2.15 is on the same /24. */
+    wifi_virt_set_ap_ip(0x0A000202u);      /* 10.0.2.2, host order */
+
+    wifi_virt_register();                  /* idempotent */
+    wifi_init();
+    if (wifi_scan() <= 0) {
+        kprintf("[wifi] virtual link: scan found nothing; not registering a netdev\n");
+        return -1;
+    }
+    if (wifi_connect("AuraVirt") != 0) {
+        kprintf("[wifi] virtual link: association failed; not registering a netdev\n");
+        return -1;
+    }
+    netdev_register(&wifi_netdev);
+    kprintf("[wifi] virtual link up: 802.11 data path registered as netdev '%s' "
+            "(AP 10.0.2.2)\n", wifi_netdev.name);
+    return 0;
+}
diff --git a/drivers/wifi/wifi_netdev.h b/drivers/wifi/wifi_netdev.h
new file mode 100644
index 0000000..330681a
--- /dev/null
+++ b/drivers/wifi/wifi_netdev.h
@@ -0,0 +1,36 @@
+/* wifi_netdev.h — the virtual wireless link as a `struct netdev` (RESIDUE3 C6).
+ *
+ * WHY THIS EXISTS.  RESIDUE2 T6 proved the MAC layer against a deterministic
+ * virtual AP, but the frames stopped at the Wi-Fi driver: nothing above it saw
+ * them, so "Wi-Fi works" meant "the MAC built and parsed standards-shaped
+ * frames".  C6 asks for a data path, and the IP stack's own seam for that is
+ * `struct netdev` (kernel/net/netdev.h): send() takes an Ethernet frame,
+ * recv()/recv_wait() hand one back.  This file is the adapter —
+ *
+ *   netdev.send      -> wifi_send_data()      (Ethernet -> 802.11 + LLC/SNAP)
+ *   netdev.recv      -> wifi_virt_eth_pop()   (what the AP queued for us)
+ *   netdev.get_mac   -> the Wi-Fi MAC
+ *   netdev.link_up   -> the association state
+ *
+ * and with it in place `net_ping(10.0.2.2)` is a real receipt: ARP request
+ * out over 802.11, ARP reply built by the AP from the received bytes, ICMP
+ * echo request, echo reply, parsed by kernel/net/net.c.
+ *
+ * It is a FALLBACK NIC: kernel/net/net.c tries it only after every wired
+ * driver has failed, so a boot with a real NIC never changes behaviour.
+ */
+#ifndef AURALITE_DRIVERS_WIFI_WIFI_NETDEV_H
+#define AURALITE_DRIVERS_WIFI_WIFI_NETDEV_H
+
+#include <stdint.h>
+
+/* Bring the virtual link up and register it as a netdev: register the
+ * virtual AP backend, scan, associate, then netdev_register().
+ * Returns 0 when the association succeeded and the netdev is registered,
+ * -1 otherwise (nothing is registered on failure). */
+int wifi_virt_netdev_attach(void);
+
+/* 1 when the virtual wireless link is the ACTIVE network device. */
+int wifi_virt_netdev_active(void);
+
+#endif /* AURALITE_DRIVERS_WIFI_WIFI_NETDEV_H */
diff --git a/drivers/wifi/wifi_virt.c b/drivers/wifi/wifi_virt.c
index bc713f7..1b48c42 100644
--- a/drivers/wifi/wifi_virt.c
+++ b/drivers/wifi/wifi_virt.c
@@ -38,6 +38,184 @@ static const uint8_t VIRT_MAC[6]  = {0x02, 0x50, 0x41, 0x55, 0x01, 0x01};
 #define VIRT_AID_TX   0xC005
 #define VIRT_AID      (VIRT_AID_TX & 0x3FFF)
 
+
+/* ---- C6: the Ethernet-level AP ----------------------------------------- */
+#define VIRT_ETH_MAX   1600
+#define VIRT_RXQ_DEPTH 8
+#define VIRT_ETH_ARP   0x0806
+#define VIRT_ETH_IPV4  0x0800
+
+static uint32_t virt_ap_ip;               /* host order, 0 = not configured */
+static uint8_t  virt_rxq[VIRT_RXQ_DEPTH][VIRT_ETH_MAX];
+static uint16_t virt_rxq_len[VIRT_RXQ_DEPTH];
+static int virt_rxq_head, virt_rxq_tail, virt_rxq_count;
+static int virt_arp_rx, virt_icmp_rx, virt_foreign;
+static uint32_t virt_eth_bytes;           /* replied Ethernet bytes */
+static uint32_t virt_eth_frames;
+
+void wifi_virt_set_ap_ip(uint32_t ap_ip) { virt_ap_ip = ap_ip; }
+uint32_t wifi_virt_ap_ip(void) { return virt_ap_ip; }
+int wifi_virt_arp_replies(void) { return virt_arp_rx; }
+int wifi_virt_icmp_replies(void) { return virt_icmp_rx; }
+int wifi_virt_foreign_frames(void) { return virt_foreign; }
+
+void wifi_virt_eth_reset(void) {
+    virt_rxq_head = virt_rxq_tail = virt_rxq_count = 0;
+    virt_arp_rx = virt_icmp_rx = virt_foreign = 0;
+    virt_eth_bytes = virt_eth_frames = 0;
+}
+
+int wifi_virt_eth_pop(void *buf, uint32_t bufsize) {
+    if (!buf || virt_rxq_count == 0) return 0;
+    uint16_t n = virt_rxq_len[virt_rxq_tail];
+    if (n > bufsize) n = (uint16_t)bufsize;
+    memcpy(buf, virt_rxq[virt_rxq_tail], n);
+    virt_rxq_tail = (virt_rxq_tail + 1) % VIRT_RXQ_DEPTH;
+    virt_rxq_count--;
+    return (int)n;
+}
+
+static void virt_eth_queue(const uint8_t *frame, uint16_t len) {
+    if (len > VIRT_ETH_MAX) return;
+    if (virt_rxq_count == VIRT_RXQ_DEPTH) {
+        /* Full: drop the OLDEST.  A ping's reply is the newest frame and the
+         * one the stack is waiting for, so the queue must not prefer stale
+         * traffic -- dropping the newest would strand every waiter. */
+        virt_rxq_tail = (virt_rxq_tail + 1) % VIRT_RXQ_DEPTH;
+        virt_rxq_count--;
+        virt_foreign++;                 /* counted as a dropped frame */
+    }
+    memcpy(virt_rxq[virt_rxq_head], frame, len);
+    virt_rxq_len[virt_rxq_head] = len;
+    virt_rxq_head = (virt_rxq_head + 1) % VIRT_RXQ_DEPTH;
+    virt_rxq_count++;
+    virt_eth_frames++;
+    virt_eth_bytes += len;
+}
+
+/* Internet checksum (RFC 1071): the one the IP and ICMP headers carry. */
+static uint16_t virt_csum(const uint8_t *p, int len, uint32_t sum) {
+    for (int i = 0; i + 1 < len; i += 2)
+        sum += (uint32_t)((p[i] << 8) | p[i + 1]);
+    if (len & 1) sum += (uint32_t)(p[len - 1] << 8);
+    while (sum >> 16) sum = (sum & 0xFFFF) + (sum >> 16);
+    return (uint16_t)~sum;
+}
+
+/* Build and queue an ARP reply to a request we just received. */
+static void virt_arp_reply(const uint8_t *eth) {
+    uint8_t out[42];
+    const uint8_t *req = eth + 14;             /* ARP payload */
+    memcpy(out, req + 8, 6);                   /* DA = requester's SHA */
+    memcpy(out + 6, AP_BSSID, 6);              /* SA = the AP */
+    out[12] = VIRT_ETH_ARP >> 8;
+    out[13] = VIRT_ETH_ARP & 0xFF;
+    uint8_t *r = out + 14;
+    r[0] = 0x00; r[1] = 0x01;                  /* htype ethernet */
+    r[2] = 0x08; r[3] = 0x00;                  /* ptype IPv4 */
+    r[4] = 6; r[5] = 4;                        /* hlen/plen */
+    r[6] = 0x00; r[7] = 0x02;                  /* oper = reply */
+    memcpy(r + 8, AP_BSSID, 6);                /* SHA = the AP */
+    r[14] = (uint8_t)(virt_ap_ip >> 24);       /* SPA = AP address */
+    r[15] = (uint8_t)(virt_ap_ip >> 16);
+    r[16] = (uint8_t)(virt_ap_ip >> 8);
+    r[17] = (uint8_t)(virt_ap_ip);
+    memcpy(r + 18, req + 8, 6);                /* THA = requester */
+    memcpy(r + 24, req + 14, 4);               /* TPA = requester's IP */
+    virt_arp_rx++;
+    virt_eth_queue(out, (uint16_t)sizeof(out));
+}
+
+/* Build and queue an ICMP echo reply for an echo request addressed to us. */
+static void virt_icmp_reply(const uint8_t *eth, int len) {
+    if (len < 14 + 20 + 8) return;
+    uint8_t out[VIRT_ETH_MAX];
+    const uint8_t *ip = eth + 14;
+    int ihl = (ip[0] & 0x0F) * 4;
+    if (ihl < 20 || len < 14 + ihl + 8) return;
+    int total = (ip[2] << 8) | ip[3];
+    if (total < ihl + 8 || 14 + total > len) total = len - 14;
+    int icmp_len = total - ihl;
+    if (icmp_len > VIRT_ETH_MAX - 14 - ihl) icmp_len = VIRT_ETH_MAX - 14 - ihl;
+
+    memcpy(out, eth + 6, 6);                   /* DA = original source */
+    memcpy(out + 6, AP_BSSID, 6);
+    out[12] = VIRT_ETH_IPV4 >> 8;
+    out[13] = VIRT_ETH_IPV4 & 0xFF;
+
+    uint8_t *oip = out + 14;
+    memcpy(oip, ip, (size_t)ihl);              /* header: addresses swapped */
+    memcpy(oip + 12, ip + 16, 4);              /* src = our IP */
+    memcpy(oip + 16, ip + 12, 4);              /* dst = the requester */
+    oip[8] = 64;                               /* ttl */
+    oip[10] = 0; oip[11] = 0;                  /* checksum recomputed */
+    oip[2] = (uint8_t)((ihl + icmp_len) >> 8);
+    oip[3] = (uint8_t)((ihl + icmp_len) & 0xFF);
+    uint16_t ipc = virt_csum(oip, ihl, 0);
+    oip[10] = (uint8_t)(ipc >> 8); oip[11] = (uint8_t)(ipc & 0xFF);
+
+    uint8_t *oicmp = oip + ihl;
+    memcpy(oicmp, ip + ihl, (size_t)icmp_len); /* payload copied verbatim */
+    oicmp[0] = 0;                              /* type = echo reply */
+    oicmp[1] = 0;
+    oicmp[2] = 0; oicmp[3] = 0;
+    uint16_t icc = virt_csum(oicmp, icmp_len, 0);
+    oicmp[2] = (uint8_t)(icc >> 8); oicmp[3] = (uint8_t)(icc & 0xFF);
+
+    virt_icmp_rx++;
+    virt_eth_queue(out, (uint16_t)(14 + ihl + icmp_len));
+}
+
+/* Handle one Ethernet frame the MAC layer carried up from a ToDS data
+ * frame: answer what is addressed to the AP, drop the rest. */
+static void virt_eth_input(const uint8_t *eth, int len) {
+    if (len < 14) return;
+    uint16_t type = (uint16_t)((eth[12] << 8) | eth[13]);
+    if (type == VIRT_ETH_ARP && len >= 14 + 28) {
+        const uint8_t *r = eth + 14;
+        if (((r[6] << 8) | r[7]) != 1) return;          /* requests only */
+        uint32_t tpa = ((uint32_t)r[24] << 24) | ((uint32_t)r[25] << 16) |
+                       ((uint32_t)r[26] << 8) | r[27];
+        if (virt_ap_ip && tpa == virt_ap_ip) virt_arp_reply(eth);
+        else virt_foreign++;
+        return;
+    }
+    if (type == VIRT_ETH_IPV4 && len >= 14 + 20) {
+        const uint8_t *ip = eth + 14;
+        int ihl = (ip[0] & 0x0F) * 4;
+        if (ihl < 20 || len < 14 + ihl) return;
+        uint32_t dst = ((uint32_t)ip[16] << 24) | ((uint32_t)ip[17] << 16) |
+                       ((uint32_t)ip[18] << 8) | ip[19];
+        if (ip[9] == 1 && dst == virt_ap_ip && len >= 14 + ihl + 8 &&
+            ip[ihl] == 8) {                              /* ICMP echo req */
+            virt_icmp_reply(eth, len);
+            return;
+        }
+        virt_foreign++;
+        return;
+    }
+    virt_foreign++;
+}
+
+/* Pull the Ethernet part out of a ToDS data frame (RA = AP, SA = us,
+ * DA = the final destination) and hand it to the AP. */
+static void virt_data_in(const struct wifi_mgmt_hdr *h, const uint8_t *frame,
+                         uint32_t len) {
+    const uint8_t *snap = frame + sizeof(*h);
+    if (len < sizeof(*h) + 8) return;
+    if (snap[0] != 0xAA || snap[1] != 0xAA || snap[2] != 0x03) return;
+
+    uint8_t eth[VIRT_ETH_MAX];
+    memcpy(eth, h->addr3, 6);                       /* DA */
+    memcpy(eth + 6, h->addr2, 6);                   /* SA */
+    eth[12] = snap[6];
+    eth[13] = snap[7];
+    uint32_t payload = len - (uint32_t)sizeof(*h) - 8;
+    if (payload > VIRT_ETH_MAX - 14) payload = VIRT_ETH_MAX - 14;
+    memcpy(eth + 14, snap + 8, payload);
+    virt_eth_input(eth, (int)(14 + payload));
+}
+
 uint32_t wifi_virt_data_bytes(void) { return virt_data_bytes; }
 int wifi_virt_data_frames(void) { return virt_data_frames; }
 
@@ -50,6 +228,10 @@ static int virt_tx_raw(const void *frame, uint32_t len) {
     if (h->fc.type == 2) {                    /* Data frame */
         virt_data_frames++;
         virt_data_bytes += len;
+        /* C6: a data frame carries an Ethernet frame to the AP; answer what
+         * is addressed to it (ARP for its address, ICMP echo to its
+         * address) and queue the reply for the netdev seam. */
+        virt_data_in(h, (const uint8_t *)frame, len);
         return (int)len;
     }
     if (h->fc.type != 0) return 0;            /* only mgmt answered */
@@ -129,8 +311,12 @@ static const wifi_driver_t virt_driver = {
     .get_mac     = virt_get_mac,
 };
 
+int wifi_virt_eth_frames(void) { return (int)virt_eth_frames; }
+uint32_t wifi_virt_eth_bytes(void) { return virt_eth_bytes; }
+
 void wifi_virt_register(void) {
     virt_data_bytes = 0;
     virt_data_frames = 0;
+    wifi_virt_eth_reset();
     wifi_register_driver(&virt_driver);
 }
diff --git a/drivers/wifi/wifi_virt.h b/drivers/wifi/wifi_virt.h
index d4e3cdf..f1fddfd 100644
--- a/drivers/wifi/wifi_virt.h
+++ b/drivers/wifi/wifi_virt.h
@@ -14,4 +14,38 @@ void wifi_virt_register(void);
 uint32_t wifi_virt_data_bytes(void);
 int wifi_virt_data_frames(void);
 
+/* ---- RESIDUE3 C6: the virtual AP as a DATA PATH -------------------------
+ *
+ * RESIDUE2 T6 stopped at "78 bytes rode the LLC/SNAP path": the frames went
+ * into the MAC layer and were counted.  C6 makes the AP answer at the IP
+ * layer, so the Ethernet frames the IP stack sends come back as frames it
+ * parses: an ARP request for the AP's address is answered with a real ARP
+ * reply, and an ICMP echo request addressed to it is answered with a real
+ * echo reply.  Both are built here from the received bytes (addresses and
+ * payload copied, checksums recomputed), encapsulated FromDS, and queued for
+ * the netdev seam — which is what makes `net_ping()` an end-to-end receipt
+ * over 802.11 rather than a loopback trick.
+ *
+ * Addresses are in host order, the same convention kernel/net/net.c uses. */
+void     wifi_virt_set_ap_ip(uint32_t ap_ip);
+uint32_t wifi_virt_ap_ip(void);
+
+/* Number of ARP replies / ICMP echo replies the AP has produced. */
+int wifi_virt_arp_replies(void);
+int wifi_virt_icmp_replies(void);
+/* Data frames that were not addressed to the AP (counted, then dropped). */
+int wifi_virt_foreign_frames(void);
+
+/* Frames the AP has queued towards us, and their total byte count. */
+int      wifi_virt_eth_frames(void);
+uint32_t wifi_virt_eth_bytes(void);
+
+/* Pop one queued Ethernet frame (what the AP transmitted towards us).
+ * Returns the frame length, or 0 when the queue is empty. */
+int wifi_virt_eth_pop(void *buf, uint32_t bufsize);
+
+/* Reset the C6 counters and drain the queue (used by the boot self-test so
+ * its receipt describes this boot's traffic, not a previous run's). */
+void wifi_virt_eth_reset(void);
+
 #endif
diff --git a/kernel/net/net.c b/kernel/net/net.c
index 55e0e59..75fe624 100644
--- a/kernel/net/net.c
+++ b/kernel/net/net.c
@@ -13,6 +13,7 @@
 #include "drivers/r8169/r8169.h"
 #include "drivers/rtl8139/rtl8139.h"
 #include "kernel/net/netdev.h"
+#include "drivers/wifi/wifi_netdev.h"   /* C6: the virtual wireless link as a NIC */
