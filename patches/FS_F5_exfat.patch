+/* exFAT 16-bit directory-entry-set checksum (exfatprogs semantics).  For the
+ * primary FILE entry bytes 2-3 (the set-checksum field) are skipped; every
+ * secondary entry is covered whole.  `cont` is the running checksum. */
+static uint16_t dentry_csum_cont(uint16_t cs, const uint8_t *de, int is_primary) {
+    cs = (uint16_t)((cs << 15) | (cs >> 1)) + de[0];
+    cs = (uint16_t)((cs << 15) | (cs >> 1)) + de[1];
+    uint32_t start = is_primary ? 4 : 2;
+    for (uint32_t i = start; i < 32; i++)
+        cs = (uint16_t)((cs << 15) | (cs >> 1)) + de[i];
+    return cs;
+}
+static uint16_t entry_set_csum(const uint8_t *set, int nentries) {
+    uint16_t cs = dentry_csum_cont(0, set, 1);
+    for (int i = 1; i < nentries; i++)
