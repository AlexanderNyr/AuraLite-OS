+
+/* bitmap: bit (cluster-2) covers each heap cluster (cluster 2 = bit 0, per
+ * the exFAT spec / fsck's EXFAT_FIRST_CLUSTER==2). */
+static int bitmap_test(uint32_t cluster) {
+    uint32_t cc = cluster - 2, byte = cc >> 3, bit = cc & 7;
+    uint8_t buf[512];
+    if (fs_read_block(em.bdev, cluster_to_sector(em.bitmap_cluster) + byte / em.bps,
+                      1, buf) != 0) return 1;
+    return (buf[byte % em.bps] >> bit) & 1;
+}
+static void bitmap_set(uint32_t cluster, int used) {
+    uint32_t cc = cluster - 2, byte = cc >> 3, bit = cc & 7;
+    uint8_t buf[512];
+    if (fs_read_block(em.bdev, cluster_to_sector(em.bitmap_cluster) + byte / em.bps,
+                      1, buf) != 0) return;
+    if (used) buf[byte % em.bps] |= (uint8_t)(1u << bit);
+    else      buf[byte % em.bps] &= (uint8_t)~(1u << bit);
+    fs_write_block(em.bdev, cluster_to_sector(em.bitmap_cluster) + byte / em.bps,
+                   1, buf);
+}
+
+static uint32_t alloc_cluster(uint32_t prev) {
+    uint32_t start = em.next_free < 2 ? 2 : em.next_free;
+    uint32_t c = start;
+    for (uint32_t n = 0; n < em.cluster_count - 2; n++, c++) {
+        if (c >= em.cluster_count) c = 2;
+        if (!bitmap_test(c)) {
+            bitmap_set(c, 1);
+            if (fat_set(c, EXFAT_FAT_EOF) != 0) { bitmap_set(c, 0); return 0; }
+            if (prev) fat_set(prev, c);
+            em.next_free = c + 1;
+            return c;
+        }
+    }
+    return 0;
+}
+
+static uint64_t chain_len(uint32_t first) {
+    uint64_t len = 0;
+    uint32_t c = first;
+    while (c != EXFAT_FAT_EOF && c != EXFAT_FAT_FREE && c != EXFAT_FAT_BAD) {
+        len++; c = fat_get(c);
+    }
+    return len;
