+/* Read `nbytes` at file offset `pos` from a cluster chain. */
+static int64_t chain_read(uint32_t first, uint64_t pos, uint8_t *buf, uint64_t nbytes) {
+    uint32_t cluster = first;
+    /* seek to the cluster holding `pos` */
+    uint64_t skip = pos;
+    while (skip >= em.cluster_size) {
+        skip -= em.cluster_size;
+        cluster = fat_get(cluster);
+        if (cluster == EXFAT_FAT_EOF || cluster == EXFAT_FAT_FREE) return 0;
+    }
+    uint64_t done = 0;
+    uint64_t inblk = skip;
+    while (done < nbytes) {
+        if (cluster == EXFAT_FAT_EOF || cluster == EXFAT_FAT_FREE) break;
+        if (fs_read_block(em.bdev, cluster_to_sector(cluster), em.spc, escratch) != 0)
+            return -1;
+        uint64_t chunk = em.cluster_size - inblk;
+        if (chunk > nbytes - done) chunk = nbytes - done;
+        memcpy(buf + done, escratch + inblk, (size_t)chunk);
+        done += chunk;
+        inblk = 0;
+        cluster = fat_get(cluster);
+    }
+    return (int64_t)done;
+}
