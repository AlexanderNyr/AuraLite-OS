+/* exFAT 32-bit "shift-and-add" checksum (upcase table / boot region). */
+static uint32_t exfat_csum32(const uint8_t *data, uint32_t len) {
+    uint32_t cs = 0;
+    for (uint32_t i = 0; i < len; i++) {
+        uint8_t b = data[i];
+        cs = ((cs & 1) ? 0x80000000u : 0) + (cs >> 1) + b;
+    }
+    return cs;
+}
