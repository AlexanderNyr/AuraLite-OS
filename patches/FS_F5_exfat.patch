+
+static uint32_t fat_get(uint32_t cluster) {
+    uint64_t fs = em.fat_offset + ((uint64_t)cluster * 4) / em.bps;
+    uint32_t off = (cluster * 4) % em.bps;
+    uint8_t buf[512];
+    if (fs_read_block(em.bdev, fs, 1, buf) != 0) return EXFAT_FAT_EOF;
+    return r32(buf + off);
