diff --git a/kernel/lib/abi_probe.h b/kernel/lib/abi_probe.h
new file mode 100644
index 0000000..e4263b4
--- /dev/null
+++ b/kernel/lib/abi_probe.h
@@ -0,0 +1,24 @@
+/* abi_probe.h — RESIDUE3 C2: the in-guest receipt for the 16-byte C ABI.
+ *
+ * The DECLARATION lives here, in the portable tree, because kmain (a portable
+ * file) arms the probe; the IMPLEMENTATION is kernel/arch/x86_64/abi_probe.c,
+ * where fxsave belongs.  Keeping the prototype out of arch/ is what holds the
+ * width-sweep ratchet (check_width_sweep.py: direct x86_64 includes from
+ * portable code) at its pinned 69.
+ *
+ * The static model (tools/check_abi_align.py) proves the phase arithmetic on
+ * paper.  This is the other half: an aligned SSE operation executed INSIDE
+ * each of the two entry contexts, so a real #GP would happen in QEMU if the
+ * arithmetic were wrong.  fxsave is the canonical probe — it requires a
+ * 16-byte-aligned 512-byte operand and #GPs on anything else, which is
+ * exactly how M5 discovered the problem in the first place.
+ */
+#ifndef AURALITE_ARCH_ABI_PROBE_H
+#define AURALITE_ARCH_ABI_PROBE_H
+
+void abi_probe_arm(void);      /* called once from kmain, before the shell */
+void abi_probe_irq(void);      /* called from isr_handler's IRQ branch */
+void abi_probe_syscall(void);  /* called from syscall_dispatch's entry */
+int  abi_probe_all_done(void); /* 1 when both contexts have passed */
+
+#endif
diff --git a/kernel/mm/aspace.c b/kernel/mm/aspace.c
new file mode 100644
index 0000000..02cf601
--- /dev/null
+++ b/kernel/mm/aspace.c
@@ -0,0 +1,193 @@
+/* aspace.c — refcounted user address spaces.  See aspace.h for the contract
+ * and for the two defects that made it necessary.
+ *
+ * Implemented with __sync builtins only (no spinlock.h, no paging.h) so the
+ * host unit test links this translation unit as-is.
+ */
+
+#include <stddef.h>
+
+#include "kernel/mm/aspace.h"
+
+typedef struct {
+    uint64_t pml4;      /* 0 = slot free */
+    uint32_t refs;
+} aslot_t;
+
+static aslot_t  slots[ASPACE_SLOTS];
+static volatile uint8_t table_lock;
+
+static uint64_t shared_spaces;
+static uint64_t untracked_puts;
+static uint64_t last_puts;
+static uint64_t double_puts;
+
+/* Tombstones: the roots whose last owner this module has already released.
+ * A put of a root that is not in the table but IS in this ring is a second
+ * release of the same address space (a TCB reaped twice, an exit path that
+ * drops the space and then the exec path drops it again) — it must NOT
+ * authorise a second free of page tables that are now somebody else's. */
+#define ASPACE_TOMBSTONES 32
+static uint64_t tombstones[ASPACE_TOMBSTONES];
+static unsigned tomb_next;
+
+static void tombstone_remember(uint64_t pml4) {
+    tombstones[tomb_next] = pml4;
+    tomb_next = (tomb_next + 1) % ASPACE_TOMBSTONES;
+}
+
+static int tombstone_has(uint64_t pml4) {
+    for (unsigned i = 0; i < ASPACE_TOMBSTONES; i++) {
+        if (tombstones[i] == pml4) return 1;
+    }
+    return 0;
+}
+
+static void aspace_lock(void)   { while (__sync_lock_test_and_set(&table_lock, 1)) { } }
+static void aspace_unlock(void) { __sync_lock_release(&table_lock); }
+
+static unsigned home_slot(uint64_t pml4) {
+    /* The low 12 bits of a PML4 root are flags/zero; fold the frame number. */
+    uint64_t f = pml4 >> 12;
+    f ^= f >> 9;
+    return (unsigned)(f % ASPACE_SLOTS);
+}
+
+/* Returns the slot holding @pml4, or NULL.  Caller holds the table lock. */
+static aslot_t *find_locked(uint64_t pml4) {
+    unsigned h = home_slot(pml4);
+    for (unsigned i = 0; i < 8; i++) {
+        aslot_t *s = &slots[(h + i) % ASPACE_SLOTS];
+        if (s->pml4 == pml4) return s;
+        if (s->pml4 == 0) return NULL;      /* empty slot ends the probe run */
+    }
+    return NULL;
+}
+
+void aspace_reset(void) {
+    aspace_lock();
+    for (unsigned i = 0; i < ASPACE_SLOTS; i++) {
+        slots[i].pml4 = 0;
+        slots[i].refs = 0;
+    }
+    shared_spaces  = 0;
+    untracked_puts = 0;
+    last_puts      = 0;
+    double_puts    = 0;
+    tomb_next      = 0;
+    for (unsigned i = 0; i < ASPACE_TOMBSTONES; i++) tombstones[i] = 0;
+    aspace_unlock();
+}
+
+uint64_t aspace_get(uint64_t pml4) {
+    if (pml4 == 0) return 0;                /* kernel address space: untracked */
+
+    aspace_lock();
+    aslot_t *s = find_locked(pml4);
+    if (s) {
+        s->refs++;
+        if (s->refs == 2) shared_spaces++;
+        uint64_t r = s->refs;
+        aspace_unlock();
+        return r;
+    }
+    /* Register: first owner.  Insert at the home slot's probe window. */
+    unsigned h = home_slot(pml4);
+    for (unsigned i = 0; i < 8; i++) {
+        aslot_t *c = &slots[(h + i) % ASPACE_SLOTS];
+        if (c->pml4 == 0) {
+            c->pml4 = pml4;
+            c->refs = 1;
+            uint64_t r = 1;
+            aspace_unlock();
+            return r;
+        }
+    }
+    /* Table full for this hash window: keep the pre-C2 behaviour.  The put
+     * that follows frees on first drop, which is exactly what the tree did
+     * before this module existed — a precision loss, never a leak. */
+    aspace_unlock();
+    return 1;
+}
+
+int aspace_put(uint64_t pml4) {
+    if (pml4 == 0) return 0;                /* never freed through here */
+
+    aspace_lock();
+    aslot_t *s = find_locked(pml4);
+    if (!s) {
+        if (tombstone_has(pml4)) {
+            /* Second release of a space this module already freed. */
+            double_puts++;
+            aspace_unlock();
+            return 0;
+        }
+        /* Unregistered space: the caller may free it, as before. */
+        untracked_puts++;
+        aspace_unlock();
+        return 1;
+    }
+    if (s->refs == 0) {
+        /* Double put: refuse to authorise a second free. */
+        aspace_unlock();
+        return 0;
+    }
+    s->refs--;
+    if (s->refs == 0) {
+        s->pml4 = 0;                        /* free the slot; probe runs stop here */
+        tombstone_remember(pml4);
+        last_puts++;
+        aspace_unlock();
+        return 1;
+    }
+    if (s->refs == 1) shared_spaces--;
+    aspace_unlock();
+    return 0;
+}
+
+int aspace_refs(uint64_t pml4) {
+    if (pml4 == 0) return 0;
+    aspace_lock();
+    aslot_t *s = find_locked(pml4);
+    int r = s ? (int)s->refs : 0;
+    aspace_unlock();
+    return r;
+}
+
+uint64_t aspace_shared_spaces(void) {
+    aspace_lock();
+    uint64_t v = shared_spaces;
+    aspace_unlock();
+    return v;
+}
+
+uint64_t aspace_untracked_puts(void) {
+    aspace_lock();
+    uint64_t v = untracked_puts;
+    aspace_unlock();
+    return v;
+}
+
+uint64_t aspace_last_puts(void) {
+    aspace_lock();
+    uint64_t v = last_puts;
+    aspace_unlock();
+    return v;
+}
+
+uint64_t aspace_double_puts(void) {
+    aspace_lock();
+    uint64_t v = double_puts;
+    aspace_unlock();
+    return v;
+}
+
+uint64_t aspace_live_spaces(void) {
+    uint64_t n = 0;
+    aspace_lock();
+    for (unsigned i = 0; i < ASPACE_SLOTS; i++) {
+        if (slots[i].pml4) n++;
+    }
+    aspace_unlock();
+    return n;
+}
diff --git a/kernel/mm/aspace.h b/kernel/mm/aspace.h
new file mode 100644
index 0000000..c3248f7
--- /dev/null
+++ b/kernel/mm/aspace.h
@@ -0,0 +1,63 @@
+/* aspace.h — refcounted user address spaces (RESIDUE3 C2).
+ *
+ * The kernel already keeps a per-thread `pml4_phys`; what it did NOT keep is
+ * how many threads point at one PML4.  Two mechanisms in the tree create
+ * sharing and both were unaccounted for:
+ *
+ *   - clone(CLONE_VM) (kernel/proc/clone.c) copies the parent's pml4_phys
+ *     into the child, so one address space has N threads;
+ *   - execve (kernel/proc/process.c) replaces the caller's address space and
+ *     used to free the OLD one immediately, pulling it out from under any
+ *     CLONE_VM sibling still running on it.
+ *
+ * The reap side had the mirror-image defect: thread_reap_zombies() skipped
+ * `is_pthread` zombies entirely, so a thread-group address space was freed
+ * exactly when the LAST thread's TCB happened to be the non-pthread one —
+ * which is the common case, not a guarantee.
+ *
+ * This module is the missing counter: a small, lock-light table keyed by the
+ * physical PML4 root.  It owns no page tables and calls no paging code, so the
+ * host unit test (tests/unit/test_aspace.c) compiles this file UNMODIFIED and
+ * drives the real transition logic.
+ *
+ * Semantics:
+ *   aspace_get(pml4)  — record one more owner; returns the new count
+ *                       (0 when pml4 is 0 / the kernel space — untracked,
+ *                       and the caller must keep the old behaviour);
+ *   aspace_put(pml4)  — drop one owner; returns 1 only when THIS call removed
+ *                       the last one, i.e. the caller may now free the page
+ *                       tables.  Returns 0 otherwise (still shared, or the
+ *                       space was never tracked).
+ *
+ * A space is registered by its FIRST aspace_get() after the pml4 is created.
+ * A put on an unregistered pml4 returns 1 (it frees, exactly as before) so
+ * that an unmigrated call site cannot leak a whole address space.
+ */
+#ifndef AURALITE_MM_ASPACE_H
+#define AURALITE_MM_ASPACE_H
+
+#include <stdint.h>
+
+/* Open addressing, 8-probe window: the live population is one entry per
+ * process, and a probe miss only costs accounting precision (the fallback
+ * below frees on the first put, which is the pre-C2 behaviour). */
+#define ASPACE_SLOTS 512
+
+uint64_t aspace_get(uint64_t pml4_phys);
+int      aspace_put(uint64_t pml4_phys);
+
+/* Diagnostics (receipts): current owner count of a space, how many spaces are
+ * shared by more than one thread, how many puts fell off the table, and how
+ * many free decisions this module has authorised. */
+int      aspace_refs(uint64_t pml4_phys);
+uint64_t aspace_shared_spaces(void);
+uint64_t aspace_untracked_puts(void);
+uint64_t aspace_last_puts(void);
+/* Puts refused because the root was already released (a double release). */
+uint64_t aspace_double_puts(void);
+uint64_t aspace_live_spaces(void);
+
+/* Test hook: wipe the table (host tests and the pre-boot init only). */
+void     aspace_reset(void);
+
+#endif /* AURALITE_MM_ASPACE_H */
